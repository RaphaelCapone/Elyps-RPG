	mysql_format(SQL, szQuery, 200, "SELECT * FROM `users` WHERE `Referral`='%d' ORDER BY `users`.`Level` DESC LIMIT 20", PlayerInfo[playerid][pSQLID]);
	new Cache: result = mysql_query(SQL, szQuery);
	strcat(szDialog, "{FFB469}(+) Informatii{FFFFFF}\n");

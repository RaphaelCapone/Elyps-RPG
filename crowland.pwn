				mysql_tquery(SQL, loginQuery, "OnPlayerLoginIn", "d", playerid);
			}
			else {
				ShowPlayerDialogEx(playerid, DIALOG_LOGIN2, DIALOG_STYLE_PASSWORD, "Logare", "Parola introdusa de tine este incorecta!\nIntrodu parola corecta altfel vei primi kick!", "Logare","Quit");

				gPlayerLogTries[playerid] ++;
				if(gPlayerLogTries[playerid] < 3) SCMf(playerid, COLOR_WARNING, "Incorrect password. You have %d remaining attemps left.", 3 - gPlayerLogTries[playerid]);
				else SCM(playerid, COLOR_WARNING, "You got kicked because you enter an incorrect password for 3 times.");

				if(gPlayerLogTries[playerid] == 3) return KickEx(playerid);
			}
		}
		case DIALOG_LOGIN1: {

			if(isnull(inputtext)) {
				SCM(playerid, -1, "Parola nu a fost acceptata! Te rog sa incerci o alta parola.");
				ShowPlayerDialogEx(playerid, DIALOG_LOGIN1, DIALOG_STYLE_PASSWORD, "SERVER: Registration", "Welcome to the CROWLAND RPG Server.\n\nPlease enter your desired password below!", "Register", "Cancel");
				return 1;
   			}
			if(strlen(inputtext) < 6 || strlen(inputtext) > 40) {
				SCM(playerid, -1, "Incearca o alta parola, care sa fie de peste 6 caractere si sa contina o cifra si un caracter mare.");
   				ShowPlayerDialogEx(playerid, DIALOG_LOGIN1, DIALOG_STYLE_PASSWORD, "SERVER: Registration", "Welcome to the CROWLAND RPG Server.\n\nPlease enter your desired password below!", "Register", "Cancel");
				return 1;
   			}
			new bool:upperCharFound = false, bool: numberFound = false;

			for(new _pos = 0; inputtext[_pos] > 0; _pos++) {
				if(inputtext[_pos] >= 48 && inputtext[_pos] < 58) numberFound = true;
				if(inputtext[_pos] >= 'A' && inputtext[_pos] <= 'Z') upperCharFound = true;
			}

			if(!upperCharFound || !numberFound) {
				SCM(playerid, -1, "Parola ta trebuie sa contina minum un caracter mare si o cifra.");
   				ShowPlayerDialogEx(playerid, DIALOG_LOGIN1, DIALOG_STYLE_PASSWORD, "SERVER: Registration", "Welcome to the CROWLAND RPG Server.\n\nPlease enter your desired password below!", "Register", "Cancel");
				return 1;
   			}
			OnPlayerRegister(playerid, MD5_Hash(inputtext));
		}

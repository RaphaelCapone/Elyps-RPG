			if(strlen(inputtext) < 3 || strlen(inputtext) > 64) return ShowPlayerDialogEx(playerid, DIALOG_OBIECTNAME, DIALOG_STYLE_INPUT, "Object name", "Scrie mai jos numele care doresti sa-l aiba obiectul selectat.\nEroare: Poti folosi maxim 64 caractere si minim 3.", "Ok", "Back");
			new id = SelMobila[playerid][SlotSel[playerid]];

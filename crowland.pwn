	if(PlayerInfo[playerid][pAdmin] < 5) return 1;
	if(sscanf(params, "ud", id, biz)) return SCM(playerid, COLOR_GREY, "USAGE: {FFFFFF}/givebiz <playerid/name> <biz id>");

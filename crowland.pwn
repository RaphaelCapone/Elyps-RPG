			new id = GetPVarInt(playerid, "Referral");
			if(PlayerInfo[playerid][pReferral] != 0) {
				SCM(playerid, -1, "A aparut o eroare, incearca sa te reconectezi.");
				return 1;
			}
			foreach(Player, i) {
				if(PlayerInfo[i][pSQLID] == id) {
					SCMf(i, COLOR_MONEY, "Iti multumim ca l-ai adus pe %s(%d) pe comunitate!", GetName(playerid), playerid);
					break;
				}
			}
			UpdateVar(playerid, "Referral", id);
			PlayerInfo[playerid][pReferral] = id;
			TutorialActive[playerid] = 1;
			TutorialSeconds[playerid] = 17;
			TutorialStep[playerid] = 0;

		ResetPlayerRaport(playerid);

		mysql_format(SQL, query, 100, "UPDATE users SET `Team`='%d',`Member`='%d',`Rank`='1' WHERE `ID`='%d'",PlayerInfo[playerid][pTeam],f,PlayerInfo[playerid][pSQLID]);
		mysql_tquery(SQL, query, "", "");
		FactionLog(f, GetName(playerid),"Joined the Faction.");

		Iter_Add(FactionPlayers[f], playerid);
	}

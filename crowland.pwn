		format(string, sizeof(string), "* I-ai dat free lui %s si l-ai scos din inchisoare.", giveplayer);
		SCM(FreeOffer[playerid], COLOR_LIGHTBLUE, string);
		format(string, sizeof(string), "* Ai primit free de la %s si ai iesit din inchisoare.", sendername);
		SCM(playerid, COLOR_LIGHTBLUE, string);
		JailPrice[playerid] = 0;
		PlayerInfo[playerid][pJailTime] = 1;
		PlayerInfo[FreeOffer[playerid]][pLawyer] -= 1;
		PlayerInfo[FreeOffer[playerid]][pLawSkill] ++;
		GivePlayerCash(playerid, -FreePrice[playerid]);
		GivePlayerCash(FreeOffer[playerid],FreePrice[playerid]);
		PlayerInfo[playerid][pJailed] = 1;
		new str[356];
		format(str,sizeof(str),"UPDATE users SET `JailTime`='0',`Money`='%d',`Jailed`='0' WHERE `ID`='%d'",GetPlayerCash(playerid),PlayerInfo[playerid][pSQLID]);
		mysql_tquery(SQL, str, "", "");
		format(str,sizeof(str),"UPDATE users SET `Money`='%d',`Acceptpoints`='%d',`LawSkill`='%d' WHERE ``ID`='%d'",GetPlayerCash(FreeOffer[playerid]),PlayerInfo[FreeOffer[playerid]][pLawyer],PlayerInfo[FreeOffer[playerid]][pLawSkill],PlayerInfo[FreeOffer[playerid]][pSQLID]);
		mysql_tquery(SQL, str, "", "");
		FreeOffer[playerid] = 0;
		FreePrice[playerid] = 0;

	}
	else if(strcmp(x_job,"ticket",true) == 0)
	{
		if(TicketOffer[playerid] == 999) return SCM(playerid, COLOR_GREY, "Nu ai primit o oferta!");
		if(TicketOffer[playerid] != id) return SCM(playerid,-1, "Acel player nu ti-a oferit ticket.");
		if(!ProxDetectorS(5.0, playerid, TicketOffer[playerid])) return SCM(playerid, -1, "Acel player nu este langa tine.");
		GetPlayerName(TicketOffer[playerid], giveplayer, sizeof(giveplayer));
		GetPlayerName(playerid, sendername, sizeof(sendername));
		if(GetPlayerCash(playerid) < TicketMoney[playerid]) return SCM(playerid, COLOR_LIGHTBLUE, "* Nu ai enough money.");
		format(string, sizeof(string), "* Ai platit amenda de $%d lui %s.", TicketMoney[playerid], giveplayer);
		SCM(playerid, COLOR_MONEY, string);
		format(string, sizeof(string), "* %s a platit amenda in valoare de $%d.", sendername, TicketMoney[playerid]);
		SCM(TicketOffer[playerid], COLOR_MONEY, string);
		GivePlayerCash(playerid, - TicketMoney[playerid]);
		GivePlayerCash(TicketOffer[playerid], TicketMoney[playerid]);
		TicketOffer[playerid] = 999;
		TicketMoney[playerid] = 0;
		UpdateFactionRaport(playerid, 2);

	}
	else if(strcmp(x_job,"refill",true) == 0)
	{
	    if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return SCM(playerid, COLOR_GREY, "Nu te afli intr-un vehicul.");
		if(RefillOffer[playerid] == 999) return SCM(playerid, COLOR_GREY, "Nu ai primit o oferta!");
		if(RefillOffer[playerid] != id) return SCM(playerid,COLOR_WHITE, "This player has not offered you refill.");
		if(GetPlayerCash(playerid) < RefillPrice[playerid]) return SCM(playerid, COLOR_WHITE, "Nu ai banii necesari!");
		new idcar = GetPlayerVehicleID(playerid);
		if(Gas[idcar] >= 50) return SCM(playerid, -1, "Vehiculul tau are deja benzina.");
		GetPlayerName(playerid, sendername, sizeof(sendername));
		new fuel;
		fuel = 50;
		Gas[idcar] += fuel;
		UpdateFactionRaport(id, 0);
		DeelayCommand[id][6] = 30;
		format(string, sizeof(string), "**(( TTC Dispatch: Tow Truck Member %s (%s) i-a alimentat masina lui %s (%d) pentru suma de %d$. ))**", GetName(id), id, GetName(playerid), playerid, RefillPrice[playerid]);
		SendFactionMessage(8, COLOR_LIGHTBLUE, string);
		format(string, sizeof(string), "* Vehiculul tau a fost alimentat cu %d%s pentru $%d de mecanicul %s.",fuel,"%%",RefillPrice[playerid],GetName(id));
		SCM(playerid,COLOR_MONEY, string);
		format(string, sizeof(string), "* I-ai alimentat vehiculul lui %s pentru $%d.",sendername,RefillPrice[playerid]);
		SCM(RefillOffer[playerid], COLOR_MONEY, string);
		GivePlayerCash(id,RefillPrice[playerid]);
		GivePlayerCash(playerid, -RefillPrice[playerid]);
		new str[180];
		format(str,sizeof(str),"UPDATE users SET `MechSkill`='%d' WHERE `ID`='%d'",GetPlayerCash(RefillOffer[playerid]),PlayerInfo[RefillOffer[playerid]][pMechSkill],PlayerInfo[RefillOffer[playerid]][pSQLID]);
		mysql_tquery(SQL, str, "", "");
		RefillOffer[playerid] = 999;
		RefillPrice[playerid] = 0;
		OnePlayAnim(id, "BOMBER", "BOM_Plant", 4.0, 0, 0, 0, 0, 0);

	}
	else if(strcmp(x_job,"live",true) == 0) {
		if(LiveOffer[playerid] == 999) return SCM(playerid, COLOR_GREY, "Nu ai primit o oferta!");
		if(LiveOffer[playerid] != id) return SCM(playerid,COLOR_WHITE, "This player has not offered you live.");
		if(!ProxDetectorS(5.0, playerid, LiveOffer[playerid])) return SCM(playerid, -1, "Acel player nu este langa tine.");
		SCM(playerid, COLOR_WHITE, "* Ai primit freeze pana la terminarea live-ului!");
		SCM(LiveOffer[playerid], COLOR_WHITE, "* Ai primit freeze pana la terminarea live-ului! Pentru a opri live-ul, foloseste comanda (/live) iar.");
		TogglePlayerControllable(playerid, 0);
		TogglePlayerControllable(LiveOffer[playerid], 0);
		TalkingLive[playerid] = LiveOffer[playerid];
		TalkingLive[LiveOffer[playerid]] = playerid;
		LiveOffer[playerid] = 999;

	}
	else if(strcmp(x_job,"drugs",true) == 0) {
	    if(PlayerInfo[playerid][pLevel] < 5) return SCM(playerid, -1, "Ai nevoie de level 5 pentru a face acest lucru.");
		if(DrugOffer[playerid] == 999) return SCM(playerid, COLOR_GREY, "Nu ai primit o oferta!");
		if(DrugOffer[playerid] != id) return SCM(playerid,COLOR_WHITE, "This player has not offered you drugs.");
		if(GetPlayerCash(playerid) < DrugPrice[playerid])  return SCM(playerid, COLOR_WHITE, "Nu ai banii necesari!");
		if(PlayerInfo[playerid][pDrugs] > 50) return SCM(playerid, COLOR_WHITE, "Ai prea multe droguri!");
		GetPlayerName(DrugOffer[playerid], giveplayer, sizeof(giveplayer));
		GetPlayerName(playerid, sendername, sizeof(sendername));
		format(string, sizeof(string), "* Ai cumparat %d grame de droguri pentru $%d de la distribuitorul %s.",DrugGram[playerid],DrugPrice[playerid],giveplayer);
		SCM(playerid, COLOR_MONEY, string);
		format(string, sizeof(string), "* %s a cumparat %d grame de droguri in schimbul sumei de $%d.",sendername,DrugGram[playerid],DrugPrice[playerid]);
		SCM(DrugOffer[playerid], COLOR_MONEY, string);
		GivePlayerCash(DrugOffer[playerid],DrugPrice[playerid]);
		PlayerInfo[DrugOffer[playerid]][pDrugsSkill] ++;
		GivePlayerCash(playerid, -DrugPrice[playerid]);
		PlayerInfo[playerid][pDrugs] += DrugGram[playerid];
		PlayerInfo[DrugOffer[playerid]][pDrugs] -= DrugGram[playerid];
		new wakaname[25],str[456];
		GetPlayerName(playerid,wakaname,sizeof(wakaname));
		format(str,sizeof(str),"UPDATE users SET `Money`='%d',`Drugs`='%d' WHERE `ID`='%d'",GetPlayerCash(playerid),PlayerInfo[playerid][pDrugs],PlayerInfo[playerid][pSQLID]);
		mysql_tquery(SQL, str, "", "");
		format(str,sizeof(str),"UPDATE users SET `Money`='%d',`Drugs`='%d',`DrugsSkill`='%d' WHERE `ID`='%d'",GetPlayerCash(DrugOffer[playerid]),PlayerInfo[DrugOffer[playerid]][pDrugs],PlayerInfo[DrugOffer[playerid]][pDrugsSkill],PlayerInfo[DrugOffer[playerid]][pSQLID]);
		mysql_tquery(SQL, str, "", "");
		DrugOffer[playerid] = 999;
		DrugPrice[playerid] = 0;
		DrugGram[playerid] = 0;

	}
	else if(strcmp(x_job,"repair",true) == 0) {
		if(RepairOffer[playerid] == 999) return SCM(playerid, COLOR_GREY, "Nu ai primit o oferta!");
		if(RepairOffer[playerid] != id) return SCM(playerid,COLOR_WHITE, "This player has not offered you repair.");
		if(GetPlayerCash(playerid) < RepairPrice[playerid]) return SCM(playerid, COLOR_GREY, "Nu ai suficienti bani!");
		if(!IsPlayerInAnyVehicle(playerid)) return SCM(playerid, COLOR_WHITE, "You can't afford the repair.");
		if(!IsPlayerConnected(RepairOffer[playerid])) return SCM(playerid, COLOR_GREY, "Acel player nu este conectat.");
		GetPlayerName(RepairOffer[playerid], giveplayer, sizeof(giveplayer));
		GetPlayerName(playerid, sendername, sizeof(sendername));
		RepairCar[playerid] = GetPlayerVehicleID(playerid);
		RepairVehicle(RepairCar[playerid]);
		SetVehicleHealth(RepairCar[playerid], 998.0);

		UpdateFactionRaport(id, 0);
		DeelayCommand[id][5] = 30;
		format(string, sizeof(string), "**(( TTC Dispatch: Tow Truck Member %s (%s) i-a reparat masina lui %s (%d) pentru suma de %d$. ))**", GetName(id), id, GetName(playerid), playerid, RepairPrice[playerid]);
		SendFactionMessage(8, COLOR_LIGHTBLUE, string);

		format(string, sizeof(string), "* Vehiculul tau a fost reparat pentru $%d de mecanicul %s.",RepairPrice[playerid],giveplayer);
		SCM(playerid, COLOR_MONEY, string);
		format(string, sizeof(string), "* I-ai reparat vehiculul lui %s pentru $%d.",sendername,RepairPrice[playerid]);
		SCM(RepairOffer[playerid], COLOR_MONEY, string);
		PlayerInfo[RepairOffer[playerid]][pMechSkill] ++;
		GivePlayerCash(RepairOffer[playerid],RepairPrice[playerid]);
		GivePlayerCash(playerid, -RepairPrice[playerid]);
		new str[184];
		format(str,sizeof(str),"UPDATE users SET `MechSkill`='%d' WHERE `ID`='%d'",PlayerInfo[RepairOffer[playerid]][pMechSkill],PlayerInfo[RepairOffer[playerid]][pSQLID]);
		mysql_tquery(SQL, str, "", "");
		RepairOffer[playerid] = 999;
		RepairPrice[playerid] = 0;
		PlayerPlaySound(playerid,1133,0.0,0.0,0.0);
		OnePlayAnim(id, "BOMBER", "BOM_Plant", 4.0, 0, 0, 0, 0, 0);
	}
	else {
		SCM(playerid, COLOR_GREY, "USAGE: {FFFFFF}/accept <item> <playerid/name>");
		SCM(playerid, COLOR_WHITE, "Trade, License, Dice, Drugs, Repair, Materials, Taxi,");
		SCM(playerid, -1, "Medic, Live, Free, Mecanic, Ticket, Refill, Invite, Cinvite, Clan.");
	}
	return 1;
}
YCMD:invite(playerid, params[], help) {
	if(PlayerInfo[playerid][pRank] < 6) return SCM(playerid, -1, "Comanda aceasta este doar pentru lideri si sublideri.");
	new id,string[100];
	if(sscanf(params, "u", id)) return SCM(playerid, COLOR_GREY, "USAGE: {FFFFFF}/invite <playerid/name>");
	if(!IsPlayerConnected(id) || id == INVALID_PLAYER_ID) return SCM(playerid, COLOR_GREY, "Acel player nu este conectat.");
	if(PlayerInfo[id][pFpunish] != 0) return SCM(playerid,-1, "Acel player are FP.");
	if(GetFactionMembers2(PlayerInfo[playerid][pMember]) >= 20) return SCM(playerid, -1, "Ai numarul maxim de membrii in factiune.");
	if(PlayerInfo[id][pMember] != 0 || PlayerInfo[id][pLeader] != 0) return SCM(playerid, -1, "Acel player face deja parte dintr-o factiune!");

	format(string, sizeof(string), "Lider %s te-a invitat in factiunea %s. (/accept invite %d)", GetName(playerid), FactionName(PlayerInfo[playerid][pMember]), playerid);
	SCM(id, COLOR_LIGHTBLUE, string);
	format(string, sizeof(string), "L-ai invitat pe %s in factiunea ta.", GetName(id));
	SCM(playerid, COLOR_LIGHTBLUE, string);
	InvitedFaction[id] = PlayerInfo[playerid][pMember];
	InvitedBy[id] = playerid;
	SetPVarInt(id, "InvitedFaction", 1);
	return 1;
}
YCMD:withdraw(playerid, params[], help) {
    if(!IsPlayerInRangeOfPoint(playerid, 30.0, 2305.1953,-16.1980,26.7422)) return SCM(playerid, -1, "Nu esti in banca!");
	new money,string[100];
	if(sscanf(params, "i", money)) return SCM(playerid, COLOR_GREY, "USAGE: {FFFFFF}/withdraw <Suma>");
	if(DeelayCommand[playerid][4] != 0) return DeelayTime(playerid, 4);
	if(money > PlayerInfo[playerid][pAccount] || money < 1) return SCM(playerid, COLOR_GRAD3, "Nu ai aceasta suma de bani!");
	GivePlayerCash(playerid, money);
	PlayerInfo[playerid][pAccount]=PlayerInfo[playerid][pAccount]-money;
	format(string, sizeof(string), "[BANK]: Ai scos $%s din contul tau bancar. Acum ai: $%s.", FormatNumber(money),FormatNumber(PlayerInfo[playerid][pAccount]));
	SCM(playerid, 0xFAAC25FF, string);
	new query[180];
	format(query,sizeof(query),"UPDATE users SET `Money`='%d',`Bank`='%d' WHERE `ID`='%d'",GetPlayerCash(playerid),PlayerInfo[playerid][pAccount],PlayerInfo[playerid][pSQLID]);
	mysql_tquery(SQL, query, "", "");
	ConsumingMoney[playerid] = 1;
	DeelayCommand[playerid][4] = 10*2;
	return 1;
}
YCMD:deposit(playerid, params[], help) {
    if(!IsPlayerInRangeOfPoint(playerid, 30.0, 2305.1953,-16.1980,26.7422)) return SCM(playerid, -1, "Nu esti in banca!");
	if(TradeID[playerid] != -1) return SCM(playerid, COLOR_LGREEN, "Eroare: Nu poti folosi aceasta comanda atata timp cat esti implicat intr-o afacere!");
	if(DeelayCommand[playerid][4] != 0) return DeelayTime(playerid, 4);
	new money,string[100];
	if(sscanf(params, "i", money)) return SCM(playerid, COLOR_GREY, "USAGE: {FFFFFF}/deposit <Suma>");
	if(money > GetPlayerCash(playerid) || money < 1) return SCM(playerid, COLOR_GRAD3, "Nu ai aceasta suma de bani!");
	GivePlayerCash(playerid, -money);
	PlayerInfo[playerid][pAccount]=money+PlayerInfo[playerid][pAccount];
	format(string, sizeof(string), "[BANK]: Ai depozitat $%s in contul tau bancar. Acum ai: $%s.", FormatNumber(money),FormatNumber(PlayerInfo[playerid][pAccount]));
	SCM(playerid, 0xFAAC25FF, string);
	Update(playerid, pBank);
	DeelayCommand[playerid][4] = 10*2;
	return 1;
}
YCMD:balance(playerid, params[], help) {
    if(!IsPlayerInRangeOfPoint(playerid, 30.0, 2305.1953,-16.1980,26.7422)) return SCM(playerid, -1, "Nu esti in banca!");
	new string[100];
	format(string, sizeof(string), "[BANK]: Ai $%s in contul tau.", FormatNumber(PlayerInfo[playerid][pAccount]));
	SCM(playerid, 0xFAAC25FF, string);
	return 1;
}
YCMD:transfer(playerid, params[], help) {
	if(PlayerInfo[playerid][pPin] == 0 && PlayerInfo[playerid][pPinLogged] == 0) return SCM(playerid, -1, "Nu ai un cont pin setat /setpin sau nu te-ai logat folosind pin-ul.");
	if(PlayerInfo[playerid][pLevel] < 5) return SCM(playerid, -1, "Pentru a putea folosi aceasta comanda, ai nevoie de minim level 5.");
    if(!IsPlayerInRangeOfPoint(playerid, 30.0, 2305.1953,-16.1980,26.7422)) return SCM(playerid, -1, "Nu esti in banca!");
	if(TradeID[playerid] != -1) return SCM(playerid, -1, "Nu poti folosi aceasta comanda atata timp cat esti implicat intr-o afacere!");
	new id,moneytransfer,string[100],playermoney;
	if(sscanf(params, "ui", id,moneytransfer)) return SCM(playerid, COLOR_GREY, "USAGE: {FFFFFF}/transfer <playerid/name> <Suma>");
	if(PlayerInfo[playerid][pPin] != 0 && PlayerInfo[playerid][pPinLogged] == 0) return SCM(playerid, COLOR_LGREEN, "Pentru a folosi aceasta comanda, trebuie sa iti introduci codul de securitate folosind comanda (/loginpin).");
	if(!IsPlayerConnected(id) || id == INVALID_PLAYER_ID || playerid == id) return SCM(playerid, COLOR_GREY, "Invalid ID.");
	playermoney = PlayerInfo[playerid][pAccount];
	if(DeelayCommand[playerid][4] != 0) return DeelayTime(playerid, 4);
	playermoney = PlayerInfo[playerid][pAccount];
	DeelayCommand[playerid][4] = 25*2;
	if(moneytransfer < 10000 && moneytransfer > 500000000) return SCM(playerid, COLOR_LGREEN, "Eroare: Poti transfera minim $10,000 si maxim $500,000,000!");
	if(moneytransfer > 0 && playermoney >= moneytransfer) {
		TransferOffer[playerid] = id;
		TransferMoney[playerid] = moneytransfer;
		new cashbank = TransferMoney[playerid]/100;
		format(string, sizeof(string), "Esti sigur ca vrei sa transferi %s$ lui %s?\nTaxa este $%s.",FormatNumber(moneytransfer),GetName(id),FormatNumber(cashbank));
		ShowPlayerDialogEx(playerid, DIALOG_TRANSFER, DIALOG_STYLE_MSGBOX, "Transfer:", string, "Yes", "No");
	}
	else SCM(playerid, -1, "Suma invalida.");
	return 1;
}
YCMD:staff(playerid, params[], help) {
	if(PlayerInfo[playerid][pAdmin] < 1) return 1;
	ShowPlayerDialogEx(playerid, DIALOG_STAFF, DIALOG_STYLE_LIST, "Staff", "Admins\nHelpers", "Ok", "Close");
	return 1;
}
function GetStaffOnline(type) {
	switch(type) {
		case 0: return Iter_Count(PlayerAdmins);
		case 1: return Iter_Count(PlayerHelpers);
	}
	return false;
}
stock GetLeader(faction) {
	new lead[50], query[100];
	format(lead, MAX_PLAYER_NAME, "Nimeni");
	mysql_format(SQL, query, 100, "SELECT * FROM `users` WHERE `Leader` = '%d'", faction);
	new Cache: masta = mysql_query(SQL, query), r;
	cache_get_row_count(r);
	if(r >= 1) {
		cache_get_value_name(0, "name", lead);
		new userID = GetPlayerID( lead );
		if(userID != INVALID_PLAYER_ID) format(lead, 50, "%s (%d)", lead, userID);
	}
	cache_delete(masta);
	return lead;
}

stock IsSeatTaken(vehicleid, seatid) {
 	for(new i; i < MAX_PLAYERS; i++) {  if(GetPlayerVehicleID(i) == vehicleid && GetPlayerVehicleSeat(i) == seatid) return 1;  }
    return 0;
}

YCMD:factions(playerid, params[], help) {
	new szDialog[180], szDialog2[1024], szTitle[50], xx;
	strcat(szDialog2, "Factiune\tMembrii\tApplicatii\n");
	for(new i = 1; i < 17; i++) {
		format(szDialog, sizeof(szDialog), "%d. %s\t%s/20\t%s\n", i, FactionName(i), GetFactionMembers(i), GetFactionStatus(i));
		strcat(szDialog2, szDialog);
		xx++;
	}
	format(szTitle, sizeof(szTitle), "Factions: %d", xx);
	ShowPlayerDialogEx(playerid, DIALOG_FACTIONS, DIALOG_STYLE_TABLIST_HEADERS, szTitle, szDialog2, "Select", "Exit");
	return 1;
}
stock GetFactionStatus(fid) {
	new szStatus[180];
	if(DynamicFactions[fid][fApp] == 1) format(szStatus, 256, "Inchise");
	else format(szStatus, 256, "Deschise");
	return szStatus;
}
stock GetFactionStatus2(fid) {
	new szStatus[180];
	if(DynamicFactions[fid][fApp] == 0) format(szStatus, 256, "Inchise");
	else format(szStatus, 256, "Deschise");
	return szStatus;
}
YCMD:flip(playerid, params[], help) {
	if(PlayerInfo[playerid][pAdmin] < 1) return SendClientMessage(playerid, COLOR_WHITE, AdminOnly);
	if(!IsPlayerInAnyVehicle(playerid)) return 1;
    new Float:angle;
    GetVehicleZAngle(GetPlayerVehicleID(playerid), angle);
    SetVehicleZAngleEx(GetPlayerVehicleID(playerid), angle);
    SCM(playerid, -1, "Your vehicle has been flipped back over.");
	return 1;
}

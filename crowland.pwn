stock getRentVehicleIndex(vehicleModel) {
	for(new x = 0; x < TOTAL_RENT_STOCK; x ++) {
		if(rentStockModels[x] == vehicleModel) return x;
	}
	return -1;
}
YCMD:healme(playerid, params[], help) {
	if(PlayerInfo[playerid][pAdmin] < 3) return SCM(playerid, COLOR_WHITE, AdminOnly);
	SCM(playerid, -1, "Ti-ai setat viata la 100.");
	SetPlayerHealthEx(playerid, 100);
	return 1;
}
YCMD:putsantahat(playerid, params[], help) {
	if(PlayerInfo[playerid][pSpecialHat] != 1) return SCM(playerid, -1, "Nu ai o caciula de craciun.");
	SetPlayerAttachedObject(playerid, 0, 19065, 2, 0.120000, 0.040000, -0.003500, 0, 100, 100, 1.4, 1.4, 1.4);
	SCM(playerid, -1, "Caciula de craciun a fost pusa!");
	return 1;
}
YCMD:removesantahat(playerid, params[], help) {
	if(PlayerInfo[playerid][pSpecialHat] != 1) return SCM(playerid, -1, "Nu ai o caciula de craciun.");
	RemovePlayerAttachedObject(playerid, 0);
	SCM(playerid, -1, "Caciula de craciun a fost scoasa cu succes!");

function ShowCamera(playerid) {
	if(IsABoat2(DSModels[DealerID[playerid]][dModel])) {
		SetPlayerCameraPos(playerid, -2519.5046, 1455.0684, 7.5597);
		SetPlayerCameraLookAt(playerid, -2520.3940, 1454.6025, 7.3548);
	}
	else if(IsAPlane2(DSModels[DealerID[playerid]][dModel])) {
		SetPlayerCameraPos(playerid, -2244.9509, 2299.7588, 13.2997);
		SetPlayerCameraLookAt(playerid, -2244.3640, 2300.5728, 13.1248);
	}
	else {
		SetPlayerCameraPos(playerid, -2464.8069, 2245.4395, 7.4188);
		SetPlayerCameraLookAt(playerid, -2465.4333, 2244.6560, 7.2090);
	}
	return 1;
}
function Camera(playerid) {
	TogglePlayerSpectating(playerid, true);
	InterpolateCameraPos(playerid, -2681.6147, 1494.8400, 78.0967, -2681.9116, 1846.9042, 94.0295, 15000);
	InterpolateCameraLookAt(playerid, -2681.8188, 1942.9873, 69.1752, -2681.8188, 1942.9873, 69.1752, 1000);
	SetPlayerPosEx(playerid, -2657.1548, 1598.3553, 64.6116);
	SetPlayerVirtualWorld(playerid, 0);
	return 1;
}
stock CountIP(ip[]) {
	new c = 0;
	foreach(Player, i) if(!strcmp(GetIP(i),ip)) c++;
	return c;
}

stock GetIP(playerid) {
	new ip[16];
	GetPlayerIp(playerid,ip,sizeof(ip));
	return ip;
}


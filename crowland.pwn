					if(GetPlayerCash(playerid) < 4000) return SCM(playerid, COLOR_GREY, "Nu ai destui bani pentru a face asta.");
					if(PlayerInfo[playerid][pGasCan] != 0) return SCM(playerid, COLOR_WHITE, "Ai deja canistra.");
					GivePlayerCash(playerid, - 4000);
					BizzInfo[bizz][bBalance] += 3000;

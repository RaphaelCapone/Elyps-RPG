				case 0: ShowPlayerDialogEx(playerid, DIALOG_OBIECTNAME, DIALOG_STYLE_INPUT, "Object name", "Scrie mai jos numele care doresti sa-l aiba obiectul selectat.\nPoti folosi maxim 64 caractere si minim 3.", "Ok", "Back");
				case 1: {

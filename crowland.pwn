					if(PlayerInfo[playerid][pCigarettes] != 0) return SCM(playerid, COLOR_WHITE, "Ai deja tigari.");
					GivePlayerCash(playerid, - 100);
					BizzInfo[bizz][bBalance] += 50;
					PlayerInfo[playerid][pCigarettes] = 10;

			if(!response) return ShowFactionMembers(playerid);
			new userID = GetPlayerID(sName[playerid]);
			if(PlayerInfo[playerid][pRank] < 7) return SCM(playerid, COLOR_LGREEN, "Eroare: Ai nevoie de rank 7 pentru a putea merge mai departe!");
			switch(listitem) {
				case 0: {
					new rank, fw;
					mysql_format(SQL, szQuery, sizeof(szQuery), "SELECT * FROM `users` WHERE `name`='%s'", sName[playerid]);
					new Cache: result = mysql_query(SQL, szQuery);

					if(!IsACop(playerid)) {
						new YCMDs[3], r;
						cache_get_row_count(r);
						for(new i = 0; i != r; ++i)
						{
							cache_get_value_name(i, "name", name);
							cache_get_value_name_int(i, "Commands", YCMDs[0]);
							cache_get_value_name_int(i, "InvalidCommands", YCMDs[1]);
							cache_get_value_name_int(i, "Rank", rank);
							cache_get_value_name_int(i, "FWarn", fw);

							if(PlayerInfo[playerid][pMember] == 13) format(string, 150, "Name: %s\nRank: %d\nFaction warns: %d\nCommands: %d/%d\nIncendii: %d\nInvalid commands: %d", name, rank, fw, YCMDs[0], GetNeedPointsR2(rank, PlayerInfo[playerid][pMember]), YCMDs[2], YCMDs[1]);
							else format(string, sizeof(string), "Name: %s\nRank: %d\nFaction warns: %d\nCommands: %d/%d\nInvalid commands: %d", name, rank, fw, YCMDs[0], GetNeedPointsR2(rank, PlayerInfo[playerid][pMember]), YCMDs[1]);

							strcat(MemberString, string);
						}
						cache_delete(result);
					}
					else {
						new YCMDs[6], r;
						cache_get_row_count(r);
						for(new i = 0; i != r; ++i)
						{
							cache_get_value_name(i, "name", name);
							cache_get_value_name_int(i, "Commands", YCMDs[0]);
							cache_get_value_name_int(i, "Commands2", YCMDs[1]);
							cache_get_value_name_int(i, "Commands3", YCMDs[2]);
							cache_get_value_name_int(i, "Commands4", YCMDs[3]);
							cache_get_value_name_int(i, "Commands5", YCMDs[4]);
							cache_get_value_name_int(i, "InvalidCommands", YCMDs[5]);
							cache_get_value_name_int(i, "Rank", rank);
							cache_get_value_name_int(i, "FWarn", fw);

							format(string, sizeof(string), "Name: %s\nRank: %d\nFaction warns: %d\nRunners: %d\nArestari: %d\nAmenzi: %d\nPermise confiscate: %d\nDroguri confiscate: %d\nInvalid commands: %d", name, rank, fw, YCMDs[0], YCMDs[1], YCMDs[2], YCMDs[3], YCMDs[4], YCMDs[5]);
							strcat(MemberString, string);
						}
						cache_delete(result);
					}
					ShowPlayerDialogEx(playerid, DIALOG_RAPORTS, DIALOG_STYLE_MSGBOX, "Raports", MemberString, "Ok", "Back");
				}
				case 1: {
					format(string, sizeof(string), "Scrie mai jos rankul pe care vrei sa il dai membrului %s.", sName[playerid]);
					ShowPlayerDialogEx(playerid, DIALOG_MEMBERS+2, DIALOG_STYLE_INPUT, "Give rank", string, "Ok", "Close");
				}
				case 2: {
					mysql_format(SQL, szQuery, 99, "SELECT * FROM `users` WHERE `name`='%s'", sName[playerid]);
					new Cache: result = mysql_query(SQL, szQuery);

					new fw, days, rank, id;
					cache_get_value_name_int(0, "FWarn", fw);
					cache_get_value_name_int(0, "Days", days);
					cache_get_value_name_int(0, "Rank", rank);
					if(PlayerInfo[playerid][pRank] == 6 && rank >= 6) return SCM(playerid, COLOR_LGREEN, "Eroare: Nu poti da FW unui membru cu rank 6+!");
					cache_get_value_name_int(0, "id", id);
					cache_delete(result);
					fw++;

					format(string, sizeof(string), "%s i-a acordat lui %s un Faction Warn.", GetName(playerid), sName[playerid]);
					SendFactionMessage(PlayerInfo[playerid][pMember], COLOR_CLIENT, string);

					mysql_format(SQL,str,128,"UPDATE `users` SET `FWarn`='%d' WHERE `name`='%s' LIMIT 1",fw,sName[playerid]);
					mysql_tquery(SQL,str, "", "");
					if(userID != INVALID_PLAYER_ID) PlayerInfo[userID][pFACWarns] = fw;
					if(fw >= 3)
					{
						new f = PlayerInfo[playerid][pMember];
						FactionMembers[f] --;

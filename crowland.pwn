				case 4: {
					switch(listitem) {
						case 0:
						{
							if(GetPlayerCash(playerid) < 500) return SCM(playerid, COLOR_GREY, "Nu ai destui bani!");
							if(HouseInfo[house][hHel] == 1) return SCM(playerid, COLOR_GREY, "Casa ta are deja acest item!");
							HouseInfo[house][hHel] = 1;
							GivePlayerCash(playerid,-500);

							BizzInfo[18][bBalance] += 500;
							format(query, sizeof(query),"UPDATE `bizz` SET `Till`='%d' WHERE `ID`='18'",BizzInfo[18][bBalance]);
							mysql_tquery(SQL, query, "", "");

							PlayerPlaySound(playerid, 1052, 0.0, 0.0, 0.0);
							format(query, sizeof(query),"UPDATE `houses` SET `Hel`='1' WHERE `ID`='%d'",house);
							mysql_tquery(SQL, query, "", "");
						}
						case 1:
						{
							if(!IsACop(playerid)) return SCM(playerid, COLOR_GREY, "Nu esti politist!");
							if(GetPlayerCash(playerid) < 1000) return SCM(playerid, COLOR_GREY, "Nu ai destui bani!");
							if(HouseInfo[house][hArm] == 1) return SCM(playerid, COLOR_GREY, "Casa ta are deja acest item!");
							HouseInfo[house][hArm] = 1;
							GivePlayerCash(playerid,-1000);
							BizzInfo[18][bBalance] += 1000;
							format(query, sizeof(query),"UPDATE `bizz` SET `Till`='%d' WHERE `ID`='18'",BizzInfo[18][bBalance]);
							mysql_tquery(SQL, query, "", "");
							PlayerPlaySound(playerid, 1052, 0.0, 0.0, 0.0);
							format(query, sizeof(query),"UPDATE `houses` SET `Arm`='1' WHERE `ID`='%d'",house);
							mysql_tquery(SQL, query, "", "");
						}
					}
					SCM(playerid, COLOR_LGREEN, "Casa a fost actualizata! Foloseste comanda '/heal' pentru a lua viata.");
				}
				case 5: {
					if(strlen(inputtext) < 5 || strlen(inputtext) > 60) return SCM(playerid, COLOR_GREY, "Numele trebuie sa contina intre 5 si 60 de caractere!");
					format(HouseInfo[house][hDiscription], 256, inputtext);
					format(string, sizeof(string), "Numele casei a fost modificat in '%s'.",HouseInfo[house][hDiscription]);
					SCM(playerid, COLOR_LGREEN, string);
					format(query, sizeof(query),"UPDATE houses SET Discription='%s' WHERE ID='%d'",HouseInfo[house][hDiscription],PlayerInfo[playerid][pHouse]);
					mysql_tquery(SQL, query, "", "");
					UpdateLabel(1, house);
				}
				case 6: {
					if(suma < 0 || suma > 1000) return SCM(playerid, COLOR_GREY, "Suma minima este de $1 iar cea maxima este de $1,000!");
					if(suma == 0) HouseInfo[house][hRentabil] = 0;
					else HouseInfo[house][hRentabil] = 1;
					HouseInfo[house][hRent] = suma;
					format(query,64,"UPDATE `houses` SET `Rent`='%d',`Rentabil`='%d' WHERE `ID`='%d'",suma,HouseInfo[house][hRentabil],house);
					mysql_tquery(SQL, query, "", "");
					UpdateLabel(1, house);
				}
				case 7: {
					if(suma < 0 || suma > 50000000) return SCM(playerid, COLOR_GREY, "Invalid price! ($1-$50,000,000)");
					format(string, sizeof(string), "Ai setat pretul casei la $%s.", FormatNumber(suma));
					SCM(playerid, COLOR_MONEY, string);
					HouseInfo[house][hValue] = suma;
					format(query, sizeof(query), "UPDATE `houses` SET `Value`= '%d' WHERE `ID`= '%d'", HouseInfo[house][hValue], house);
					mysql_tquery(SQL, query, "", "");
					UpdateLabel(1,house);
					format(string, sizeof(string), "%s si-a pus casa (%d) la vanzare pentru suma de $%s.", GetName(playerid), house, FormatNumber(suma));
					InsertLog(playerid, string, LOG_SELL);
				}
			}
		}
		case DIALOG_TENANTS: {
			if(!response) return 1;

public OnPlayerConnect(playerid) {

	new pn[24], ip[16];
	GetPlayerName(playerid, pn, 24);
	GetPlayerIp(playerid, ip, 16);

	// foreach(new x: occupiedConnectSlots) {
		// if(strcmp(connectCheck[x][connectIP], ip, true)) {
			// Iter_SafeRemove(occupiedConnectSlots, x, x);
			// break;
		// }
	// }

 	pDialog[playerid] = -1;

	jobsDeelay[playerid] = gettime();
	if(FaceReclama(pn)) {
		SCM(playerid, COLOR_WARNING, "Ai primit kick deoarece numele tau contine numele unei comunitati!");
		KickEx(playerid);
		return 1;
	}
	
	if(ExistaTagClan(pn)) {
		SCM(playerid, COLOR_WARNING, "Ai primit kick deoarece numele tau contine tag-ul unui clan!");
		KickEx(playerid);
		return 1;
	}
	
	
	if(CountIP(GetIP(playerid)) > 3) {
		SCM(playerid, COLOR_WARNING, "Nu te poti conecta de pe acelasi IP pe mai multe conturi in acelasi timp!");
		KickEx(playerid);
		return 1;
	}
	format(PlayerInfo[playerid][pUsername], MAX_PLAYER_NAME, pn);
	format(playerNameOnID[playerid], MAX_PLAYER_NAME, pn);

	foreach(Player, i) {
		if(i != playerid) {
			if(strcmp(GetName(playerid), GetName(i), true) == 0) KickEx(playerid);
	    }
	}

	ResetVariables(playerid);
	RemoveMaps(playerid);

    AFKSeconds[playerid]=0;
    AFKSeconds1[playerid]=0;
/*
    stop TimerSecond[playerid];
    TimerSecond[playerid] = repeat OneSecondTimer(playerid);

    stop TimerSecond1[playerid];
    TimerSecond1[playerid] = repeat OneSecondTimer(playerid);*/


	SetPlayerColor(playerid, COLOR_WHITE);
	SetTimerEx("Camera", 500, false, "d", playerid);

	InterpolateCameraPos(playerid, -2681.6147, 1494.8400, 78.0967, -2681.9116, 1846.9042, 94.0295, 15000);
	InterpolateCameraLookAt(playerid, -2681.8188, 1942.9873, 69.1752, -2681.8188, 1942.9873, 69.1752, 1000);

	Iter_Add(PlayersWaitForLogin, playerid);
	if(timer_queue_login == Timer:-1) timer_queue_login = repeat put_players_in_login();

	SetPlayerWorldBounds(playerid, 3579.6602, -4298.7334, 3971.8860, -3909.0200);
	return 1;
}

function CheckClassIP(playerid) { // 2
	new test = 0;
	cache_get_row_count (test);

	if(test != 0) {
		new name[MAX_PLAYER_NAME], by[MAX_PLAYER_NAME], date[60], reason[64];
		cache_get_value_name(0, "Name", name);
		cache_get_value_name(0, "By", by);
		cache_get_value_name(0, "Date", date);
		cache_get_value_name(0, "Reason", reason);

		for( new j = 0; j <= 25; j++) SCM(playerid, COLOR_WHITE, "");
		SCMf(playerid, COLOR_WARNING, "Acest cont este banat pe IP de catre %s (%s).", by, date);
		SCMf(playerid, COLOR_WARNING, "Contul de pe care s-a luat ban: %s.", name);
		SCMf(playerid, COLOR_WARNING, "Motivul: %s.", reason);
		SCM(playerid, COLOR_WARNING, "Daca consideri ca ai primit ban aiurea, fa o cerere de unban pe https://panel.c.ro/unbans");
		TogglePlayerSpectating(playerid, true);
		SetPlayerCameraPos(playerid, 1183.0143, -965.7394, 129.6071);
		SetPlayerCameraLookAt(playerid, 1183.7214, -965.0270, 129.2470);

		// printf("%d is banned.", playerid);
		return KickEx(playerid);
	}
	/*
		new query[150];
		mysql_format(SQL, query, 150, "SELECT * FROM `ipbans` WHERE `Serial`='%s' AND `ClassIP` = '%s'", playerserial, playerip);
		mysql_tquery(SQL, query, "CheckClassIP", "d", playerid);
	*/
	return 1;
}

function CheckAccount(playerid) {
	new rows = cache_num_rows();

	if(!rows) { // go to register
		for( new j = 0; j <= 20; j++) SCM(playerid, COLOR_WHITE, "");
		PlayerInfo[playerid][pKey][0] = EOS;
		SCM(playerid, COLOR_SERVER, "SERVER: {ffffff}Welcome to CROWLAND RPG.");
		SCM(playerid, COLOR_SERVER, "SERVER: {ffffff}You aren't registered yet. Please enter your desired password in the dialog box to register.");
		ShowPlayerDialogEx(playerid, DIALOG_LOGIN1, DIALOG_STYLE_PASSWORD, "SERVER: Registration", "Welcome to the CROWLAND RPG Server.\n\nPlease enter your desired password below!", "Register", "Cancel");
	}
	else { // go to login
		new pw[128];
		cache_get_value_name(0, "password", pw);
		format(PlayerInfo[playerid][pKey], 128, pw);

		for( new j = 0; j <= 20; j++) SCM(playerid, COLOR_WHITE, "");

		SCM(playerid, COLOR_SERVER, "SERVER: {ffffff}Welcome to CROWLAND RPG.");
		SCM(playerid, COLOR_SERVER, "SERVER: {ffffff}You already have a registered account, please enter your password into the dialog box.");
		ShowPlayerDialogEx(playerid, DIALOG_LOGIN2, DIALOG_STYLE_PASSWORD, "SERVER: Login", "Welcome to the CROWLAND RPG Server.\n\nPlease enter your password below!", "Login","Quit");

		kickLogin[playerid] = SetTimerEx("LoginTimer", 30000, false, "d", playerid);
	}

	return 1;
}


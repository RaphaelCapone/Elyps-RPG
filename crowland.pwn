function LVPDGates(id) {
	switch(id) {
		case 1: MoveDynamicObject(gatelvpd[0], 2293.85132, 2497.67554, 4.53215, 5);
		case 2: MoveDynamicObject(gatelvpd[1], 2335.20093, 2443.69922, 7.23391, 5);

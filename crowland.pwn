function LoadClans() {
	new clans = cache_num_rows (), x;
 	for(new i = 0; i != clans; ++i) {
       	cache_get_value_name_int(i, "ID", x);
       	cache_get_value_name(i, "Owner", ClanInfo[x][clOwner]);

				ShowPlayerDialogEx(playerid, DIALOG_REGISTER2, DIALOG_STYLE_INPUT, "Varsta","Scrie varsta caracterului tau:","Ok","");
				RegistrationStep[playerid] = 2;
				SetPlayerInterior(playerid, 0);
				SetPlayerSkinEx(playerid, 170);
				PlayerInfo[playerid][pModel] = 170;

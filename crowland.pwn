					mysql_tquery(SQL, query, "", "");
				}
			}
		}
	}
	return 1;
}
stock isBadFloat(Float: x) {
	if(x >= 10.0 || x <= -10.0) return true;
	return false;
}

public OnPlayerWeaponShot(playerid, weaponid, hittype, hitid, Float:fX, Float:fY, Float:fZ)
{
	if(GetPlayerSurfingVehicleID(playerid) != INVALID_VEHICLE_ID && !IsABoat(GetPlayerSurfingVehicleID(playerid))) {
		if(weaponid != 0) {
			SetPlayerArmedWeapon(playerid, 0);
			SCM(playerid, COLOR_WARNING, "Nu poti folosi armele atata timp cat esti pe vehicul!");
		}
	}


    if(hittype != BULLET_HIT_TYPE_NONE) {
        if((fX <= -1000.0 || fX >= 1000.0) || (fY <= -1000.0 || fY >= 1000.0) || (fZ <= -1000.0 || fZ >= 1000.0) || (hittype < 0 || hittype > 4)) {
            return Kick(playerid);
        }
    }
    else if (weaponid <= 0 || weaponid > 46) return 0; // Kick(playerid);

    if(weaponid == 24)
    {
        if((gettime() - shotTime[playerid]) < 1) shot[playerid] += 1;
        else shot[playerid] = 0;
        if(shot[playerid] > 10) {
			new string[184];
			format(string, sizeof(string), "AdmWarning: %s(%d) a primit kick pentru rapid fire.",GetName(playerid),playerid);
			SendAdminMessage(COLOR_WARNING, string,1);
			KickEx(playerid);
        }
        shotTime[playerid] = gettime();
    }
    return 1;
}

public OnQueryError(errorid, const error[], const callback[], const query[], MySQL:handle)
{
	if(errorid == 2003) {
		foreach(Player, i) {
			if(IsPlayerLogged[i] == 1) {
				SCM(i, COLOR_CLIENT, "SERVER: Ai primit kick deoarece sunt probleme tehnice cu baza de date!");
				SCM(i, COLOR_CLIENT, "SERVER: Revenim cat mai repede posibil. Nu exista un termen anume.");
				KickEx(i);
			}
		}
		SendRconCommand("password boss");
		SendRconCommand("hostname CROWLAND RPG | Probleme tehnice (0.3.7)");
		return 1;
	}
	print( "====================================================================" );
	printf( "Error ID: %d, Error: %s", errorid, error );
	printf( "Callback: %s", callback );
	printf( "gQuery: %s", query );
	print( "====================================================================" );
	return 1;
}

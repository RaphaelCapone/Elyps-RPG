CMD:givekey(playerid, params[]) {
	new id, keyid, string[180];
	if(!IsPlayerInAnyVehicle(playerid)) return SendClientMessage(playerid, -1, "Nu esti intr-un vehicul!");
	new car = GetPlayerVehicleID(playerid);
	new idd = VehicleSQL[car];
	if(idd == 0) return Error(playerid, "Acest vehicul nu este unul personal.");

    if(sscanf(params, "u", id)) return SendClientMessage(playerid, COLOR_GREY, "{DC0C0C}[Info:] {FFFFFF}/givekey <playerid/name>");
	if(!IsPlayerConnected(id)) return SendClientMessage(playerid, -1, "Acel player nu este conectat.");
	if(!ProxDetectorS(30.0, id, playerid)) return SCM(playerid, -1, "Nu esti langa acel jucator!");
	if(id == playerid) return SCM(playerid, COLOR_GREY, "Nu poti folosi aceasta comanda asupra ta!");
	if(VehicleKey[id] != 0) return SCM(playerid, COLOR_WHITE, "Acel player are deja cheia unui vehicul!");
	VehicleKey[id] = car;
	format(string, sizeof(string), "* %s ti-a dat cheile vehiculului %s (%d).", GetName(playerid), aVehicleNames[CarInfo[idd][cModel]-400], car);
	SCM(id, COLOR_LIGHTBLUE, string);
	format(string, sizeof(string), "* I-ai dat lui %s, cheile de la vehiculul %s (slot %d).", GetName(id), aVehicleNames[CarInfo[idd][cModel]-400], keyid);
	SCM(playerid, COLOR_LIGHTBLUE, string);
	return 1;
}
YCMD:throwkey(playerid, params[], help) {
	if(VehicleKey[playerid] == 0) return 1;
	VehicleKey[playerid] = 0;
	SCM(playerid, COLOR_LIGHTBLUE, "Ai aruncat cheile!");
	return 1;
}
stock LockCarFunction(playerid) {
	new car, engine, lights, alarm, doors, bonnet, boot, objective;//, idd, succes;

	if(IsPlayerInAnyVehicle(playerid)) car = GetPlayerVehicleID(playerid);
	else car = GetClosestVehicle2(playerid);
	if(car == INVALID_VEHICLE_ID) return 1;
	else if(!IsPlayerNearVehicle(playerid, car, 5) && !IsABoat(car)) return 1;
	else if(!IsPlayerNearVehicle(playerid, car, 10) && IsABoat(car)) return 1;

	GetVehicleParamsEx(car, engine, lights, alarm, doors, bonnet, boot, objective);

	
	if((PizzaCar[playerid] == car && JobWorking3[playerid] == 1)) {
		switch(lockedVehicle[car]) {
			case 1: {
				lockedVehicle[car] = 0;
				va_GameTextForPlayer(playerid, "~w~%s~n~~g~Deschis", 5000, 4, aVehicleNames[GetVehicleModel(car) - 400]);
				SetVehicleParamsEx(car, engine, lights, alarm, 0, bonnet, boot, objective);
			}
			case 0: {
				lockedVehicle[car] = 1;
				va_GameTextForPlayer(playerid, "~w~%s~n~~r~Inchis", 5000, 4, aVehicleNames[GetVehicleModel(car) - 400]);
				SetVehicleParamsEx(car, engine, lights, alarm, 1, bonnet, boot, objective);
			}
		}
		return 1;
	}
	

	if((JobVehicle[playerid] == car && JobWorking[playerid] == 1)) {
		switch(lockedVehicle[car]) {
			case 1: {
				lockedVehicle[car] = 0;
				va_GameTextForPlayer(playerid, "~w~%s~n~~g~Deschis", 5000, 4, aVehicleNames[GetVehicleModel(car) - 400]);
				SetVehicleParamsEx(car, engine, lights, alarm, 0, bonnet, boot, objective);
			}
			case 0: {
				lockedVehicle[car] = 1;
				va_GameTextForPlayer(playerid, "~w~%s~n~~r~Inchis", 5000, 4, aVehicleNames[GetVehicleModel(car) - 400]);
				SetVehicleParamsEx(car, engine, lights, alarm, 1, bonnet, boot, objective);
			}
		}
		return 1;
	}

	// pers key
	if(VehicleSQL[car] != 0) {
		new idd = VehicleSQL[car], string[80];
		if(VehicleKey[playerid] == car || CarInfo[idd][Userid] == PlayerInfo[playerid][pSQLID]) {
			if(CarInfo[idd][cLock] == 0) {
				CarInfo[idd][cLock] = 1;
				SetVehicleParamsEx(car,engine,lights,alarm,1,bonnet,boot,objective);
				format(string, 40, "~w~%s~n~~r~Inchis",aVehicleNames[CarInfo[idd][cModel]-400]);
				GameTextForPlayer(playerid, string, 5000, 4);
			}
			else {
				CarInfo[idd][cLock] = 0;
				SetVehicleParamsEx(car,engine,lights,alarm,0,bonnet,boot,objective);
				format(string, 40, "~w~%s~n~~g~Deschis",aVehicleNames[CarInfo[idd][cModel]-400]);
				GameTextForPlayer(playerid, string, 5000, 4);
			}
			string[0] = EOS;
			mysql_format(SQL, string, 80, "UPDATE `cars` SET `Lockk`='%d' WHERE `ID`='%d'", CarInfo[idd][cLock], idd);
			mysql_tquery(SQL, string, "", "");
			return 1;
		}
	}


	if(VehicleSQL[car] != 0) {
		new idd = VehicleSQL[car], string[60];
		if(VehicleKey[playerid] == car || CarInfo[idd][Userid] == PlayerInfo[playerid][pSQLID]) {
			if(CarInfo[idd][cLock] == 0) {
				CarInfo[idd][cLock] = 1;
				SetVehicleParamsEx(car,engine,lights,alarm,1,bonnet,boot,objective);
				format(string, sizeof(string), "~w~%s~n~~r~Inchis",aVehicleNames[CarInfo[idd][cModel]-400]);
				GameTextForPlayer(playerid, string, 5000, 4);
			}
			else {
				CarInfo[idd][cLock] = 0;
				SetVehicleParamsEx(car,engine,lights,alarm,0,bonnet,boot,objective);
				format(string, sizeof(string), "~w~%s~n~~g~Deschis",aVehicleNames[CarInfo[idd][cModel]-400]);
				GameTextForPlayer(playerid, string, 5000, 4);
			}
			string[0] = EOS;
			mysql_format(SQL, string, sizeof(string), "UPDATE `cars` SET `Lockk`='%d' WHERE `ID`='%d'", CarInfo[idd][cLock], idd);
			mysql_tquery(SQL, string, "", "");
			return 1;
		}
	}

	// if(!GetVehicles(playerid)) return 1;

	// idd = FindSpawnID(vehicle);
	// if(!idd) return 1;
	// for(new i = 0; i < 10; i++) { if(PlayerInfo[playerid][pCarKey][i] == idd && idd != 0) succes = 1; }
	// if(!succes) return 1;

	// switch(CarInfo[idd][cLock]) {
		// case 1: {
			// CarInfo[idd][cLock] = 0;
			// va_GameTextForPlayer(playerid, "~w~%s~n~~g~Deschis", 5000, 4, aVehicleNames[GetVehicleModel(vehicle) - 400]);
			// SetVehicleParamsEx(vehicle, engine, lights, alarm, 0, bonnet, boot, objective);
		// }
		// case 0: {
			// CarInfo[idd][cLock] = 1;
			// va_GameTextForPlayer(playerid, "~w~%s~n~~r~Inchis", 5000, 4, aVehicleNames[GetVehicleModel(vehicle) - 400]);
			// SetVehicleParamsEx(vehicle, engine, lights, alarm, 1, bonnet, boot, objective);
		// }
	// }

	return 1;
}
stock IsPlayerNearVehicle(playerid, vehicleid, Float:range) {
    new Float:X, Float:Y, Float:Z;
    GetVehiclePos(vehicleid, X, Y, Z);
    if(IsPlayerInRangeOfPoint(playerid, range, X, Y, Z))return true;
    else return false;
}
function IsVehicleOccupied(vehicleid) {
	foreach(Player, i) if(IsPlayerInVehicle(i,vehicleid)) return 1;
	return 0;
}


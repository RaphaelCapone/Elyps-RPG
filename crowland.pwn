YCMD:dp(playerid, params[], help) {
	new id;
	if(PlayerInfo[playerid][pAdmin] < 5) return 1;
	if(sscanf(params, "i", id)) return SCM(playerid,COLOR_GREY, "USAGE: {FFFFFF}/dp <punish id>");
	new szQuery[100];
	mysql_format(SQL, szQuery, 100, "SELECT * FROM `sanctions` WHERE `ID`='%d'", id);
	new Cache: result = mysql_query(SQL, szQuery);
	new test;
	cache_get_row_count (test);
	cache_delete(result);
	if(test == 0) return SCM(playerid, COLOR_GREY, "Punish id invalid!");
	format(szQuery, sizeof(szQuery), "DELETE FROM `sanctions` WHERE `ID`='%d'", id);
	mysql_tquery(SQL, szQuery, "", "");
	return 1;
}
YCMD:lp(playerid, params[], help) {
	new id;
	if(PlayerInfo[playerid][pAdmin] < 1) return 1;
	if(sscanf(params, "u", id)) return SCM(playerid,COLOR_GREY, "USAGE: {FFFFFF}/lastpunish <playerid/name>");
	if(id == INVALID_PLAYER_ID) return SCM(playerid, COLOR_GREY, "Acel player nu este conectat.");
	ShowPunish(playerid, id);
	return 1;
}
YCMD:mylp(playerid, params[], help) return ShowPunish(playerid, playerid);
function ShowPunish(playerid, targetid) {
	new
		szDialog2[4000], id, szQuery[256], string[120], Cache: result, b, k, j, m, w,
		by[24], time[50], reason[60];

	mysql_format(SQL, szQuery, sizeof(szQuery), "SELECT * FROM `sanctions` WHERE `Userid`='%d' AND `Type`='%d' ORDER BY `sanctions`.`ID` DESC LIMIT 10", PlayerInfo[targetid][pSQLID], BAN);
	result = mysql_query(SQL, szQuery);
	strcat(szDialog2, "Ban-uri:\n");
	new r;
	cache_get_row_count(r);
	for(new i = 0; i < r; i++) {
		cache_get_value_name_int(i, "ID", id);
		cache_get_value_name(i, "By", by, 24);
		cache_get_value_name(i, "Time", time, 50);
		cache_get_value_name(i, "Reason", reason, 60);
		format(string, sizeof(string), "(#%d) [%s] Ban primit de la adminul %s, motiv: %s.\n", id, time, by, reason);
		strcat(szDialog2, string);
		b ++;
	}
	if(b == 0) strcat(szDialog2, "Nicio sanctiune.\n\n");
	else strcat(szDialog2, "\n");
	cache_delete(result);

	mysql_format(SQL, szQuery, sizeof(szQuery), "SELECT * FROM `sanctions` WHERE `Userid`='%d' AND `Type`='%d' ORDER BY `sanctions`.`ID` DESC LIMIT 10", PlayerInfo[targetid][pSQLID], KICK);
	result = mysql_query(SQL, szQuery);
	strcat(szDialog2, "Kick-uri:\n");
	cache_get_row_count(r);
	for(new i = 0; i < r; i++) {
		cache_get_value_name_int(i, "ID", id);
		cache_get_value_name(i, "By", by);
		cache_get_value_name(i, "Time", time);
		cache_get_value_name(i, "Reason", reason);
		format(string, sizeof(string), "(#%d) [%s] Kick primit de la adminul %s, motiv: %s.\n", id, time, by, reason);
		strcat(szDialog2, string);
		k ++;
	}
	if(k == 0) strcat(szDialog2, "Nicio sanctiune.\n\n");
	else strcat(szDialog2, "\n");
	cache_delete(result);

	mysql_format(SQL, szQuery, sizeof(szQuery), "SELECT * FROM `sanctions` WHERE `Userid`='%d' AND `Type`='%d' ORDER BY `sanctions`.`ID` DESC LIMIT 10", PlayerInfo[targetid][pSQLID], WARN);
	result = mysql_query(SQL, szQuery);
	strcat(szDialog2, "Warn-uri:\n");
	cache_get_row_count(r);
	for(new i = 0; i < r; i++) {
		cache_get_value_name_int(i, "ID", id);
		cache_get_value_name(i, "By", by);
		cache_get_value_name(i, "Time", time);
		cache_get_value_name(i, "Reason", reason);
		format(string, sizeof(string), "(#%d) [%s] Warn primit de la adminul %s, motiv: %s.\n", id, time, by, reason);
		strcat(szDialog2, string);
		w ++;
	}
	if(w == 0) strcat(szDialog2, "Nicio sanctiune.\n\n");
	else strcat(szDialog2, "\n");
	cache_delete(result);

	mysql_format(SQL, szQuery, sizeof(szQuery), "SELECT * FROM `sanctions` WHERE `Userid`='%d' AND `Type`='%d' ORDER BY `sanctions`.`ID` DESC LIMIT 10", PlayerInfo[targetid][pSQLID], JAIL);
	result = mysql_query(SQL, szQuery);
	strcat(szDialog2, "Jail-uri:\n");
	cache_get_row_count(r);
	for(new i = 0; i < r; i++) {
		cache_get_value_name_int(i, "ID", id);
		cache_get_value_name(i, "By", by);
		cache_get_value_name(i, "Time", time);
		cache_get_value_name(i, "Reason", reason);
		format(string, sizeof(string), "(#%d) [%s] Jail primit de la adminul %s, motiv: %s.\n", id, time, by, reason);
		strcat(szDialog2, string);
		j ++;
	}
	if(j == 0) strcat(szDialog2, "Nicio sanctiune.\n\n");
	else strcat(szDialog2, "\n");
	cache_delete(result);

	format(szQuery, sizeof(szQuery), "SELECT * FROM `sanctions` WHERE `Userid`='%d' AND `Type`='%d' ORDER BY `sanctions`.`ID` DESC LIMIT 10", PlayerInfo[targetid][pSQLID], MUTE);
	result = mysql_query(SQL, szQuery);
	strcat(szDialog2, "Mute:\n");
	cache_get_row_count(r);
	for(new i = 0; i < r; i++) {
		cache_get_value_name_int(i, "ID", id);
		cache_get_value_name(i, "By", by);
		cache_get_value_name(i, "Time", time);
		cache_get_value_name(i, "Reason", reason);
		format(string, sizeof(string), "(#%d) [%s] Mute primit de la adminul %s, motiv: %s.\n", id, time, by, reason);
		strcat(szDialog2, string);
		m ++;
	}
	if(m == 0) strcat(szDialog2, "Nicio sanctiune.\n");
	cache_delete(result);
	ShowPlayerDialogEx(playerid, 0, DIALOG_STYLE_MSGBOX, "Sanctiuni", szDialog2, "Ok", "");
	return 1;
}
function InsertLog(playerid, text[], type) {
	new
		szQuery[250], szDate[100], Year, Month, Day, Hour, Minute, Second, ip[180];

	getdate(Year, Month, Day);
	gettime(Hour, Minute, Second);
	GetPlayerIp(playerid, ip, sizeof(ip));
	format(szDate, 100, "%02d/%02d/%d - %02d:%02d:%02d", Day, Month, Year, Hour, Minute, Second);

	mysql_format(SQL, szQuery, 250, "INSERT INTO `logs` (`Userid`, `Text`, `Date`, `Type`, `IP`) VALUES ('%d', '%e', '%s', '%d', '%s')",
	PlayerInfo[playerid][pSQLID], text, szDate, type, ip);

	mysql_tquery(SQL, szQuery, "", "");
	return 1;
}
function InsereazaSanctiune(playerid, by, type, reason[]) {
	new
		szQuery[300], name[35], aname[35],
		szDate[100], Year, Month, Day, Hour, Minute, Second;

	format(name, 35, "%s (%d)", GetName(playerid), PlayerInfo[playerid][pSQLID]);
	getdate(Year, Month, Day);
	gettime(Hour, Minute, Second);
	format(szDate, 100, "%02d/%02d/%d - %02d:%02d:%02d", Day, Month, Year, Hour, Minute, Second);

	if(by == AdmBot) aname = "AdmBot";
	else format(aname, 35, "%s (%d)", GetName(by), PlayerInfo[by][pSQLID]);
	mysql_format(SQL, szQuery, 300, "INSERT INTO `sanctions` (`Player`, `By`, `Time`, `Userid`, `Type`, `Reason`) VALUES ('%s', '%s', '%s', '%d', '%d', '%e')", name, aname, szDate, PlayerInfo[playerid][pSQLID], type, reason);
	mysql_tquery(SQL, szQuery, "", "");
	return 1;
}
function InsereazaSanctiune2(playerid, pname[], by, bname[], type, reason[]) {
	new
		szQuery[300], name[35], aname[35],
		szDate[100], Year, Month, Day, Hour, Minute, Second;

	format(name, 35, "%s (%d)", pname, playerid);
	getdate(Year, Month, Day);
	gettime(Hour, Minute, Second);
	format(szDate, 100, "%02d/%02d/%d - %02d:%02d:%02d", Day, Month, Year, Hour, Minute, Second);

	if(by == AdmBot) aname = "AdmBot";
	else format(aname, 35, "%s (%d)", bname, by);
	format(szQuery, 300, "INSERT INTO `sanctions` (`Player`, `By`, `Time`, `Userid`, `Type`, `Reason`) VALUES ('%s', '%s', '%s', '%d', '%d', '%e')", name, aname, szDate, playerid, type, reason);
	mysql_tquery(SQL, szQuery, "", "");
	return 1;
}

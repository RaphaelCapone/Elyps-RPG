function valid_vip_vehicle(vehid) {
	switch(vehid) {
		case 560: return 1;
		case 541: return 1;
		case 429: return 1;
		case 495: return 1;
		case 579: return 1;
		case 562: return 1;
		case 451: return 1;
		case 480: return 1;
		case 411: return 1;
	}
	return 0;
}

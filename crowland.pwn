#pragma dynamic (64*1024)



stock SendUsage(playerid, string[])
{
	new StrinG[150];
	format(StrinG, 150, "{A9C4E4}Usage:{ffffff} %s", string);
	return SCM(playerid, -1, StrinG);
}

stock IsConnected(playerTarget, playerid) {
	if(!IsPlayerConnected(playerTarget) || playerTarget == INVALID_PLAYER_ID) return SCM(playerid, COLOR_GREY, "Acel jucator nu este conectat."), false;
	else return true;
}

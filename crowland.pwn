		case DIALOG_MEMBERS: {
			if(!response) return 1;
			if(PlayerInfo[playerid][pRank] < 7) return SCM(playerid, COLOR_LGREEN, "Eroare: Ai nevoie de rank 7 pentru a putea merge mai departe!");
			new szQuery[90];
			format(sName[playerid], 24, Selected[playerid][listitem]);
			mysql_format(SQL, szQuery, 90, "SELECT * FROM `users` WHERE `name`='%s' LIMIT 1", sName[playerid]);
			new Cache: result = mysql_query(SQL, szQuery), rank, r;
			cache_get_row_count(r);
			if(r == 0) return SCM(playerid, -1, "A intervenit o problema.");
			cache_get_value_name_int(0, "Rank", rank);
			if(rank == 7)  return SCM(playerid, COLOR_LGREEN, "Eroare: Nu se poate modifica ceva unui lider!");
			cache_delete(result);
			format(string, sizeof(string), "Member: %s", sName[playerid]);
			ShowPlayerDialogEx(playerid, DIALOG_MEMBERS+1, DIALOG_STYLE_LIST, string, "Raport\nRank\nFaction warn\nUn faction warn\nUninvite", "Ok", "Back");

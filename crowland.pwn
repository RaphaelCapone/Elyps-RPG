YCMD:nos(playerid, params[], help) {
	if(PlayerInfo[playerid][pAdmin] < 1) return SendClientMessage(playerid, COLOR_WHITE, AdminOnly);
	if(!IsPlayerInAnyVehicle(playerid)) return 1;
	if(PlayerInfo[playerid][pVip] == 1 && PlayerInfo[playerid][pWantedLevel] != 0) return  SCM(playerid, -1, "Nu poti folosi aceasta comanda atata timp cat ai wanted!");
    AddVehicleComponent(GetPlayerVehicleID(playerid),1010);
    SCM(playerid, COLOR_YELLOW, "Comanda executata cu succes.");
	return 1;
}
YCMD:fish(playerid, params[], help) {
	if(PlayerInfo[playerid][pJob] != 2) return SCM(playerid, COLOR_GREY, "Nu esti pescar!");
	if(DeelayCommand[playerid][4] != 0) return DeelayTime(playerid, 4);
 	if(Iter_Count(WorkingPlayers[PlayerInfo[playerid][pJob]]) == 75) return SCM(playerid, -1, "Muncesc deja 75 de jucatori la acest job.");
	if(!IsPlayerInRangeOfPoint(playerid, 20.0, -1196.5670, 455.6780, 6.1990)) return SCM(playerid, COLOR_GREY, "Nu esti in zona in care poti sa pescuiesti.");
	if(IsPlayerInAnyVehicle(playerid)) return SCM(playerid, -1, "Nu poti sa folosesti aceasta comanda dintr-un vehicul.");
	if(PlayerInfo[playerid][pMomeala] == 0) return SCM(playerid, -1, "Nu ai momeala, foloseste /buybait pentru a cumpara.");
	if(HaveFish[playerid] != 0) return SCM(playerid, -1, "Ai prins deja un peste! Mergi si vinde-l la Fish Market.");
	if(StartFish[playerid] == 1) return 1;
	GameTextForPlayer(playerid,"~n~~n~~n~~n~~n~~n~~n~~n~~w~YOU'RE FISHING NOW...",15000,3);
	PlayerInfo[playerid][pMomeala] = -1;
	new str1[128];
	format(str1,sizeof(str1),"UPDATE users SET `Momeala`='%d' WHERE `ID`='%d'",PlayerInfo[playerid][pMomeala], PlayerInfo[playerid][pSQLID]);
	mysql_tquery(SQL, str1, "", "");
	SetTimerEx("Fish", 15000, 0, "d", playerid);
	TogglePlayerControllable(playerid, 0);
	ApplyAnimation(playerid, "SAMP", "FishingIdle", 3.0,1,1,0,0,0);
	SetPlayerAttachedObject(playerid, 2, 18632,6,0.079376,0.037070,0.007706,181.482910,0.000000,0.000000,1.000000,1.000000,1.000000);
    StartFish[playerid] = 1;
	Freezed[playerid] = 1;
	DeelayCommand[playerid][4] = 30*3;
	return 1;
}

function Fish(playerid) {
	new x, string[180];
	if(!IsPlayerConnected(playerid)) return 1;
	if(GetPlayerSurfingVehicleID(playerid) != INVALID_VEHICLE_ID) {
		SCM(playerid, -1, "Actiunea a esuat deoarece esti pe un vehicul.");
		StartFish[playerid] = 0;
		TogglePlayerControllable(playerid, 1);
		Freezed[playerid] = 0;
		RemovePlayerAttachedObject(playerid, 0);
		return 1;
	}
	if(PlayerInfo[playerid][pJob] == 2 && StartFish[playerid] == 1) {
	    RemovePlayerAttachedObject(playerid, 2);
		x = 20000 + random(10000) + GetPlayerSkill(playerid)*14000;
		format(string, sizeof(string), "Ai prins un peste care valoreaza $%s!", FormatNumber(x));
		SCM(playerid, COLOR_YELLOW, string);
		SCM(playerid, -1, "Pentru a vinde pestele, trebuie sa mergi la Fish Market. (/gps)");
		format(string, sizeof(string), "* %s a prins un peste care valoreaza $%s.", GetName(playerid), FormatNumber(x));
		NearMessage(playerid, COLOR_YELLOW, string);
		HaveFish[playerid] = x;
		StartFish[playerid] = 0;
		TogglePlayerControllable(playerid, 1);
		Freezed[playerid] = 0;
   		Iter_Add(WorkingPlayers[PlayerInfo[playerid][pJob]], playerid);
	}
	return 1;
}


  		case DIALOG_RENTBIKE: {

			if(!response) return 1;
			if(IsValidVehicle(RentVehicle[playerid])) return Error(playerid, "Ai inchiriat deja un vehicul. Foloseste comanda /unrentveh pentru a renunta la el.");
			if(GetPlayerCash(playerid) < 25000) return SCM(playerid, COLOR_GREY, "Ai nevoie de suma de 25,000$ pentru a inchiria un vehicul.");

			new av_stock = availableStock[listitem];
			if(av_stock < 1) return Error(playerid, "Acest vehicul nu mai este disponibil momentan.");

			new Float:x, Float:y, Float:z, Float:k;
			GetPlayerPos(playerid, x, y, z);
			GetPlayerFacingAngle(playerid, k);

			RentVehicle[playerid] = CreateVehicle(rentStockModels[listitem], x, y, z, k, -1, -1, -1);
			new v = RentVehicle[playerid];
			Gas[v] = 100;
			PutPlayerInVehicle(playerid, v, 0);

           	new engine,lights,alarm,doors,bonnet,boot,objective;
           	GetVehicleParamsEx(v, engine,lights,alarm,doors,bonnet,boot,objective);
			SetVehicleParamsEx(v, engine,lights,alarm,0,bonnet,boot,objective);
			GivePlayerCash(playerid, -25000);

			availableStock[listitem] --;

			BizzInfo[15][bBalance] += 5000;
			BizzInfo[16][bBalance] += 5000;

			SCMf(playerid, COLOR_JOB, "[Rent]: {ffffff}Ai inchiriat cu succes vehiculul %s. Tasteaza /unrentveh cand doresti sa renunti la vehicul.", aVehicleNames[rentStockModels[listitem] - 400]);
			SCM(playerid, COLOR_JOB, "[Rent]: {ffffff}Foloseste comanda /lockrentveh pentru a inchide vehiculul inchiriat, iar comanda /findrentveh pentru a-l localiza.");

			mysql_format(SQL, string, 60, "UPDATE `bizz` SET `Till`='%d' WHERE `ID`='15'",BizzInfo[15][bBalance]);
			mysql_tquery(SQL, string, "", "");
			mysql_format(SQL, string, 60, "UPDATE `bizz` SET `Till`='%d' WHERE `ID`='16'",BizzInfo[16][bBalance]);
			mysql_tquery(SQL, string, "", "");
        }
		case DIALOG_STORE: {
			if(!response) return 1;
			new bizz = InBussines[playerid];
			switch(listitem) {
				case 0: {
					if(GetPlayerCash(playerid) < 5000) return SCM(playerid, COLOR_GREY, "Nu ai destui bani pentru a face asta.");
					new tel[16];
					format(tel, 256, "%d", PlayerInfo[playerid][pPhone]);
					if(strlen(tel) == 4) return SCM(playerid, COLOR_GREY, "Nu poti cumpara un alt numar de telefon deoarece ai iPhone!");
					GivePlayerCash(playerid,-5000);
					BizzInfo[bizz][bBalance] += 2500;
					PlayerPlaySound(playerid, 1052, 0.0, 0.0, 0.0);
					new randphone = 5000 + random(9999) + 5000 ;
					PlayerInfo[playerid][pPhone] = randphone;

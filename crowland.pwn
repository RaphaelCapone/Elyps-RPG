				ShowPlayerDialogEx(playerid, DIALOG_REGISTER5, DIALOG_STYLE_INPUT, "Referral", "Ai fost adus de catre cineva pe comunitate?\n\nIntrodu codul jucatorului pentru a beneficia de anumite bonusuri.", "Introdu", "Skip");
				return 1;
			}

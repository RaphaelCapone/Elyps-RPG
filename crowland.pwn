	Cash[playerid] += money;
	Update(playerid, pCashx);
	return 1;
}
stock GetPlayerCash(playerid) return Cash[playerid];
stock ResetPlayerCash(playerid) return Cash[playerid] = 0;

stock CalculeazaTimp(secunde) {
	new time = secunde;
	new ora = time/3600;
	time = time%3600;
	new minute = time/60;
	time = time%60;
	new secunde2 = time;
	new string[10];
	format(string, sizeof(string), "%02d:%02d:%02d",ora,minute,secunde2);
	return string;
}

stock CalculeazaTimp2(secunde) {
	new time = secunde;
	time = time%3600;
	new minute = time/60;
	time = time%60;
	new secunde2 = time;
	new string[10];
	format(string, sizeof(string), "%02d:%02d",minute,secunde2);
	return string;
}

stock GetVehicleSpeed(vehicleid, get3d) {
	new Float:x, Float:y, Float:z;
	GetVehicleVelocity(vehicleid, x, y, z);
	return SpeedCheck(x, y, z, 100.0, get3d);
}

stock PlayAudioStreamForPlayersInCar(vehicleid,url[]) {
    foreach(Player,i) {
        if(IsPlayerInAnyVehicle(i)) {
            if(GetPlayerVehicleID(i) == vehicleid) PlayAudioStreamForPlayer(i,url);
        }
    }
    return 1;
}

stock StopAudioStreamForPlayersInCar(vehicleid) {
    foreach(Player,i) {
        if(IsPlayerInAnyVehicle(i)) {
            if(GetPlayerVehicleID(i) == vehicleid) StopAudioStreamForPlayer(i);
        }
    }
    return 1;
}

function UpdatePlayer(playerid) {
    if(GetPlayerMoney(playerid) != Cash[playerid]) {
		ResetMoneyBar(playerid);
		UpdateMoneyBar(playerid, Cash[playerid]);
    }
    return 1;
}

function HideTextdraw2(playerid, tdid) {
	if(!IsPlayerConnected(playerid)) return 1;
	PlayerTimer[playerid] = 0;
	PlayerCase[playerid] = 0;
	return 1;
}

FormatNumber(number) {
   new Str[15];
   format(Str, 15, "%d", number);
   if(strlen(Str) < sizeof(Str)) {
      if(number >= 1000 && number < 10000) strins( Str, ",", 1, sizeof(Str));
      else if(number >= 10000 && number < 100000) strins(Str, ",", 2, sizeof(Str));
      else if(number >= 100000 && number < 1000000) strins(Str, ",", 3, sizeof(Str));
      else if(number >= 1000000 && number < 10000000) strins(Str, ",", 1, sizeof(Str)),strins(Str, ",", 5, sizeof(Str));
      else if(number >= 10000000 && number < 100000000) strins(Str, ",", 2, sizeof(Str)),strins(Str, ",", 6, sizeof(Str));
      else if(number >= 100000000 && number < 1000000000) strins(Str, ",", 3, sizeof(Str)),strins(Str, ",", 7, sizeof(Str));
      else if(number >= 1000000000 && number < 10000000000)
           strins(Str, ",", 1, sizeof(Str)),
           strins(Str, ",", 5, sizeof(Str)),
           strins(Str, ",", 9, sizeof(Str));
      else format(Str, 10, "%d", number);
   }
   return Str;
}

stock IsMail(email[]) {
  	new len=strlen(email), cstate=0, i;
  	for(i=0;i<len;i++) {
	    if((cstate==0 || cstate==1) && (email[i]>='A' && email[i]<='Z')||(email[i]>='0' && email[i]<='9') || (email[i]>='a' && email[i]<='z')  || (email[i]=='.')  || (email[i]=='-')  || (email[i]=='_')) { }
		else {
	       if((cstate==0) &&(email[i]=='@')) cstate=1;
		   else return false;
	 	}
	}
  	if(cstate<1) return false;
  	if(len<6) return false;
  	if((email[len-3]=='.') || (email[len-4]=='.') || (email[len-5]=='.')) return true;
  	return false;
}

function SpecPlayer(playerid, targetid, bool:firsttime) {
	if(firsttime) {
		Spectate[playerid] = targetid;
		// SpecPlayers[playerid] ++;
		// if(SpecPlayers[playerid] == 1) {
		GetPlayerPos(playerid, SpecPos[playerid][0], SpecPos[playerid][1], SpecPos[playerid][2]);
		IsPlayerSpec{playerid} = true;
		pInteriorID[playerid] = GetPlayerInterior(playerid);
		pVirtual[playerid] = GetPlayerVirtualWorld(playerid);
		// }
		new Float:health;
		GetPlayerHealthEx(targetid, health);
		new rank[8];
		if(PlayerInfo[playerid][pAdmin] != 0) rank = "Admin";
		else rank = "Helper";

		new string[256];
		if(GetPVarInt(targetid, "ReportType") == 1) format(string, 130, "%s %s is now spectating %s. (reported for dm, score: %d)", rank, GetName(playerid),GetName(targetid), GetPVarInt(targetid, "ReportScore"));
		else if(GetPVarInt(targetid, "ReportType") == 2) format(string, 130, "%s %s is now spectating %s. (reported for cheats, score: %d)", rank, GetName(playerid),GetName(targetid), GetPVarInt(targetid, "ReportScore"));
		else if(GetPVarInt(targetid, "ReportType") == 3)  format(string, 130, "%s %s is now spectating %s. (stuck)", rank, GetName(playerid),GetName(targetid));

		if(GetPVarInt(targetid, "Reported") == 1 && GetPVarInt(targetid, "ReportType") != 4 && PlayerInfo[playerid][pAdmin] >= 1) {
			SetPVarInt(targetid, "Reported", 0);
			SetPVarInt(targetid, "ReportType", 0);
			SetPVarString(targetid, "ReportedBy", "");
			SetPVarInt(targetid, "ReportScore", 0);
			SetPVarString(targetid, "ReportText", "");
		}
		if(PlayerInfo[playerid][pAdmin] >= 1 && GetPVarInt(targetid, "ReportType") != 4) {
			PlayerInfo[playerid][pHelpedPlayers] += GetPVarInt(targetid, "ReportScore");
			PlayerInfo[playerid][pHelpedPlayersToday] += GetPVarInt(targetid, "ReportScore");
		}
		new szQuery[100];
		mysql_format(SQL, szQuery, 100, "UPDATE users SET `HelpedPlayers` = '%d', `HelpedPlayersToday`='%d' WHERE `ID` = '%d'", PlayerInfo[playerid][pHelpedPlayers], PlayerInfo[playerid][pHelpedPlayersToday], PlayerInfo[playerid][pSQLID]);
		mysql_tquery(SQL, szQuery, "", "");

		format(string, 120, "[SPEC] (%d) %s | Level: %d | Health: %.2f | AFK Time: %d | Seconds: %.0f | Duty: %d | Ping: %d",targetid,GetName(targetid),PlayerInfo[targetid][pLevel], health, AFKSeconds[targetid], PlayerInfo[targetid][pSeconds], OnDuty[targetid], GetPlayerPing(targetid));
		SCM(playerid, 0xFFADADFF, string);

		new Player_Weapons[13], Player_Ammos[13], i, guns;
		string = "Weapons:";
		for(i = 1;i <= 12;i++) {
			GetPlayerWeaponData(targetid,i,Player_Weapons[i],Player_Ammos[i]);
			if(Player_Weapons[i] != 0) {
				new weaponName[32];
				GetWeaponName(Player_Weapons[i],weaponName,32);
				format(string,255,"%s %s(%d)", string, weaponName,Player_Ammos[i]);
				guns ++;
			}
		}
		if(guns > 0) SCM(playerid, -1, string);

		SetPlayerInterior(playerid, GetPlayerInterior(targetid));
		SetPlayerVirtualWorld(playerid, GetPlayerVirtualWorld(targetid));
		TogglePlayerSpectating(playerid, true);

		if(IsPlayerInAnyVehicle(Spectate[playerid])) PlayerSpectateVehicle(playerid, GetPlayerVehicleID(Spectate[playerid]));
		else PlayerSpectatePlayer(playerid, Spectate[playerid]);

		PlayerTextDrawSetString(playerid, SpectatorTD, "Loading...");
		PlayerTextDrawShow(playerid, SpectatorTD);

		specTimer[playerid] = SetTimerEx("SpecPlayer", 2000, false, "ddb", playerid, targetid, false);
	}
	else {
		new Float: health, Float: armour, text1[10], text2[10], szTD[220];

		GetPlayerHealthEx(targetid, health);
		GetPlayerArmourEx(targetid, armour);
		if(PlayerInfo[targetid][pWantedLevel] == 0) text1 = "Nu";
		else format(text1, 10, "%d", PlayerInfo[targetid][pWantedLevel]);
		if(PlayerInfo[targetid][pJailTime] == 0) text2 = "Nu";
		else format(text2, 10, "%d", PlayerInfo[targetid][pJailTime]);

		if(GetPlayerState(targetid) == PLAYER_STATE_DRIVER) {
			new carid = GetPlayerVehicleID(targetid),
				speed = Carspeed(targetid);

			format(szTD, 220, "~y~%s (%d) - L: %d~n~~w~~h~Health: ~r~%.1f  ~w~~h~Armour: ~r~%.1f~n~~w~~h~Wanted: ~r~%s~w~~h~  ~w~~h~Jail: ~r~%s~n~~w~~h~Vehicle ID: ~r~%d~n~~w~~h~Speed: ~b~%d km/h", GetName(targetid), targetid, PlayerInfo[targetid][pLevel], health, armour, text1, text2, carid, speed);
			PlayerTextDrawSetString(playerid, SpectatorTD, szTD);
		}
		else {
			format(szTD, 220, "~y~%s (%d) - L: %d~n~~w~~h~Health: ~r~%.1f  ~w~~h~Armour: ~r~%.1f~n~~w~~h~Wanted: ~r~%s~w~~h~  ~w~~h~Jail: ~r~%s", GetName(targetid), targetid, PlayerInfo[targetid][pLevel], health, armour, text1, text2);
			PlayerTextDrawSetString(playerid, SpectatorTD, szTD);
		}

		new int = GetPlayerInterior(targetid), vw = GetPlayerVirtualWorld(targetid);
		if(int != GetPlayerInterior(playerid)) SetPlayerInterior(playerid, int);
		if(vw != GetPlayerVirtualWorld(playerid)) SetPlayerVirtualWorld(playerid, vw);
	}
	return 1;
}

stock GetVehicleRadio(vehid) {
	new string[100];
	if(CarRadio[vehid] == 0) string = "Off";
	else if(CarRadio[vehid] == sizeof(RadioLink)) string = "Youtube url";
	else format(string, sizeof(string), RadioNames2[CarRadio[vehid]]);
	return string;
}



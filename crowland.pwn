				PlayerInfo[playerid][pPetXp] += petx;
    			GivePlayerCash(playerid, 10000);
				SCMEx(playerid, COLOR_JOB, "(Pet Quest): {ffffff}Ai colectat acest premiu, drept rasplata ai primit 10 Pet Points, %d Pet Xp si 10,000$.", petx);
	  			Update(playerid, pPetPointsx);
				Update(playerid, pPetXpx);
				Update(playerid, pPMissionsx);
				}
			}
			SCM(playerid, -1, "Intoarce-te la punctul de pornire pentru a termina munca.");
  			SetPlayerCheckpointEx(playerid, -79.8614,-1130.8856,1.0781, 5.0);
   			new rand = random(2);
			switch(rand) {
				case 0: SetPlayerCheckpointEx(playerid, -79.8614,-1130.8856,1.0781, 5);
				case 1: SetPlayerCheckpointEx(playerid, -79.8614,-1130.8856,1.0781, 5);
			}
			CP[playerid] ++;
		}
		case 232: {
			CP[playerid] = 0;
			new j = PlayerInfo[playerid][pJob];
  			if(Iter_Contains(WorkingPlayers[j], playerid)) Iter_Remove(WorkingPlayers[j], playerid);
			JobWorking[playerid] = 0;
			PlayerTextDrawHide(playerid, JobTD);
			DestroyVehicle(JobVehicle[playerid]);
			JobVehicle[playerid] = 0;
			DestroyVehicle(Trailer[playerid]);
			Trailer[playerid] = 0;
			PlayerTextDrawHide(playerid, InfosTD);
			DisablePlayerCheckpointEx(playerid);
			SCM(playerid, COLOR_WHITE, "Job terminat.");
		}
	}
	PlayerPlaySound(playerid, 1058, 0.0, 0.0, 0.0);
	if(JobWorking[playerid] == 1 && PlayerInfo[playerid][pShowJob] == 1 && PlayerInfo[playerid][pShowHud] == 0) UpdateJobStats(playerid);
	CheckSeconds(playerid);
	JobTime[playerid] = GetTickCount();
	return 1;
}
public OnPlayerEnterVehicle(playerid, vehicleid, ispassenger)
{
	if(IsPlayerInAnyVehicle(playerid)) return checkTroll(playerid);
	OnEnterVehicleTimer[playerid] = GetTickCount();
	if(StartFish[playerid] == 1) {
		if(ispassenger == 1) {
			SCM(playerid, -1, "Actiunea a esuat deoarece te-ai miscat.");
			StartFish[playerid] = 0;
			TogglePlayerControllable(playerid, 1);
			Freezed[playerid] = 0;
			RemovePlayerAttachedObject(playerid, 0);
			return 1;
		}
	}

	if(!ispassenger) {
		new vehicle = GetVehicleID(vehicleid), string[256];
		if(ServerVehicles[vehicle][vID] != 0 && JobWorking[playerid] == 0) {
			if(ServerVehicles[vehicle][vFaction] == 1 || ServerVehicles[vehicle][vFaction] == 2 || ServerVehicles[vehicle][vFaction] == 3 || ServerVehicles[vehicle][vFaction] == 14) {
				if(ServerVehicles[vehicle][vRank] > PlayerInfo[playerid][pRank]) {
		            format(string, sizeof(string), "Ai nevoie de rank %d pentru a lua acest vehicul.", ServerVehicles[vehicle][vRank]);
					SCM(playerid, COLOR_GREY, string);
			        SlapPlayer(playerid);
			    }
				else if(OnDuty[playerid] == 0 && IsACop(playerid)) {
					SCM(playerid, COLOR_LGREEN, "Nu poti folosi vehiculele factiunii daca nu esti la datorie!");
					SlapPlayer(playerid);
					return 1;
				}
				else if(!IsACop(playerid)) {
					format(string, sizeof(string), "Nu faci parte din factiunea %s.", FactionName(ServerVehicles[vehicle][vFaction]));
					SCM(playerid, COLOR_GREY, string);
					SlapPlayer(playerid);
				}
			}
			else if(ServerVehicles[vehicle][vFaction] != PlayerInfo[playerid][pMember] && ServerVehicles[vehicle][vFaction] != 0) {
	            format(string, sizeof(string), "Nu faci parte din factiunea %s.", FactionName(ServerVehicles[vehicle][vFaction]));
				SCM(playerid, COLOR_GREY, string);
				SlapPlayer(playerid);
		    }
		    else {
				if(OnDuty[playerid] == 0 && IsACop(playerid) && Copcar2(vehicle)) {
					SCM(playerid, COLOR_LGREEN, "Nu poti folosi vehiculele factiunii daca nu esti la datorie!");
					SlapPlayer(playerid);
					return 1;
				}
		    }
		}
		if(IsABoat(vehicleid) && GetPVarInt(playerid, "InLesson") == -1) {
		    if(PlayerInfo[playerid][pBoatLic] < 1 && InDealer[playerid] == 0) {
			    SendClientMessage(playerid,COLOR_GREY, "Nu ai licenta de navigatie.");
			    SlapPlayer(playerid);
			    TogglePlayerControllable(playerid, 1);
			}
		}
		else if(IsAPlane(vehicleid) && GetPVarInt(playerid, "InLesson") == -1) {
		    if(PlayerInfo[playerid][pFlyLic] < 1 && InDealer[playerid] == 0) {
			    SendClientMessage(playerid, COLOR_GREY, "Nu ai licenta de zbor.");
			    SlapPlayer(playerid);
				TogglePlayerControllable(playerid, 1);
			}
		}
		else {
			if(PlayerInfo[playerid][pCarLic] < 1) {
			    if(!IsAPlane(vehicleid) || IsABike2(vehicleid) || InExamen[playerid] == 1 || GetVehicleModel(vehicleid) == 471 || InDealer[playerid] > 0) { }
			    else {
				 	SendClientMessage(playerid,COLOR_GREY, "Nu ai licenta de condus.");
	                SlapPlayer(playerid);
	                TogglePlayerControllable(playerid, 1);
					SetTimerEx("UnFreezeStation", 500, 0, "i", playerid);
				}
			}
		}
	}
	return 1;
}



function show_logo(playerid) {
	new string[64];
	format(string, sizeof(string), "%s (%d)", GetName(playerid), playerid);
	PlayerTextDrawSetString(playerid, NameTD, string);
	PlayerTextDrawShow(playerid, NameTD);
	TextDrawShowForPlayer(playerid, inimav1);
	TextDrawShowForPlayer(playerid, LogoTD[0]);
	TextDrawShowForPlayer(playerid, LogoTD[1]);
	TextDrawShowForPlayer(playerid, LogoTD[2]);
	return 1;
}

function DecreaseTimer() {
	new string[256];
	foreach(Player, i) {
		if(IsPlayerLogged[i] == 1) {
			new Float: playerArmour;
			GetPlayerArmour(i, playerArmour);
			if(playerArmour == 100 && PlayerInfo[i][pAdmin] == 0 && GetPVarInt(i, "Armour") == 0) {
				if(ServerSystem[3] == 0) NightBot(i, "Cheats (armour-hack)");
			}
			//if(FPS2[i] == 0 && AFKSeconds[i] > 120 && PlayerInfo[i][pSleeping] == 0) NightBot(i, "rakdroid");
			new Float: playerHealth;
			GetPlayerArmour(i, playerHealth);
			if(playerHealth == 100 && PlayerInfo[i][pAdmin] == 0) {
				if(ServerSystem[8] == 0) NightBot(i, "Cheats (health-hack)");
			}
			// -- Variables
			for(new t = 0; t < 7; t++) {
				if(DeelayCommand[i][t] != 0) {
					DeelayCommand[i][t] -= 5;
					if(DeelayCommand[i][t] < 0) DeelayCommand[i][t] = 0;
				}
			}
			if(PlayerTime[i][0] != 0) PlayerTime[i][0] -= 5;
			if(PlayerTime[i][0] < 0) PlayerTime[i][0] = 0;


			if(PlayerInfo[i][pWantedLevel] && WantedTime[i] == 10) {
				WantedTime[i] = 0; PlayerInfo[i][pWantedLevel] --; UpdateVar(i, "WantedLevel", PlayerInfo[i][pWantedLevel]); SetPlayerWantedLevel(i, PlayerInfo[i][pWantedLevel]);
				if(!PlayerInfo[i][pWantedLevel]) SCM(i, COLOR_YELLOW, "Politia ti-a pierdut urma."), PlayerTextDrawHide(i, WantedTD[i]), ClearCrime(i);
				else SCMf(i, COLOR_YELLOW, "Politia iti pierde urma. Nivel actual: %d.", PlayerInfo[i][pWantedLevel]);

				format(string, sizeof string, "%s [%d] lost one wanted level. W: %d.", GetName(i), i, PlayerInfo[i][pWantedLevel]);
				SendTeamMessage(3, COLOR_DBLUE, string);
				SendTeamMessage(2, COLOR_DBLUE, string);
				SendTeamMessage(1, COLOR_DBLUE, string);
			}

			if(PlayerInfo[i][pReportTime] >= 1) {
				PlayerInfo[i][pReportTime] -= 5;
				if(PlayerInfo[i][pReportTime] < 0) PlayerInfo[i][pReportTime] = 0;
			}
			if(PlayerInfo[i][pNewbieMute] >= 1) {
				PlayerInfo[i][pNewbieMute] -= 5;
				if(PlayerInfo[i][pNewbieMute] < 0) PlayerInfo[i][pNewbieMute] = 0;
			}
			if(FreezeTime[i] != 0) {
				FreezeTime[i] -= 5;
				if(FreezeTime[i] < 0) FreezeTime[i] = 0;
				if(FreezeTime[i] == 0) {
					SCM(i, COLOR_LIGHTBLUE, "Acum nu mai ai freeze!");
					TogglePlayerControllable(i, 1);
				}
			}
		}
	}
	return 1;
}


// function DespawnVehicle(carid) {
	// new dbid = FindSpawnID(carid);
	// if(!IsVehicleOccupied(carid)) {

			if(IsMail(inputtext) && response && strlen(inputtext) < 30) {
				strmid(PlayerInfo[playerid][pEmail], inputtext, 0, strlen(inputtext), 64);
				new str1[100];
				mysql_format(SQL, str1, 100, "UPDATE users SET `Email`='%e' WHERE `id`='%d'",PlayerInfo[playerid][pEmail],PlayerInfo[playerid][pSQLID]);
				mysql_tquery(SQL, str1, "", "");

function LoadDSVeh() {
	dsvehs = cache_num_rows();
	for(new i = 1; i <= dsvehs; i++) {
		new j = i - 1;
		cache_get_value_name_int(j, "ID", DSModels[i][dID]);
		cache_get_value_name_int(j, "Model", DSModels[i][dModel]);
		cache_get_value_name_int(j, "Price", DSModels[i][dPrice]);
		// cache_get_value_name_int(j, "Doors", DSModels[i][dDoors]);
		cache_get_value_name_int(j, "Type", DSModels[i][dType]);
		cache_get_value_name_int(j, "MaxSpeed", DSModels[i][dMaxSpeed]);
		cache_get_value_name_int(j, "Stock", DSModels[i][dStock]);
		cache_get_value_name_int(j, "Gold", DSModels[i][dGold]);
	}
	printf("[MySQL] Dealership models: %d", dsvehs);
}
YCMD:movejob(playerid, params[], help) {
	if(PlayerInfo[playerid][pAdmin] < 6) return 1;
	new job, string[256], query[180], Float: Pos[3];
	if(sscanf(params, "i", job)) return SCM(playerid, COLOR_GREY, "USAGE: {FFFFFF}/movejob <job id>");
	GetPlayerPos(playerid, Pos[0], Pos[1], Pos[2]);
	JobInfo[job][jPosX] = Pos[0];
	JobInfo[job][jPosY] = Pos[1];
	JobInfo[job][jPosZ] = Pos[2];
	DestroyDynamic3DTextLabel(JobInfo[job][jLabel]);
	DestroyDynamicPickup(JobInfo[job][jPickup]);
	format(string, sizeof(string), "{ffffff}ID: {ffd026}%d{FFFFFF}\n{ffffff}Job: {ffd026}%s{FFFFFF}\n\nType {ffd026}/getjob{FFFFFF} to get the job.\nType {ffd026}/quitjob{FFFFFF} to quit job.", job, JobInfo[job][jName], JobInfo[job][jLevel]);
	JobInfo[job][jLabel] = CreateDynamic3DTextLabel(string, 0xFFFFFFFF, JobInfo[job][jPosX], JobInfo[job][jPosY], JobInfo[job][jPosZ], 25, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 1, 0, -1, -1, 100.0);
	JobInfo[job][jPickup] = CreateDynamicPickup(1275, 23, JobInfo[job][jPosX], JobInfo[job][jPosY], JobInfo[job][jPosZ], 0, -1, -1, 100.0);
	format(string, sizeof(string), "Job-ul %d a fost mutat in aceasta locatie.", job);
	SCM(playerid, COLOR_WHITE, string);
	mysql_format(SQL, query, sizeof(query), "UPDATE `jobs` SET `PosX`='%f', `PosY`='%f', `PosZ`='%f' WHERE `ID`='%d'", Pos[0], Pos[1], Pos[2], job);
	mysql_tquery(SQL, query, "", "");
	return 1;
}
YCMD:movehouse(playerid, params[], help) {
	if(PlayerInfo[playerid][pAdmin] < 6) return 1;
	new house;
	if(sscanf(params, "i", house)) return SCM(playerid, COLOR_GREY, "USAGE: {FFFFFF}/movehouse <house id>");
	if(house < 1 || house > housess) return SCM(playerid, COLOR_GREY, "Invalid house!");
	SetPVarInt(playerid, "MoveID", house);
	ShowPlayerDialogEx(playerid, DIALOG_MOVEHOUSE, DIALOG_STYLE_LIST, "Move house", "Interior\nExterior", "Ok", "Exit");
	return 1;
}
YCMD:movebiz(playerid, params[], help) {
	if(PlayerInfo[playerid][pAdmin] < 6) return 1;
	new house;
	if(sscanf(params, "i", house)) return SCM(playerid, COLOR_GREY, "USAGE: {FFFFFF}/movebiz <biz id>");
	if(house < 1 || house > sizeof(BizzInfo)) return SCM(playerid, COLOR_GREY, "Invalid biz!");
	SetPVarInt(playerid, "MoveID", house);
	ShowPlayerDialogEx(playerid, DIALOG_MOVEBIZ, DIALOG_STYLE_LIST, "Move biz", "Interior\nExterior", "Ok", "Exit");
	return 1;
}
function UpdateLabel(update, h) {
	new labelString[300], pret[100];
	if(update == 1) {
	    if(HouseInfo[h][hValue] != 0) format(pret, 100, "\n{FFFFFF}Price: {2a7812}$%s (/buyhouse)", FormatNumber(HouseInfo[h][hValue]));
		if(HouseInfo[h][hOwned] == 0) {
			DestroyDynamic3DTextLabel(HouseLabel[h]);
			DestroyDynamicPickup(HouseInfo[h][hPickupID]);
            HouseInfo[h][hPickupID] = CreateDynamicPickup(1273, 23, HouseInfo[h][hEntrancex], HouseInfo[h][hEntrancey], HouseInfo[h][hEntrancez]);
			format(labelString, sizeof(labelString),"{FFFFFF}House {2a7812}%d \n{FFFFFF}This house is for sale {2a7812}/buyhouse\n {FFFFFF}Description: {2a7812}%s \n{FFFFFF}Price: {2a7812}$%s \n{FFFFFF}Level: {2a7812}%d",h,HouseInfo[h][hDiscription],FormatNumber(HouseInfo[h][hValue]),HouseInfo[h][hLevel]);
			HouseLabel[h] = CreateDynamic3DTextLabel(labelString ,0x09FF00FF,HouseInfo[h][hEntrancex], HouseInfo[h][hEntrancey], HouseInfo[h][hEntrancez],25, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 1, 0, -1, -1, 100.0);
			HouseInfo[h][hZone] = CreateDynamicSphere(HouseInfo[h][hEntrancex], HouseInfo[h][hEntrancey], HouseInfo[h][hEntrancez], 2.0, 0, 0, -1);
            Streamer_SetIntData(STREAMER_TYPE_AREA, HouseInfo[h][hZone], E_STREAMER_EXTRA_ID, h + HOUSE_STREAMER_START);
		}
		else if(HouseInfo[h][hOwned] == 1) {
			if(HouseInfo[h][hRentabil] == 1) {
				DestroyDynamic3DTextLabel(HouseLabel[h]);
				format(labelString, sizeof(labelString),"{2a7812}%s{FFFFFF}\nHouse {2a7812}%d \n{FFFFFF}Owner: {2a7812}%s \n{FFFFFF}Rent: {2a7812}$%s (/rentroom) \n{FFFFFF}Level: {2a7812}%d%s",HouseInfo[h][hDiscription],h,HouseInfo[h][hOwner],FormatNumber(HouseInfo[h][hRent]),HouseInfo[h][hLevel],pret);
				HouseLabel[h] = CreateDynamic3DTextLabel(labelString ,0x09FF00FF,HouseInfo[h][hEntrancex], HouseInfo[h][hEntrancey], HouseInfo[h][hEntrancez],25, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 1, 0, -1, -1, 100.0);
			}
			else {
				DestroyDynamic3DTextLabel(HouseLabel[h]);
				format(labelString, sizeof(labelString),"{2a7812}%s{FFFFFF}\nHouse {2a7812}%d \n{FFFFFF}Owner: {2a7812}%s \n{FFFFFF}Level: {2a7812}%d%s",HouseInfo[h][hDiscription],h,HouseInfo[h][hOwner], HouseInfo[h][hLevel],pret);
				HouseLabel[h] = CreateDynamic3DTextLabel(labelString ,0x09FF00FF,HouseInfo[h][hEntrancex], HouseInfo[h][hEntrancey], HouseInfo[h][hEntrancez],25, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 1, 0, -1, -1, 100.0);
			}
			DestroyDynamicPickup(HouseInfo[h][hPickupID]);
            HouseInfo[h][hPickupID] = CreateDynamicPickup(1272, 23, HouseInfo[h][hEntrancex], HouseInfo[h][hEntrancey], HouseInfo[h][hEntrancez]);
            HouseInfo[h][hZone] = CreateDynamicSphere(HouseInfo[h][hEntrancex], HouseInfo[h][hEntrancey], HouseInfo[h][hEntrancez], 2.0, 0, 0, -1);
            Streamer_SetIntData(STREAMER_TYPE_AREA, HouseInfo[h][hZone], E_STREAMER_EXTRA_ID, h + HOUSE_STREAMER_START);
		}
	}
	else if(update == 2) {
	    if(BizzInfo[h][bBuyPrice] != 0) format(pret, 100, "\n{FFFFFF}Price: {2c66b8}$%s (/buybiz)", FormatNumber(BizzInfo[h][bBuyPrice]));
		if(BizzInfo[h][bOwned] == 0) {
			DestroyDynamic3DTextLabel(BizzLabel[h]);
			format(labelString, sizeof(labelString),"{2c66b8}%s{FFFFFF}\n{FFFFFF}Business {2c66b8}#%d\n{FFFFFF}This business is for sale {2c66b8}/buybiz\n {FFFFFF}Price: {2c66b8}%s \n{FFFFFF}Level: {2c66b8}%d",BizzInfo[h][bMessage],h,FormatNumber(BizzInfo[h][bBuyPrice]),BizzInfo[h][bLevel]);
			BizzLabel[h] = CreateDynamic3DTextLabel(labelString ,0x0066FF44,BizzInfo[h][bEntranceX], BizzInfo[h][bEntranceY], BizzInfo[h][bEntranceZ],25, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 1, 0, -1, -1, 100.0);
		}
		else if(BizzInfo[h][bOwned] == 1) {
			DestroyDynamic3DTextLabel(BizzLabel[h]);
			format(labelString, sizeof(labelString),"{2c66b8}%s{FFFFFF}\n{FFFFFF}Business {2c66b8}#%d\n{FFFFFF}Owner: {2c66b8}%s \n{FFFFFF}Fee: {2c66b8}$%s\n{FFFFFF}Level:{2c66b8} %d%s",BizzInfo[h][bMessage],h,BizzInfo[h][bOwner],FormatNumber(BizzInfo[h][bFee]),BizzInfo[h][bLevel],pret);
			BizzLabel[h] = CreateDynamic3DTextLabel(labelString ,0x0066FF44,BizzInfo[h][bEntranceX], BizzInfo[h][bEntranceY], BizzInfo[h][bEntranceZ],25, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 1, 0, -1, -1, 100.0);
		}
	}
	return 1;
}

public OnPlayerEnterDynamicArea(playerid, areaid)
{
	new ar = areaid - 369;
	if(ar > 0 && ar < MAX_TURFS) {
		inTurf[playerid] = ar;
		return 1;
	}
	new houseid = Streamer_GetIntData(STREAMER_TYPE_AREA, areaid, E_STREAMER_EXTRA_ID) - HOUSE_STREAMER_START;
   	/*if(areaid==area1) {
    for(new m; m < 2; m++) {
        if(PlayerInfo[playerid][pDailyMission][m] == 4) CheckMission(playerid, m);
        }
    }
	if(areaid==area2) {
	for(new m; m < 2; m++) {
		if(PlayerInfo[playerid][pDailyMission][m] == 5) CheckMission(playerid, m);
		}
	}
	if(areaid==area3) {
	for(new m; m < 2; m++) {
		if(PlayerInfo[playerid][pDailyMission][m] == 6) CheckMission(playerid, m);
		}
	}*/
	if(areaid==area4) {
		if(PlayerInfo[playerid][pPet] == 1) {
			if(PlayerInfo[playerid][pPMissions][1] != 1) {
			GameTextForPlayer(playerid, "~y~Mission Completed!", 5000, 0);
			PlayerInfo[playerid][pPetPoints] += 10;
			new petx = 100 + random(100);
			PlayerInfo[playerid][pPetXp] += petx;
			GivePlayerCash(playerid, 10000);
  			PlayerInfo[playerid][pPMissions][1] = 1;
			SCMEx(playerid, COLOR_JOB, "(Pet Quest): {ffffff}Ai colectat acest premiu, drept rasplata ai primit 10 Pet Points, %d Pet Xp si 10,000$.", petx);
  			Update(playerid, pPetPointsx);
			Update(playerid, pPetXpx);
			Update(playerid, pPMissionsx);
			}
		}
	}

	if(houseid > 0 && Iter_Contains(choosenHouses, houseid))
	{
		nearHouse[playerid] = houseid;
		return true;
	}

	return true;
}

public OnPlayerLeaveDynamicArea(playerid, areaid)
{
	new ar = areaid - 369;
	if(ar > 0 && ar < MAX_TURFS) {
		inTurf[playerid] = 0;
		return 1;
	}

	new houseid = Streamer_GetIntData(STREAMER_TYPE_AREA, areaid, E_STREAMER_EXTRA_ID) - HOUSE_STREAMER_START;

	if(houseid > 0 && Iter_Contains(choosenHouses, houseid) && nearHouse[playerid] != -1)
	{
		nearHouse[playerid] = -1;
		return true;
	}

	return true;
}

stock DecimalNumber(playerid) {
    new str[30];
    new money=PlayerInfo[playerid][pPhone];
    if(money >= 0) {
        format(str, sizeof(str), "%d", money);
        if(1000000 <= money < 10000000) strins(str, "-", 3, sizeof(str));
    }
    return str;
}

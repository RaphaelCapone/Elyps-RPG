				}
			if(JobWorking2[playerid] == 1) {
				JobWorking2[playerid] = 0;
				DestroyVehicle(FarmerCar[playerid]);
				if(Iter_Contains(WorkingPlayers[j], playerid)) Iter_Remove(WorkingPlayers[j], playerid);
			}
			if(JobWorking3[playerid] == 1) {
				JobWorking3[playerid] = 0;
				DestroyVehicle(PizzaCar[playerid]);
				if(Iter_Contains(WorkingPlayers[j], playerid)) Iter_Remove(WorkingPlayers[j], playerid);
			}
			if(JobWorking4[playerid] == 1) {
				JobWorking4[playerid] = 0;
				DestroyVehicle(DrugsCar[playerid]);
		 		if(Iter_Contains(WorkingPlayers[j], playerid)) Iter_Remove(WorkingPlayers[j], playerid);
			}
			JobLeftTime[playerid] = 0;
	    }
		case DIALOG_TOG: {
			if(!response) return 1;
			switch(listitem) {
			    case 0: {
			        if(NewbieChat[playerid] == 0) {
			            if(PlayerInfo[playerid][pHelper] >= 1) return SCM(playerid, COLOR_GREY, "Nu poti dezactiva deoarece esti helper.");
						NewbieChat[playerid] = 1;
					}
					else NewbieChat[playerid] = 0;
					UpdateVar(playerid, "NewbieChat", NewbieChat[playerid]);
			    }
			    case 1: {

/* INCEPUT GAMEMODE */
#include <systemsB>

/* LNX WAR */
#include "../modules/lnxWar.pwn"
#include "../modules/lnxPersVeh.pwn"

main() { }

public OnGameModeExit() {
	mysql_close();
    DestroyActor(Actordrugs);
 	DestroyActor(ActorQuest1);
    return 1;
}
public OnGameModeInit() {

	Actordrugs = CreateActor(70, 2351.4509, -648.2256, 127.9859, 90.0);

	ActorQuest1 = CreateActor(37, -1479.0762,-212.7925,14.1484, 350.0);
	HambarKG = 0;

	/* Iterators */
	Iter_Init(ClanPlayers);
	Iter_Init(FactionPlayers);
	Iter_Init(factionVehicles);
	Iter_Init(inWarPlayers);
	Iter_Init(WorkingPlayers);
	Iter_Init(inRangePlayers);
	Iter_Init(personalCars);


	for(new x = 0, i = sizeof legendarySkins; x < i; x ++) Iter_Add(legendarSkins, legendarySkins[x]);
	mysql_log(ERROR | INFO);

	// SQL = mysql_connect("193.203.39.73", "hc85samp80", "95b96Sb0hklHfpCn", "hc85samp80"), print("Server: Conexiunea cu baza de date a fost facuta su succes!");
	//SQL = mysql_connect("localhost", "root", "", "test"), print("Conexiunea cu baza de date a fost facuta su succes!");

	new Year, Month, Day, Hour, Minute, Second;
	getdate(Year, Month, Day);
	gettime(Hour, Minute, Second);
	format(StartDate, sizeof(StartDate), "%02d/%02d/%d %02d:%02d:%02d", Day, Month, Year, Hour, Minute+4, Second);

	mysql_tquery(SQL, "SELECT * FROM `turfs` ORDER BY `turfs`.`ID` ASC", "LoadTurfs", "");
	mysql_tquery(SQL, "SELECT * FROM `svehicles` ORDER BY `svehicles`.`vID` ASC", "LoadSVehicles", "");
	mysql_tquery(SQL, "SELECT * FROM `dsveh`", "LoadDSVeh", "");
	mysql_tquery(SQL, "SELECT * FROM `safezones` ORDER BY `safezones`.`ID` ASC", "LoadSafeZones", ""),
	mysql_tquery(SQL, "SELECT * FROM `houses` ORDER BY `houses`.`ID` ASC", "LoadProperty", "");
	mysql_tquery(SQL, "SELECT * FROM `clans` ORDER BY `clans`.`ID` ASC", "LoadClans", "");
	mysql_tquery(SQL, "SELECT * FROM `graffiti` ORDER BY `graffiti`.`ID` ASC", "LoadGraffiti", "");
    mysql_tquery(SQL, "SELECT * FROM `bizz` ORDER BY `bizz`.`ID` ASC", "LoadBizz", "");
    mysql_tquery(SQL, "SELECT * FROM `factions` ORDER BY `factions`.`ID` ASC", "LoadFactions", "");
 	mysql_tquery(SQL, "SELECT * FROM `jobs` ORDER BY `jobs`.`ID` ASC", "LoadJobs", "");
	mysql_tquery(SQL, "SELECT * FROM `fobjects` ORDER BY `fobjects`.`ID` ASC", "LoadFurnitures", "");
	mysql_tquery(SQL, "SELECT * FROM `seif`", "LoadSafes", "");

	LoadVehicles();
	LoadPickups();
 	loadCommands();
	LoadGates();
	LoadIcons();
	LoadMaps();
	LoadZones();
	LoadTDs();

	skinlist = LoadModelSelectionMenu("skins.txt");
	hats = LoadModelSelectionMenu("hats.txt");
	furnitures = LoadModelSelectionMenu("furnitures.txt");
	glasses = LoadModelSelectionMenu("glasses.txt");
	fskins[0] = LoadModelSelectionMenu("f1.txt");
	fskins[1] = LoadModelSelectionMenu("f2.txt");
	fskins[2] = LoadModelSelectionMenu("f3.txt");
	fskins[3] = LoadModelSelectionMenu("f4.txt");
	fskins[4] = LoadModelSelectionMenu("f5.txt");
	fskins[5] = LoadModelSelectionMenu("f6.txt");
	fskins[6] = LoadModelSelectionMenu("f7.txt");
	fskins[7] = LoadModelSelectionMenu("f8.txt");
	fskins[8] = LoadModelSelectionMenu("f9.txt");
	fskins[9] = LoadModelSelectionMenu("f10.txt");
	fskins[10] = LoadModelSelectionMenu("f11.txt");
	fskins[11] = LoadModelSelectionMenu("f12.txt");
	fskins[12] = LoadModelSelectionMenu("f13.txt");
	fskins[13] = LoadModelSelectionMenu("f14.txt");
	fskins[14] = LoadModelSelectionMenu("f1.txt");
	fskins[15] = LoadModelSelectionMenu("f16.txt");
	fskins[16] = LoadModelSelectionMenu("f17.txt");

	for(new i = 0; i <= sizeof(Peds)-1; i++) AddPlayerClass(Peds[i][0],1958.3783,1343.1572,1100.3746,269.1425,-1,-1,-1,-1,-1,-1);
	// for(new c=0;c<CAR_AMOUNT;c++) Gas[c] = GasMax;


	if(realtime) {
		new tmphour, tmpminute, tmpsecond;
		gettime(tmphour, tmpminute, tmpsecond);
		FixHour(tmphour);
		tmphour = shifthour;
		new worldt = tmphour+1;
		SetWorldTimeEx(worldt);
	}

	SetTimer("SyncUp", 60000, 1);
	SetTimer("PayDay", 3000, 1);
	SyncUp();
	SetTimer("DecreaseTimer", 5000, 1);
	// SetTimer("LocalTimer", 1000, 1);
	SetTimer("HelperQuestions", 10000, true);
	SetTimer("CarCheck", 45000, 1);
	SetTimer("Production", 300000, 1);
	SetTimer("CheckGas", RunOutTime, 1);
	SetTimer("StoppedVehicle", RunOutTime, 1);
 	SetWeather(0);

	gettime(ghour, gminute, gsecond);
	FixHour(ghour);
	ghour = shifthour;
	if(!realtime) SetWorldTimeEx(wotime);
    DisableInteriorEnterExits();
	AllowInteriorWeapons(1);
	UsePlayerPedAnims();
	EnableStuntBonusForAll(0);
	ShowPlayerMarkers(2);
	ManualVehicleEngineAndLights();

	SetGameModeText("CROWLAND, "SERVER_VERSION"");
	SendRconCommand("hostname "SERVER_NAME"");
	timer_queue_login = Timer:-1;
	return 1;
}


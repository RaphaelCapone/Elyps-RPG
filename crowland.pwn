					if(!IsPlayerInRangeOfPoint(playerid, 100.0, HouseInfo[house][hExitx],HouseInfo[house][hExity],HouseInfo[house][hExitz])) return SCM(playerid, COLOR_GREY, "Nu esti in casa ta!");
					GivePlayerCash(playerid, suma);
					HouseInfo[house][hTakings] -= suma;
					format(string, sizeof(string), "Ai scos $%s din depozit. Acum mai ai: $%s", FormatNumber(suma),FormatNumber(HouseInfo[house][hTakings]));
					SCM(playerid, COLOR_MONEY, string);

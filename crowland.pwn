			switch(listitem) {
				case 0: SetPlayerCheckpointEx(playerid,1553.7878,-1675.6650,16.1953,4.0);
				case 1: SetPlayerCheckpointEx(playerid,627.6360,-571.5997,17.6144,4.0);
				case 2: SetPlayerCheckpointEx(playerid,95.1936,1920.5802,18.0986,4.0);

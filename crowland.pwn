	return string;
}

stock ticketValue(id) {
	new x;
	switch(id) {
		case 0: x = 50000;
		case 1: x = 50000;
		case 2: x = 50000;
		case 3: x = 50000;
		case 4: x = 50000;
		case 5: x = 50000;
		case 6: x = 50000;
		case 7: x = 50000;
		case 8: x = 50000;
	}
	return x;
}

stock dialogTextCheck(inputtext[]) {
    if(strfind(inputtext, "%", true) != -1 || strfind(inputtext, "`", true) != -1 || strfind(inputtext, "'", true) != -1 || strfind(inputtext, "#", true) != -1) return 0;
    return 1;
}


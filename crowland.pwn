function IsAttached(vehid) {
	foreach(Player, i) {
		if(IsPlayerLogged[i] == 1) {
			if(GetVehicleTrailer(GetPlayerVehicleID(i)) == vehid && vehid != 0) return 1;
		}
	}
	return 0;
}

function UpdateJobStats(playerid) {
	new i = playerid, string[300];
	if(JobWorking[i] == 1 && PlayerInfo[i][pShowJob] == 1 && PlayerInfo[i][pShowHud] == 0) {
		switch(PlayerInfo[i][pJob]) {
			case 1: {
				format(string, sizeof(string), "Ai skill %d si ai muncit de %d ori.~n~Mai trebuie sa muncesti inca %d secunde.", GetPlayerSkill(i), PlayerInfo[i][pFarmerSkill], JobSeconds[i]);
				PlayerTextDrawSetString(i, JobTD, string);
				PlayerTextDrawShow(i, JobTD);
			}
  			case 3: {
				format(string, sizeof(string), "Ai skill %d si ai muncit de %d ori.", GetPlayerSkill(i), PlayerInfo[i][pPizzaSkill]);
				PlayerTextDrawSetString(i, JobTD, string);
				PlayerTextDrawShow(i, JobTD);
			}
			case 4: {
				new szZone[180], category = GetPVarInt(playerid, "Category"), result[64];
				switch(category) {
					case 0: result = "Los Santos";
					case 1: result = "Las Venturas";
					case 2: result = "San Fierro";
				}
				GetPlayer3DZone2(CheckpointPos[playerid][0], CheckpointPos[playerid][1], CheckpointPos[playerid][2], szZone, sizeof(szZone));
				format(string, sizeof(string), "Locatie primita: %s (%s)~n~Ai skill %d si ai muncit de %d ori.~n~Curse facute %d, bani castigati $%s.",szZone, result, GetPlayerSkill(i), PlayerInfo[i][pTruckerSkill], CurseFacute[i], FormatNumber(MoneyEarned[i]));
				PlayerTextDrawSetString(i, JobTD, string);
				PlayerTextDrawShow(i, JobTD);
			}
			case 8: {
				format(string, sizeof(string), "Ai skill %d si ai muncit de %d ori.~n~Mai trebuie sa muncesti inca %d secunde.", GetPlayerSkill(i), PlayerInfo[i][pFarmerSkill], JobSeconds[i]);
				PlayerTextDrawSetString(i, JobTD, string);
				PlayerTextDrawShow(i, JobTD);
			}
		}
	}
	return 1;
}
function LoginTimer(playerid) {
	SCM(playerid, COLOR_CLIENT, "(Server): {ffffff}Ai primit kick deoarece nu ti-ai introdus parola in 30 de secunde!");
	KickEx(playerid);
	return 1;
}

function SetPlayerCriminal(playerid, declare,reason[]) {
	PlayerInfo[playerid][pCrimes] += 1;
	Update(playerid,pCrimesx);
	new turned[MAX_PLAYER_NAME],turner[MAX_PLAYER_NAME], wantedmes[128], ini;
	ini = PlayerInfo[playerid][pWantedLevel];
	GetPlayerName(playerid, turned, sizeof(turned));
	if(declare == 255) {
		format(turner, sizeof(turner), "Unknown");
		strmid(PlayerInfo[playerid][pVictim], turner, 0, strlen(turner), 255);
		Update(playerid,pVictimx);
	}
	else {
		if(IsPlayerConnected(declare)) {
			GetPlayerName(declare, turner, sizeof(turner));
			strmid(PlayerInfo[playerid][pVictim], turner, 0, strlen(turner), 255);
			Update(playerid,pVictimx);
		}
	}
	new string[184];
	if(strcmp(PlayerInfo[playerid][pCrime1], "Fara Crima", true) == 0) {
		format(string, sizeof(string), "%s - reporter: %s",reason,turner);
		strmid(PlayerInfo[playerid][pCrime1], string, 0, strlen(string), 255);
		Update(playerid,pCrime1x);
	}
	else if(strcmp(PlayerInfo[playerid][pCrime2], "Fara Crima", true) == 0) {
		format(string, sizeof(string), "%s - reporter: %s",reason,turner);
		strmid(PlayerInfo[playerid][pCrime2], string, 0, strlen(string), 255);
		Update(playerid,pCrime2x);
	}
	else if(strcmp(PlayerInfo[playerid][pCrime3], "Fara Crima", true) == 0) {
		format(string, sizeof(string), "%s - reporter: %s",reason,turner);
		strmid(PlayerInfo[playerid][pCrime3], string, 0, strlen(string), 255);
		Update(playerid,pCrime3x);
	}
	else if(strcmp(PlayerInfo[playerid][pCrime1],  "Fara Crima", true) == 0 && strcmp(PlayerInfo[playerid][pCrime2], "Fara Crima", true) == 0 && strcmp(PlayerInfo[playerid][pCrime3], "Fara Crima", true) == 0) { }
	else {
		format(string, sizeof(string), "%s - reporter: %s",reason,turner);
		strmid(PlayerInfo[playerid][pCrime1], string, 0, strlen(string), 255);

		strmid(PlayerInfo[playerid][pCrime2], "Fara Crima", 0, 11, 255);
		strmid(PlayerInfo[playerid][pCrime3], "Fara Crima", 0, 11, 255);

		new q[125];
		mysql_format(SQL, q, 125, "UPDATE `users` SET `Crime1`='%s', `Crime2`='Fara Crima', `Crime3`='Fara Crima' WHERE `ID`='%d'",
		PlayerInfo[playerid][pCrime1], PlayerInfo[playerid][pSQLID]);
		mysql_tquery(SQL, q, "", "");
	}
	WantedTime[playerid] = 0;
	Update(playerid,pWantedLevelx);


	format(wantedmes, sizeof(wantedmes), "Ai comis o noua crima (%s), raportata de %s. Wanted actual: %d.", reason,turner,PlayerInfo[playerid][pWantedLevel]);
	SCM(playerid, COLOR_WARNING, wantedmes);
	ini = PlayerInfo[playerid][pWantedLevel]-ini;
	SetPlayerWantedLevel(playerid, PlayerInfo[playerid][pWantedLevel]);
	foreach(Player,i) {
		if(IsPlayerLogged[i] == 1) {
			if(IsACop(i) && OnDuty[i] == 1) {
				if(GetDistanceBetweenPlayers(i, playerid) < 250) {
					OnPlayerStreamOut(i, playerid);
					OnPlayerStreamIn(i, playerid);
				}
				format(cbjstore, sizeof(cbjstore), "Dispatch: %s [%d] has commited a crime: %s. Reporter: %s. New wanted level: %d.",GetName(playerid),playerid,reason,turner,PlayerInfo[playerid][pWantedLevel]);
				SCM(i, 0x2e64feFF, cbjstore);
			}
		}
	}
	return 1;
}

function SetPlayerFree(playerid, declare,reason[]) {
	ClearCrime(playerid);
	return 1;
}

function DeelayTime(playerid, id) {
	new string[64];
	format(string, sizeof(string), "Asteapta %d secunde!", DeelayCommand[playerid][id]);
	SCM(playerid, -1, string);
	return 1;
}
function nearPNS(playerid) {
	new const Float:paynspray[][] = {
		{1025.05, -1024.23, 32.1}, // LS Temple
		{487.68, -1740.87, 11.13}, // LS Santa Maria
		{-1420.73, 2583.37, 55.56}, // El Quebrados
		{-1904.39, 284.97, 40.75}, // Wang Cars
		{-2425.91, 1022.33, 50.10}, // Juniper Hill
		{1975.60, 2162.16, 10.77}, // LV Redsands
		{2065.38, -1831.51, 13.25}, // Idlewood
		{-99.55, 1118.36, 19.44}, // Fort Carson
		{721.07, -455.94, 16.04}, // Dillimore
		{2393.74, 1493.01, 10.52} // LV Unused (Pyramid)
	};
	for(new i=0; i<sizeof(paynspray); i++) {
		if(IsPlayerInRangeOfPoint(playerid, 20, paynspray[i][0], paynspray[i][1], paynspray[i][2])) return 1;
	}
	return 0;
}
function nearPNS2(playerid) {
	new const Float:paynspray[][] = {
		{1025.05, -1024.23, 32.1}, // LS Temple
		{487.68, -1740.87, 11.13}, // LS Santa Maria
		{-1420.73, 2583.37, 55.56}, // El Quebrados
		{-1904.39, 284.97, 40.75}, // Wang Cars
		{-2425.91, 1022.33, 50.10}, // Juniper Hill
		{1975.60, 2162.16, 10.77}, // LV Redsands
		{2065.38, -1831.51, 13.25}, // Idlewood
		{-99.55, 1118.36, 19.44}, // Fort Carson
		{721.07, -455.94, 16.04}, // Dillimore
		{2393.74, 1493.01, 10.52} // LV Unused (Pyramid)
	};
	for(new i=0; i<sizeof(paynspray); i++) {
		if(IsPlayerInRangeOfPoint(playerid, 50, paynspray[i][0], paynspray[i][1], paynspray[i][2])) return 1;
	}
	return 0;
}

task LocalTimer[1000]() {
	new string[200];//, query[200];
	// licitatii automate
	new year, month, day;
	getdate(year, month, day);
	new days[180];
	format(days, sizeof(days), GetWeekDay(day, month, year));
	new hour,minute,second;
	gettime(hour,minute,second);

	if(gettime() >= randomMessages) {
		va_SendClientMessageToAll(0x0b8a3cFF, "%s", RandomMSG[random(sizeof RandomMSG)]);
		randomMessages = gettime() + 600;
	}

	for(new i = 0; i < MAX_WARS; i ++) {
		if(WarsStatistics[i][wTurfid] > 0) {
			if(WarsStatistics[i][wTime] > 1) WarsStatistics[i][wTime] --, UpdateWarText(i);
			else if(WarsStatistics[i][wTime] == 1) StopWar(i);
		}
	}


	if(strcmp(days,"Monday",true) == 0 && hour == 00 && second == 0) {
		mysql_tquery(SQL, "UPDATE `users` SET `HelpedPlayersToday`='0' WHERE `Admin`>='1'", "", "");
		foreach(PlayerAdmins, i) PlayerInfo[i][pHelpedPlayersToday] = 0;
	}
	// War deelay
	// for(new i = 0; i < 18; i++) {
		// if(FactionDeelay[i] >= 1) {
			// FactionDeelay[i] --;
			// if(FactionDeelay[i] == 0) {
				// SendFactionMessage(i, COLOR_MONEY, "[WAR] Acum mafia ta poate ataca un teritoriu!");
			// }
		// }
	// }

	// Paintball arena
	if(painttime > 0) painttime--;
	for(new i = 0; i < 3; i++) {
		if(PaintText[i] != 0) {
			PaintText[i] --;
			if(PaintText[i] == 0) format(string, sizeof(string), "~w~Runda a inceput~n~Succes tuturor!");
			else format(string, sizeof(string), "~w~Runda incepe in ~n~~b~%d secunde", PaintText[i]);
			GameTextForPaint(string, i);
		}

		if(PlayersOnPaint(i) >= 2 && PaintTime[i] >= 1) {
			PaintTime[i] --;
			if(PaintTime[i] == 0) {
				SendPaintMessage(i + 1, COLOR_YELLOW, "Runda va incepe peste un minut. Pentru a vota o mapa, folositi comanda /votemap.");
				PaintVote[i] = 1;
				PaintText[i] = 60;
				if(PaintTimer[i] != 0) KillTimer(PaintTimer[i]), PaintTimer[i] = 0;
				PaintTimer[i] = SetTimerEx("CalculateVote", 60000, 0, "i", i);
			}
		}
	}


	return 1;
}

ptask OneSecondTimer[1000](playerid) {
	new string[255], Float: ppHealth, Float: ppArmour,
	Float: animposX, Float: animposY, Float: animposZ;

	new v = GetPlayerVehicleID(playerid);

	new job = PlayerInfo[playerid][pJob];
	if(job > 0 && Iter_Contains(WorkingPlayers[job], playerid)) {
		if(JobLeftTime[playerid] > 0) {
			JobLeftTime[playerid] --;
			if(JobLeftTime[playerid] == 30) SCM(playerid, COLOR_YELLOW, "Mai ai la dispozitie 30 de secunde sa intri in vehiculul de la job.");
			if(JobLeftTime[playerid] == 0) {
				SendClientMessage(playerid, COLOR_WHITE, "Job esuat deoarece ai parasit vehiculul.");
				if(playerObject[playerid] != 0) DestroyPlayerObject(playerid, playerObject[playerid]), playerObject[playerid] = 0;
				if(playerObject2[playerid] != 0) DestroyObject(playerObject2[playerid]), playerObject2[playerid] = 0;
				PlayerTextDrawHide(playerid, JobTD);

				if(JobWorking[playerid] == 1) {
					JobWorking[playerid] = 0, PlayerTextDrawHide(playerid, JobTD);
					if(JobVehicle[playerid] != 0) DestroyVehicle(JobVehicle[playerid]), JobVehicle[playerid] = 0;
					RemovePlayerAttachedObject(playerid, 2);
				}
				if(JobWorking2[playerid] == 1) JobWorking2[playerid] = 0, DestroyVehicle(FarmerCar[playerid]);
				if(JobWorking3[playerid] == 1) JobWorking3[playerid] = 0, DestroyVehicle(PizzaCar[playerid]);
				if(JobWorking4[playerid] == 1) JobWorking4[playerid] = 0, DestroyVehicle(DrugsCar[playerid]);

				PlayerTextDrawHide(playerid, InfosTD);
				SetPlayerSpecialAction(playerid, 0);
				DisablePlayerCheckpointEx(playerid);
				DisablePlayerRaceCheckpointEx(playerid);
				RemovePlayerAttachedObject(playerid, 6);
				RemovePlayerAttachedObject(playerid, 2);
				RemovePlayerAttachedObject(playerid, 5);
				RemovePlayerAttachedObject(playerid, 4);
				CP[playerid] = 0;
			}
		}
	}

	if(TutorialActive[playerid] == 1) TutorialSeconds[playerid] ++;
	if(TutorialSeconds[playerid] == 18 && TutorialActive[playerid] == 1) {
		TutorialStep[playerid] ++;
		TutorialSeconds[playerid] = 0;
		switch(TutorialStep[playerid]) {
			case 1: {
				PlayAudioStreamForPlayer(playerid, "http://crowland.ro/gta.mp3");
				TogglePlayerSpectating(playerid, 1);
				for( new j = 0; j <= 50; j++) SCM(playerid, COLOR_WHITE, "");
				SetPlayerVirtualWorld(playerid, playerid+1);
				PlayerTextDrawHide(playerid, NameTD);
				SCM(playerid, -1, "");
				SCM(playerid, -1, "");
				SCM(playerid, -1, "");
				SCM(playerid, -1, "Bine ai venit pe comunitatea Crowland Romania.");
				SCM(playerid, -1, "Pentru inceput, te voi pune la cunostinta cu cateva elemente de baza ale server-ului.");
				SCM(playerid, -1, "Serverul a fost deschis pe data de 25 decembrie 2019.");
				format(string, sizeof(string), "In acest monent sunt %d jucatori conectati pe server.", GetPlayers());
				SCM(playerid, -1, string);
				GameTextForPlayer(playerid, "~y~Step 1/4", 3000, 1);
				SCM(playerid, -1, "");
				SCM(playerid, -1, "");
				SCM(playerid, -1, "");
				InterpolateCameraPos(playerid, 1472.1837,-1708.2125,50.1766, 1479.9830,-1728.6099,31.2060, 15000);
				InterpolateCameraLookAt(playerid, 1481.9883,-1750.6371,19.9841, 1481.9883,-1750.6371,19.9841, 15000);
				SetPlayerPosEx(playerid, 1495.4962,-1675.3988,14.0469);
			} case 2: {
				SCM(playerid, -1, "");
				SCM(playerid, -1, "");
				SCM(playerid, -1, "");
				SCM(playerid, -1, "Pentru inceput mergi la DMV pentru a obtine licenta de condus.");
				SCM(playerid, -1, "In momentul in care ai ajuns in acest loc foloseste /exam pentru a incepe testul.");
				SCM(playerid, -1, "Licenta de condus este valabila 100 de ore. ");
				GameTextForPlayer(playerid, "~y~Step 2/4", 3000, 1);
				SCM(playerid, -1, "");
				SCM(playerid, -1, "");
				SCM(playerid, -1, "");
				InterpolateCameraPos(playerid, 1291.6610,-1849.8837,48.5104, 1249.2067,-1827.5364,34.2480, 15000);
				InterpolateCameraLookAt(playerid, 1227.1337,-1815.3690,23.6798, 1227.1337,-1815.3690,23.6798, 15000);
				SetPlayerPosEx(playerid, 1219.0159,-1817.6760,13.6001);
			} case 3: {
				SCM(playerid, -1, "");
				SCM(playerid, -1, "");
				SCM(playerid, -1, "");
				SCM(playerid, -1, "Aici se afla o afacere de tip 24/7.");
				SCM(playerid, -1, "Din aceasta afacere iti poti cumpara diverse articole de care o sa ai nevoie, de exemplu:");
				SCM(playerid, -1, "- Telefon, Canistra, Frecventa, Tigari, Bricheta, Carte De Telefon.");
  				GameTextForPlayer(playerid, "~y~Step 3/4", 3000, 1);
				SCM(playerid, -1, "");
				SCM(playerid, -1, "");
				InterpolateCameraPos(playerid, 1807.5985,-1823.6249,19.9175, 1819.0737,-1831.2230,19.1525, 15000);
				InterpolateCameraLookAt(playerid, 1833.5641,-1842.4852,13.5781, 1833.5641,-1842.4852,13.5781, 15000);
				SetPlayerPosEx(playerid, 1832.9548,-1820.2684,3.9844);
			} case 4: {
				SetPlayerVirtualWorld(playerid, 0);
				SCM(playerid, -1, "");
				SCM(playerid, -1, "");
				SCM(playerid, -1, "");
				SCM(playerid, -1, "Poti incepe sa faci bani la unul dintre joburi.");
				SCM(playerid, -1, "In acest moment sunt 8 job-uri disponibile.");
				SCM(playerid, -1, "Pentru inceput iti recomandam jobul Farmer.");
				GameTextForPlayer(playerid, "~y~Step 4/4", 3000, 1);
				SCM(playerid, -1, "");
				SCM(playerid, -1, "");
				InterpolateCameraPos(playerid, -1071.7374,-986.4103,150.3623, -1043.6503,-1017.9812,140.9347, 15000);
				InterpolateCameraLookAt(playerid, -1029.5078,-1038.9080,129.7301, -1029.5078,-1038.9080,129.7301, 15000);
				SetPlayerPosEx(playerid, -1023.3702,-1046.2030,129.2188);
			} case 5: {
				StopAudioStreamForPlayer(playerid);
				ServerAccounts ++;
				format(string, sizeof string, "%s[%d] has been registered on the server. [#%d].", GetName(playerid), playerid, PlayerInfo[playerid][pSQLID]);
				SendAdminMessage(COLOR_LIGHTRED, string, 1);
				clearChat(playerid, 50);
				SCM(playerid, COLOR_YELLOW, "Te-ai inregistrat cu succes!");
				SCM(playerid, COLOR_YELLOW, "Iti multumim ca ai ales aceasta comunitate.");
				ResetPlayerCash(playerid); PlayerInfo[playerid][pAccount] = 200000, Cash[playerid] = 200000, PlayerInfo[playerid][pLevel] = 1;
				TutTime[playerid] = 0; PlayerInfo[playerid][pTut] = 1; gOoc[playerid] = 0; gNews[playerid] = 0; gFam[playerid] = 0;
				PlayerInfo[playerid][pCarLicS] = 0;
				TutorialActive[playerid] = 0;

				new str[150];
				mysql_format(SQL, str, 150, "UPDATE users SET `CarLicS`='0',`Tutorial`='1',`Bank`='20000',`Money`='200000' WHERE `ID`='%d'",PlayerInfo[playerid][pSQLID]);
				mysql_tquery(SQL, str, "", "");
				TogglePlayerControllable(playerid, true), TogglePlayerSpectating(playerid, false), SetCameraBehindPlayer(playerid), SpawnPlayer(playerid);
			}
		}
	}
	if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER && GetPlayerInterior(playerid) == 0) {
		if(!nearPNS(playerid) && VehicleExist[v] == 1 && PlayerInfo[playerid][pAdmin]) {
			new Float: vhp; GetVehicleHealth(v, vhp);
			if(vhp == 1000) RemovePlayerFromVehicle(playerid);
		}
		if(!nearPNS2(playerid) && NearPNS[playerid] == 1) DisableRemoteVehicleCollisions(playerid, false), NearPNS[playerid] = 0;
		if(nearPNS2(playerid)) DisableRemoteVehicleCollisions(playerid, true), NearPNS[playerid] = 1;
	}

	if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER) Checkvehinfo(playerid);

	if(TradeTime[playerid] > 0) {
		TradeTime[playerid] --;
		playerTextDrawString(playerid, TradePTD[6], "00:0%d", TradeTime[playerid]); PlayerTextDrawShow(playerid, TradePTD[6]);
		playerTextDrawString(TradeID[playerid], TradePTD[6], "00:0%d", TradeTime[playerid]); PlayerTextDrawShow(TradeID[playerid], TradePTD[6]);
		if(!TradeTime[playerid]) FinishTrade(playerid), PlayerTextDrawHide(playerid, TradePTD[6]), PlayerTextDrawHide(TradeID[playerid], TradePTD[6]);
	}

	if(PlayerInfo[playerid][pJob] == 1 && JobWorking[playerid] == 1 && IsPlayerInRangeOfPoint(playerid, 200, -381.7109,-1404.9537,24.9464) && Carspeed(playerid) > 25) {
		JobSeconds[playerid] --; UpdateJobStats(playerid);
		if(JobSeconds[playerid] == 0) {
			SCM(playerid, COLOR_JOB, "(Job): {ffffff}Ai colectat graul, mergi la hambar pentru a-l lasa.");
			PlayerTextDrawHide(playerid, JobTD);
			if(JobVehicle[playerid] != 0) { DestroyVehicle(JobVehicle[playerid]); JobVehicle[playerid] = 0; }
			PlayerTextDrawHide(playerid, InfosTD);
			DisablePlayerCheckpointEx(playerid);
   			DisableRemoteVehicleCollisions(playerid, 1);
			JobVehicle[playerid] = 0;
			CP[playerid] = 672;
			SetPlayerCheckpointEx(playerid, -575.2084,-1484.2942,10.5625, 1.0);
		}
	}

	if(PlayerInfo[playerid][pJob] == 8 && JobWorking[playerid] == 1 && IsPlayerInRangeOfPoint(playerid, 200, -1073.4335,-1038.4133,129.2188) && Carspeed(playerid) > 25) {
		JobSeconds[playerid] --; UpdateJobStats(playerid);
		if(JobSeconds[playerid] == 0) {
			SCM(playerid, COLOR_JOB, "(Job): {ffffff}Ai colectat graul, mergi la hambar pentru a-l lasa.");
			PlayerTextDrawHide(playerid, JobTD);
			if(JobVehicle[playerid] != 0) { DestroyVehicle(JobVehicle[playerid]); JobVehicle[playerid] = 0; }
			PlayerTextDrawHide(playerid, InfosTD);
			DisablePlayerCheckpointEx(playerid);
   			DisableRemoteVehicleCollisions(playerid, 1);
			JobVehicle[playerid] = 0;
			CP[playerid] = 599;
			SetPlayerCheckpointEx(playerid, -1073.4335,-1038.4133,129.2188, 1.0);
		}
	}

	if(PlayerInfo[playerid][pWantedLevel] >= 1) {
		playerTextDrawString(playerid, WantedTD[playerid], "Nivel wanted actual: ~y~%d~n~~w~~h~Scade un nivel in: ~y~%d min.", PlayerInfo[playerid][pWantedLevel], 10 - WantedTime[playerid]);
		PlayerTextDrawShow(playerid, WantedTD[playerid]);
	} else PlayerTextDrawHide(playerid, WantedTD[playerid]);

	if(IsPlayerPaused(playerid)) {
		AFKSeconds[playerid] ++;
		//if(AFKSeconds[playerid] == 3600 && !PlayerInfo[playerid][pSleeping]) NightBot(playerid, "AFK without /sleep more then 60 minutes");

		if(AFKSeconds[playerid] >= 120 && JobWorking[playerid]) {

		SCM(playerid, COLOR_WHITE, "Job esuat deoarece ai stat AFK timp de 2 minute.");
		if(playerObject[playerid] != 0) DestroyPlayerObject(playerid, playerObject[playerid]), playerObject[playerid] = 0;
		if(playerObject2[playerid] != 0) DestroyObject(playerObject2[playerid]), playerObject2[playerid] = 0;
		PlayerTextDrawHide(playerid, JobTD);

		if(JobWorking[playerid] == 1) {
			JobWorking[playerid] = 0;
			PlayerTextDrawHide(playerid, JobTD);
			if(JobVehicle[playerid] != 0) DestroyVehicle(JobVehicle[playerid]), JobVehicle[playerid] = 0;
			RemovePlayerAttachedObject(playerid, 2);
		}
		if(JobWorking2[playerid] == 1) JobWorking2[playerid] = 0, DestroyVehicle(FarmerCar[playerid]);
		if(JobWorking3[playerid] == 1) JobWorking3[playerid] = 0, DestroyVehicle(PizzaCar[playerid]);
		if(JobWorking4[playerid] == 1) JobWorking4[playerid] = 0, DestroyVehicle(DrugsCar[playerid]);

		PlayerTextDrawHide(playerid, InfosTD);
		SetPlayerSpecialAction(playerid, 0);
		DisablePlayerCheckpointEx(playerid);
		DisablePlayerRaceCheckpointEx(playerid);
		RemovePlayerAttachedObject(playerid, 6);
		RemovePlayerAttachedObject(playerid, 2);
		RemovePlayerAttachedObject(playerid, 5);
		RemovePlayerAttachedObject(playerid, 4);
		CP[playerid] = 0;

		if(Iter_Contains(WorkingPlayers[PlayerInfo[playerid][pJob]], playerid)) Iter_Remove(WorkingPlayers[PlayerInfo[playerid][pJob]], playerid);
		}

		else if(AFKSeconds[playerid] < 6) {
		}
	}
	else AFKSeconds[playerid] = 0;


	if(IsPlayerInRangeOfPoint(playerid, 1.5, last_pos1[playerid][0], last_pos1[playerid][1], last_pos1[playerid][2])) AFKSeconds1[playerid]++;
	else AFKSeconds1[playerid]=0;

	if(PlayerInfo[playerid][pSleeping] == 0 && AFKSeconds1[playerid] < 15) PlayerInfo[playerid][pSeconds] ++;

	GetPlayerPos(playerid, last_pos1[playerid][0], last_pos1[playerid][1], last_pos1[playerid][2]);

	GetPlayerPos(playerid, LastPos[playerid][0], LastPos[playerid][1], LastPos[playerid][2]);
	GetPlayerHealthEx(playerid, ppHealth);
	GetPlayerArmourEx(playerid, ppArmour);

	if(GetPlayerWeapon(playerid) != 0 && AFKSeconds[playerid] == 0) {
		if(ServerSystem[1] == 0 && GetPlayerWeapon(playerid) > 0) CheckWeapons(playerid, GetPlayerWeapon(playerid));
		if(ServerSystem[2] == 0 && GetPlayerWeapon(playerid) > 0) CheckAmmo(playerid, GetPlayerWeapon(playerid));
	}

	if(WTimes[playerid] != 0) WTimes[playerid] -= 2;

	new dl = GetPlayerDrunkLevel(playerid);
	if(dl < 100) SetPlayerDrunkLevel(playerid, 2000);
	else {
		if(pDrunkLevelLast[playerid] != dl) {
			new wfps = pDrunkLevelLast[playerid] - dl;
			if((wfps > 0) && (wfps < 200)) FPS2[playerid] = wfps;
			pDrunkLevelLast[playerid] = dl;
		}
	}

	if(PlayerInfo[playerid][pShowFP] == 1 && PlayerInfo[playerid][pShowHud] == 0) {
		format(string, 8, "~y~%d", FPS2[playerid]-1);
		PlayerTextDrawSetString(playerid, ShowTD[0], string);
		PlayerTextDrawShow(playerid, ShowTD[0]);

		if(PlayerInfo[playerid][pAdmin] >= 6) {
			format(string, 15, "~r~%d ~b~%d", GetServerTickRate(), mysql_unprocessed_queries());
			PlayerTextDrawSetString(playerid, ShowTD[1], string);
			PlayerTextDrawShow(playerid, ShowTD[1]);
		}
	}

	// if(GetPlayerAnimationIndex(playerid)==1660) OnPlayerUseVending(playerid);

	if(PlayerInfo[playerid][pShowHP] != 0 && ppHealth >= 1) {
		playerTextDrawString(playerid, CleoTD[0], "%.0f", ppHealth); PlayerTextDrawShow(playerid, CleoTD[0]);	PlayerTextDrawColor(playerid, CleoTD[0], GetHudColor(PlayerInfo[playerid][pShowHP]));
	} else PlayerTextDrawHide(playerid, CleoTD[0]);

	if(PlayerInfo[playerid][pShowAP] != 0 && ppArmour >= 1) {
		playerTextDrawString(playerid, CleoTD[1], "%.0f", ppArmour); PlayerTextDrawShow(playerid, CleoTD[1]); PlayerTextDrawColor(playerid, CleoTD[1], GetHudColor(PlayerInfo[playerid][pShowAP]));
	} else PlayerTextDrawHide(playerid, CleoTD[1]);

	if(SafeTime[playerid] > 0) SafeTime[playerid]--;

	switch(PlayerInfo[playerid][pLevel]) {
		case 0..2: PlayerInfo[playerid][pPayCheck] += 2;
		case 3..4: PlayerInfo[playerid][pPayCheck] += 3;
		case 5..6: PlayerInfo[playerid][pPayCheck] += 4;
		case 7..8: PlayerInfo[playerid][pPayCheck] += 5;
		case 9.10: PlayerInfo[playerid][pPayCheck] += 6;
		case 11..12: PlayerInfo[playerid][pPayCheck] += 7;
		case 13..14: PlayerInfo[playerid][pPayCheck] += 8;
		case 15..16: PlayerInfo[playerid][pPayCheck] += 9;
		case 17..18: PlayerInfo[playerid][pPayCheck] += 10;
		case 19..20: PlayerInfo[playerid][pPayCheck] += 11;
		default: PlayerInfo[playerid][pPayCheck] += 12;
	}

	if(PlayerInfo[playerid][pJailed] > 0) {
		if(PlayerInfo[playerid][pJailTime] > 0 && IsPlayerLogged[playerid] == 1) { PlayerInfo[playerid][pJailTime] --; TextDrawShowForPlayer(playerid, Jailtime[playerid]); textDrawString(Jailtime[playerid], "Jail time: ~r~%d %s", (PlayerInfo[playerid][pJailTime] > 60) ? (PlayerInfo[playerid][pJailTime] / 60) : (PlayerInfo[playerid][pJailTime]), (PlayerInfo[playerid][pJailTime] > 60) ? ("minute") : ("secunde")); }
		if(PlayerInfo[playerid][pJailTime] <= 0) {
		if(PlayerInfo[playerid][pJailed] == 1) PutPlayerInJail(playerid);
		PlayerInfo[playerid][pAJail] = 0; UpdateVar(playerid, "AJail", 0);
		PlayerInfo[playerid][pJailTime] = 0; UpdateVar(playerid, "JailTime", 0);
		PlayerInfo[playerid][pJailed] = 0; UpdateVar(playerid, "Jailed", 0);
		SpawnPlayer(playerid); SetPlayerSpecialAction(playerid, SPECIAL_ACTION_NONE); RemovePlayerAttachedObject(playerid, 1);
		ClearCrime(playerid); SetPlayerToTeamColor(playerid); TogglePlayerControllable(playerid, true);
		TextDrawHideForPlayer(playerid, Jailtime[playerid]); SetPlayerSkinEx(playerid, (PlayerInfo[playerid][pChar] > 0) ? (PlayerInfo[playerid][pChar]) : (PlayerInfo[playerid][pModel]));
		}
	}
	if(PlayerInfo[playerid][pHitT] > 0) PlayerInfo[playerid][pHitT] --;
	if(PlayerInfo[playerid][pMuteTime] > 0) PlayerInfo[playerid][pMuteTime] --;
	if(PlayerInfo[playerid][pMuted] > 0 && !PlayerInfo[playerid][pMuteTime]) { PlayerInfo[playerid][pMuteTime] = 0, PlayerInfo[playerid][pMuted] = 0, SCM(playerid, COLOR_GREY, "You have now been automatically unmuted."); }

	if(PlayerTazeTime[playerid] >= 1) {
	PlayerTazeTime[playerid] ++;
	if(PlayerTazeTime[playerid] == 15) PlayerTazeTime[playerid] = 0;
	}
	if(PlayerDrunk[playerid] >= 5) {
		PlayerDrunkTime[playerid] ++;
		if(PlayerDrunkTime[playerid] == 8) { PlayerDrunkTime[playerid] = 0; SetPlayerDrunkLevel(playerid, 5000); LoopingAnim(playerid, "PED", "WALK_DRUNK", 4.0, 1, 1, 1, 1, 0); }
	}
	if(IsSmoking[playerid] > 0) {
		IsSmoking[playerid] --;
		if(!IsSmoking[playerid]) {
			sendNearbyMessage(playerid, 30.0, COLOR_PURPLE, "* %s a terminat de fumat tigara.", GetName(playerid));
			if(ppHealth >= 93) SetPlayerHealthEx(playerid, 99);
			else SetPlayerHealth(playerid, ppHealth + 6);
		}
	}

	if(PlayerCuffed[playerid] == 1 || PlayerCuffed[playerid] == 2) {
		PlayerCuffedTime[playerid] --;
		if(!PlayerCuffedTime[playerid]) { TogglePlayerControllable(playerid, true); PlayerCuffed[playerid] = 0; PlayerCuffedTime[playerid] = 0; PlayerTazeTime[playerid] = 1; }
	}

	for(new sf = 0; sf < MAX_SAFEZONES; sf++) {
		if(IsPlayerInRangeOfPoint(playerid, 20.0, GraffitiInfo[sf][gfX], GraffitiInfo[sf][gfY], GraffitiInfo[sf][gfZ]) && Showed[playerid] == 0) { PlayerTextDrawSetString(playerid, SafeTD, "CLAN-ZONE"); PlayerTextDrawShow(playerid, SafeTD); Showed[playerid] = 2; SFID[playerid] = sf; }
		else if(!IsPlayerInRangeOfPoint(playerid, 20.0, GraffitiInfo[SFID[playerid]][gfX], GraffitiInfo[SFID[playerid]][gfY], GraffitiInfo[SFID[playerid]][gfZ]) && Showed[playerid] == 2) { PlayerTextDrawHide(playerid, SafeTD);	Showed[playerid] = 0; SFID[playerid] = 0;	}

		if(SafeZone[sf][szRange] >= 15) {
			if(IsPlayerInRangeOfPoint(playerid, SafeZone[sf][szRange], SafeZone[sf][szX], SafeZone[sf][szY], SafeZone[sf][szZ]) && Showed[playerid] == 0) { Showed[playerid] = 1;	SFID[playerid] = sf; PlayerTextDrawSetString(playerid, SafeTD, "SAFE-ZONE"); PlayerTextDrawShow(playerid, SafeTD); }
			else if(!IsPlayerInRangeOfPoint(playerid, SafeZone[SFID[playerid]][szRange], SafeZone[SFID[playerid]][szX], SafeZone[SFID[playerid]][szY], SafeZone[SFID[playerid]][szZ]) && Showed[playerid] == 1) { Showed[playerid] = 0; SFID[playerid] = 0; PlayerTextDrawHide(playerid, SafeTD); }
		}
	}

	if(IsPlayerInAnyVehicle(playerid)) {
		new Float: vehicleHP; GetVehicleHealth(GetPlayerVehicleID(playerid), vehicleHP);
		if(vehicleHP == 1000.0) {
			for(new mm = 1; mm < sizeof BizzInfo; mm++) {
				if(IsPlayerInRangeOfPoint(playerid, 10.0, BizzInfo[mm][bEntranceX], BizzInfo[mm][bEntranceY], BizzInfo[mm][bEntranceZ]) && (mm == 24 || mm == 25 || mm == 23 || mm == 30 || mm == 31 || mm == 32)) {
					for(new m; m < 2; m ++) { if(PlayerInfo[playerid][pDailyMission][m] == 12) CheckMission(mm, m); }
					va_GameTextForPlayer(playerid, "~r~-%s$", 1000, 1, FormatNumber(BizzInfo[mm][bFee]));
					GivePlayerCash(playerid, -BizzInfo[mm][bFee]);
					BizzInfo[mm][bBalance] += BizzInfo[mm][bFee];
				}
			} SetVehicleHealth(GetPlayerVehicleID(playerid), 999);
		}
	}
	if(Exception[playerid] == 0 && AFKSeconds[playerid] < 10 && InDealer[playerid] == 0 && PlayerInfo[playerid][pAdmin] == 0 && Spectate[playerid] == INVALID_PLAYER_ID &&
	!IsPlayerInRangeOfPoint(playerid, 100.0, LastPos[playerid][0], LastPos[playerid][1], LastPos[playerid][2]) && !IsPlayerInArea(playerid, -3000, -2274.5, -1776, -859.5) &&
	GetPlayerState(playerid) != PLAYER_STATE_PASSENGER && GetPlayerSurfingVehicleID(playerid) != INVALID_VEHICLE_ID
	&& ServerSystem[0] == 0) {

	WarningsCheat[playerid] += 2;
	if(WarningsCheat[playerid] >= 4) NightBot(playerid, "Cheats (teleport-hack)"), WarningsCheat[playerid] = -3;
	}

	if(WarningsCheat[playerid] > 0) WarningsCheat[playerid] --;
	if(Exception[playerid] > 0) Exception[playerid] --;
	if(GetPlayerWeapon(playerid) >= 8 && GetPlayerWeapon(playerid) != 46 && GetPlayerWeapon(playerid) != 43 && PlayerInfo[playerid][pGunLic] == 0) {
	if(ServerSystem[1] == 0 ) NightBot(playerid, "Cheats (weapon-hack)");
	}
	if(!PlayerInfo[playerid][pAdmin]) {
		GetPlayerVelocity(playerid, animposX, animposY, animposZ);
		if(animposX <= -0.800000 || animposY <= -0.800000 || animposZ <= -0.800000 && GetPlayerAnimationIndex(playerid) == 1008) {
			if(GetPlayerSurfingVehicleID(playerid) == INVALID_VEHICLE_ID && !IsABike2(gLastCar[playerid])) {
				CheatWarnings[playerid] += 2;
				if(!ServerSystem[6] && CheatWarnings[playerid] >= 6) NightBot(playerid, "Fly-Hack");
			}
		}
	}
	if(CheatWarnings[playerid] > 0) CheatWarnings[playerid] --;

	if(PlayerInfo[playerid][pAdmin] == 0 && GetPlayerSpecialAction(playerid) == 2) {
	if(ServerSystem[9] == 0) NightBot(playerid, "Cheats (jetpack)");
	}
	return 1;
}
function CheckAdmins(caz) {

	if(caz == 0) return Iter_Count(PlayerAdmins);

	new x = 0;
	foreach(new i: PlayerAdmins) {
		if(AFKSeconds[i] >= 10) x++;
	}

	return x;
}

function CheckHelpers(caz) {

	if(caz == 0) return Iter_Count(PlayerHelpers);

	new x = 0;
	foreach(new i: PlayerHelpers) {
		if(AFKSeconds[i] >= 10) x++;
	}
	return x;
}
function CheckLeaders(caz) {
	new x = 0;
	if(caz == 0) {
		for(new f = 0; f < TOTAL_FACTIONS; f ++) {
			foreach(new i: FactionPlayers[f]) {
				if(PlayerInfo[i][pLeader] != 0) x ++;
			}
		}
	}
	else {
		for(new f = 0; f < TOTAL_FACTIONS; f ++) {
			foreach(new i: FactionPlayers[f]) {
				if(PlayerInfo[i][pLeader] != 0 && AFKSeconds[i] >= 10) x ++;
			}
		}
	}

	return x;
}

// varianta buna
function FreeHouses() {
	new x;
	for(new i = 1, j = sizeof(HouseInfo); i < j; i++) {
		if(HouseInfo[i][hOwned] == 1 && !strcmp(HouseInfo[i][hOwner], "The State", true)) x++;
	}
	return x;
}

function GetHouseID() {
	for(new i = 1, j = sizeof(HouseInfo); i < j; i++) {
		if(HouseInfo[i][hOwned] == 1 && !strcmp(HouseInfo[i][hOwner], "The State", true)) return i;
	}
	return 0;
}
function FreeBusinesses() {
	new x;
	for(new i = 1, j = sizeof(BizzInfo); i < j; i++) {
		if(BizzInfo[i][bOwned] == 1 && !strcmp(BizzInfo[i][bOwner], "The State", true)) x++;
	}
	return x;
}
function GetBizzID() {
	for(new i = 1, j = sizeof(BizzInfo); i < j; i++) {
		if(BizzInfo[i][bOwned] == 1 && !strcmp(BizzInfo[i][bOwner], "The State", true)) return i;
	}
	return 0;
}
function GetAFKPlayers() {
	new x;
	foreach(Player, i) {
		if(AFKSeconds[i] >= 60) x++;
	}
	return x;
}
stock SetPlayerPosEx(playerid, Float:x, Float:y, Float:z) {
	SetPlayerPos(playerid, x, y, z);
	GetPlayerPos(playerid, LastPos[playerid][0], LastPos[playerid][1], LastPos[playerid][2]);
	Exception[playerid] += 1;
    foreach(Player, i) {
		if(Spectate[i] == playerid) {
			TogglePlayerSpectating(i, 1);
			SetPlayerInterior(i, GetPlayerInterior(playerid));
			SetPlayerVirtualWorld(i, GetPlayerVirtualWorld(playerid));
			if(IsPlayerInAnyVehicle(playerid)) PlayerSpectateVehicle(i, GetPlayerVehicleID(playerid));
			else PlayerSpectatePlayer(i, playerid);
		}
	}
	if(GetPVarInt(playerid, "Undercover") == 1) {
        foreach(Player, i) ShowPlayerNameTagForPlayer(i, playerid, false);
		PlayerTextDrawShow(playerid, UndercoverTD);
	}
	return 1;
}
stock CreateVehicleEx(modelid, Float:x, Float:y, Float:z, Float:angle, color1, color2, respawn_delay) {
	new vehid = CreateVehicle(modelid, x, y, z, angle, color1, color2, respawn_delay);
	VehicleStats[vehid][vColorOne] = color1;
	VehicleStats[vehid][vColorTwo] = color2;
	SetVehicleHealth(vehid, 999);
	VehicleExist[vehid] = 1;
	return vehid;
}
stock DestroyVehicleEx(vehid) {
	VehicleStats[vehid][vColorOne] = 0;
	VehicleStats[vehid][vColorTwo] = 0;
	SetVehicleHealth(vehid, 999);
	VehicleExist[vehid] = 0;
	return 1;
}
stock ChangeVehicleColorEx(vehicleid, color1, color2) {
	VehicleStats[vehicleid][vColorOne] = color1;
	VehicleStats[vehicleid][vColorTwo] = color2;
	ChangeVehicleColor(vehicleid, color1, color2);
	return 1;
}
stock SetVehicleColor(vehicleid) {
	ChangeVehicleColor(vehicleid, VehicleStats[vehicleid][vColorOne], VehicleStats[vehicleid][vColorTwo]);
	return 1;
}
stock SetVehiclePosEx(playerid, vehicleid, Float:x, Float:y, Float:z) {
	if(GetPlayerVehicleID(playerid) == vehicleid) GetPlayerPos(playerid, LastPos[playerid][0], LastPos[playerid][1], LastPos[playerid][2]);
	SetVehiclePos(vehicleid, x, y, z);
	return 1;
}
stock SetVehicleZAngleEx(vehicleid, Float:z_angle) {
	SetVehicleZAngle(vehicleid, z_angle);
	return 1;
}
function CheckWeapons(playerid, i) {
	if(Spectate[playerid] != INVALID_PLAYER_ID || playerDeath[playerid] == 1) return 1;
	if(Weapons[playerid][i] == 0 && i != 0 && i != 43 && i != 46) NightBot(playerid, "Cheats (weapon-hack)");
	return 1;
}
function CheckAmmo(playerid, i) {
	if(Spectate[playerid] != INVALID_PLAYER_ID || playerDeath[playerid] == 1) return 1;
	if(IsPlayerInAnyVehicle(playerid) || GetPlayerWeapon(playerid) == 34) return 1;
	new result = GetPlayerAmmo(playerid) - WeaponAmmo[playerid][GetWeaponSlot(i)];
	if(result >= 30) {
		if(ServerSystem[2] == 0) NightBot(playerid, "Cheats (ammo-hack)");
	}
	return 1;
}
stock ResetWeapons(playerid) {
	ResetPlayerWeapons(playerid);
	for(new i = 0; i < 47; i++) {
		Weapons[playerid][i] = 0;
		WeaponAmmo[playerid][i] = 0;
	}
	return 1;
}
stock GetWeaponSlot(weaponid) {
	new slot;
	switch(weaponid) {
		case 0,1: slot = 0;
		case 2 .. 9: slot = 1;
		case 10 .. 15: slot = 10;
		case 16 .. 18, 39: slot = 8;
		case 22 .. 24: slot =2;
		case 25 .. 27: slot = 3;
		case 28, 29, 32: slot = 4;
		case 30, 31: slot = 5;
		case 33, 34: slot = 6;
		case 35 .. 38: slot = 7;
		case 40: slot = 12;
		case 41 .. 43: slot = 9;
		case 44 .. 46: slot = 11;
	}
	return slot;
}
function HaveWeapons(playerid) {
	new x, Player_Weapons[13], Player_Ammos[13];
	for(new i = 1;i <= 12;i++) {
		GetPlayerWeaponData(playerid,i,Player_Weapons[i],Player_Ammos[i]);
		if(Player_Weapons[i] != 0) x++;
	}
	return x;
}
ServerWeapon(playerid, weaponid, ammo) {
	if(PlayerInfo[playerid][pGunLic] == 0 && weaponid >= 8 && weaponid != 43 || weaponid == 9 && PlayerInfo[playerid][pJob] == 0 && JobWorking[playerid] == 0 && PlayerInfo[playerid][pGunLic] == 0) return 1;
	Weapons[playerid][weaponid] = 1;
	WeaponAmmo[playerid][GetWeaponSlot(weaponid)] += ammo;
	GivePlayerWeapon(playerid, weaponid, ammo);
	return 1;
}
function GetPlayers() {
	new x;
	foreach(Player, i) {
	    if(IsPlayerLogged[i] == 1) x++;
	}
	return x;
}
YCMD:jetpack(playerid, params[], help) {
	if(PlayerInfo[playerid][pAdmin] < 2) return SCM(playerid, COLOR_GREY, "Nu ai acces!");
	SetPlayerSpecialAction(playerid, 2);
	SCM(playerid, COLOR_WHITE, "Ai primit un jetpack.");
	return 1;
}
function GetReports() {
	new reports;
	foreach(Player,f) {
	    if(IsPlayerLogged[f] == 1) {
			if(Ajutor[f] == 1) reports++;
		}
	}
	return reports;
}
stock GetVehicleDriver(vid) {
	foreach(new i: Player) {
		if(GetPlayerVehicleID(i) == vid) return i;
	}
	return INVALID_PLAYER_ID;
}

function GameTextForPaint(string[], paint) {
	foreach(Player, i) {
		if(PaintType[i] == paint+1) {
			GameTextForPlayer(i, string, 1500, 4);
		}
	}
	return 1;
}
stock playerTextDrawString(playerid, PlayerText:playertextdrawid, const text[], va_args<>) {
	new string[256]; va_format(string, 256, text, va_start<3>);
	PlayerTextDrawSetString(playerid, playertextdrawid, string);
	return 1;
}
stock clearChat(playerid, lines) {
	for(new i = 1; i <= lines; i++) SCM(playerid, -1, "");
	return 1;
}
function HelperQuestions() {
	new string[256], helpers;
	foreach(Player, i) {
	    if(IsPlayerLogged[i] == 1) {
	        if(PlayerInfo[i][pHelper] != 0 && HelperDuty[i] == 1 && HaveHelp[i] == -1) {
	            HaveHelper[helpers] = i;
				helpers ++;
	        }
	    }
	}

	foreach(Player, i) {
		if(IsPlayerLogged[i] == 1) {
			if(Helped[i] == 1 && OnHelper[i] == 0) {
				if(helpers >= 1) {
					new userID = HaveHelper[random(helpers)], playerid = i;
					if(HaveHelp[userID] == -1) {
						PlayerPlaySound(userID, 1056, 0.0, 0.0, 0.0);
						format(string, sizeof(string), "Intrebarea ta a fost preluata de helperul %s (%d). Asteapta sa-ti raspunda.", GetName(userID), userID);
						SCM(i, COLOR_YELLOW, string);
						SCM(userID, COLOR_YELLOW, "Intrebare noua:");
						format(string, 512, "* %s (%d) intreaba: %s", GetName(playerid), playerid, HelpText[i]);
						SCM(userID, 0x4FB021FF, string);
						HaveHelp[userID] = playerid;
						OnHelper[i] = 1;
					}
				}
			}
		}
	}
	return 1;
}
function Checkvehinfo(i) {
	if(GetPlayerState(i) == PLAYER_STATE_DRIVER && InDealer[i] == 0) {

		new
			status[180], str[256], benzina[10], carspeed[180],
			engine,lights,alarm,doors,bonnet,boot,objective,
			vehicle = GetPlayerVehicleID(i), carid = VehicleSQL[vehicle];

		GetVehicleParamsEx(vehicle,engine,lights,alarm,doors,bonnet,boot,objective);

		format(carspeed, sizeof(carspeed), "~g~%d", Carspeed(i));
		PlayerTextDrawSetString(i, Speedo[0], carspeed);

		if(doors == 1) status = "~r~LOCKED";
		else if(doors == 0) status = "~g~UNLOCKED";
		else status = "~g~UNLOCKED";

		if(Gas[vehicle] > 20) format(benzina, 10, "%d", Gas[vehicle]);
		else format(benzina, 10, "~r~%d", Gas[vehicle]);

		if(carid != 0 && !IsAPlane(vehicle)) {
			if(!IsABike(vehicle) && !IsAPlane(vehicle)) format(str, sizeof(str), "Fuel: ~g~%s~w~~n~Odometer: ~g~%.2fKM~n~%s", benzina, CarInfo[carid][KM], status, "%");
			else format(str, sizeof(str), "Odometer: ~r~%.2fKM~n~%s", CarInfo[carid][KM], status);
			PlayerTextDrawSetString(i, Speedo[2], str);

		}
		else {
			if(!IsABike(vehicle) && !IsAPlane(vehicle)) format(str, sizeof(str), "Fuel: ~g~%s~n~%s", benzina, status, "%");
			else format(str, sizeof(str), "%s~w~~n~Radio: ~r~%s", status, GetVehicleRadio(vehicle));
			PlayerTextDrawSetString(i, Speedo[2], str);
		}

		PlayerTextDrawShow(i, Speedo[2]);
		PlayerTextDrawShow(i, Speedo[1]);
		PlayerTextDrawShow(i, Speedo[0]);


	}
	return 1;
}
function CheckGas() {
	new engine,lights,alarm,doors,bonnet,boot,objective, query[70];
	foreach(new x : Player) {
		if(GetPlayerState(x) == PLAYER_STATE_DRIVER)
		{
			new vehicle = GetPlayerVehicleID(x);
			if(Gas[vehicle] >= 1) {
				if(vehEngine[vehicle] == 1) {
					if(IsAPlane(vehicle) || IsABoat(vehicle) || ExamCar[x] == vehicle || JobVehicle[x] == vehicle) Gas[vehicle] ++;
					if(!IsPlayerPaused(x)) Gas[vehicle]--;

					new carid = VehicleSQL[vehicle];
		            if(carid != 0) {
                        new spe = Carspeed(x);
						if(spe > 5 && GetPlayerState(x) == PLAYER_STATE_DRIVER && GetPlayerVehicleID(x) == vehicle) {
							CarInfo[carid][KM] += (spe*0.27)/100;
							mysql_format(SQL, query, 70, "UPDATE `cars` SET `KM`='%f' WHERE `ID`='%d'", CarInfo[carid][KM], carid);
							mysql_tquery(SQL, query, "", "");
						}
					}
				}
			}
			else if(!IsAFLYCar(vehicle) && !IsABike(vehicle)) {
				NoFuel[x] = 1;
				GameTextForPlayer(x,"Fara benzina",1500,3);
				vehEngine[vehicle] = 0;
				GetVehicleParamsEx(vehicle,engine,lights,alarm,doors,bonnet,boot,objective);
				SetVehicleParamsEx(vehicle,VEHICLE_PARAMS_OFF,lights,alarm,doors,bonnet,boot,objective);
				SetPVarInt(x, "Engine", 0);
			}
		}
	}
	return 1;
}

function Fillup(playerid) {
	new VID, FillUp, string[180];
	VID = GetPlayerVehicleID(playerid);
	FillUp = GasMax - Gas[VID];
	new Incarcare = GasMax - Gas[VID];
	FillUp = FillUp *500;
	if(Refueling[playerid] == 1) {
		if(GetPlayerCash(playerid) >= FillUp) {
			Gas[VID] += Incarcare;
			format(string, sizeof(string), "* Rezervor incarcat! Pret: $%s.",FormatNumber(FillUp));
			SendClientMessage(playerid,COLOR_MONEY,string);
			TogglePlayerControllable(playerid, 1);
			GivePlayerCash(playerid, - FillUp);
			BizzInfo[GetGasStationID(playerid)][bBalance] += FillUp;
			Refueling[playerid] = 0;
			new str[90];
			mysql_format(SQL, str, 90, "UPDATE `bizz` SET `Till`='%d' WHERE `ID`='%d'",BizzInfo[GetGasStationID(playerid)][bBalance], GetGasStationID(playerid));
			mysql_tquery(SQL,str, "", "");
		}
		else {
			TogglePlayerControllable(playerid, 1);
			Refueling[playerid] = 0;
			format(string, sizeof(string), "Eroare: Ai nevoie de $%d pentru a face plinul.",FillUp);
			SendClientMessage(playerid,COLOR_LGREEN,string);
		}
	}
	return 1;
}

function ShowStats(playerid,targetid) {
    if(!IsPlayerConnected(playerid) || !IsPlayerConnected(targetid)) return 1;
	new
		string[256],
		atext[20],
		ttext[100],
		rtext[50],
		jtext[30],
		drank[20],
		vtext[20],
		infostring2[180],
		playersip[180],
		radios[64],
		infostring[180],

		account = PlayerInfo[targetid][pAccount],
		cash = GetPlayerCash(targetid),
		crimes = PlayerInfo[targetid][pCrimes],
		arrests = PlayerInfo[targetid][pArrested],
		drugs = PlayerInfo[targetid][pDrugs],
		mats = PlayerInfo[targetid][pMats],
		level = PlayerInfo[targetid][pLevel],
		exp = PlayerInfo[targetid][pExp],
		nxtlevel = PlayerInfo[targetid][pLevel],
		expamount,
		costlevel,
		pnumber = PlayerInfo[targetid][pPhone],
		rob = PlayerInfo[targetid][pRob],
		warn = PlayerInfo[targetid][pWarns],
		hkey = PlayerInfo[targetid][pHouse],
		bkey = PlayerInfo[targetid][pBizz],
		clan = PlayerInfo[targetid][pClan];

	if(PlayerInfo[targetid][pMember] == 0) ttext = "None";
	else format(ttext, 100, "%s (rank %d)", FactionName(PlayerInfo[targetid][pMember]), PlayerInfo[targetid][pRank]);

	if(PlayerInfo[targetid][pSex] == 1) atext = "Male";
	else if(PlayerInfo[targetid][pSex] == 2) atext = "Female";

	if(PlayerInfo[targetid][pRank] != 0) format(rtext, 50, GetRankName(targetid));
	else rtext = "-";

	if(PlayerInfo[targetid][pJob] == 0) jtext = "None";
	else format(jtext, sizeof(jtext), "%s", JobInfo[PlayerInfo[targetid][pJob]][jName]);

	if(PlayerInfo[targetid][pPremiumAccount] == 0) { drank = "No"; }
	else if(PlayerInfo[targetid][pPremiumAccount] == 1) { drank = "Yes"; }
	else { drank = "Nu"; }

	if(PlayerInfo[targetid][pVip] == 0) { vtext = "No"; }
	else if(PlayerInfo[targetid][pVip] == 1) { vtext = "Yes"; }


	expamount = nxtlevel*levelexp;
	costlevel = nxtlevel*levelcost;


	if(WTChannel[playerid] == 0) radios = "Disabled";
	else format(radios, sizeof(radios), "#%d", WTChannel[playerid]);

	format(string, 256, "General: {FFFFFF}Name: %s (%d) | Playing hours %0.2f | Warns: %d/3 | Money: $%s | Bank: $%s | Phone: %d", GetNameEx(targetid), targetid, PlayerInfo[targetid][pConnectTime], warn, FormatNumber(cash),FormatNumber(account), pnumber);
	SCM(playerid, COLOR_PRINCIPAL,string);
	format(string, 256, "Account: {FFFFFF}Level: %d | Respect Points: %d/%d | Next level: $%s | Premium Account: %s | Vip Account: %s |  Premium Points: %d", level,exp,expamount,FormatNumber(costlevel),drank,vtext,PlayerInfo[targetid][pPremiumPoints]);
	SCM(playerid, COLOR_PRINCIPAL,string);
	format(string, 256, "Player: {FFFFFF}Crimes: %d | Arrests: %d | Drugs: %d | Materials: %d | Freq: %s | Rob: %d/10 ", crimes,arrests,drugs,mats,radios, rob);
	SCM(playerid, COLOR_PRINCIPAL,string);
	format(string, 256, "Other: {FFFFFF}Job: %s | Faction: %s | Faction Warns: %d/3 | Faction Punish: %d/20 | Refferal: %d ",jtext,ttext,PlayerInfo[targetid][pFACWarns],PlayerInfo[targetid][pFpunish],PlayerInfo[targetid][pSQLID]);
	SCM(playerid, COLOR_PRINCIPAL,string);
	if(clan != 0) {
		if(PlayerInfo[targetid][pClanRank] < 6) format(string, sizeof(string), "Clan: {FFFFFF}Clan: %s (%d) | Tag: %s | Rank: %d | Clan Warns: %d/3", ClanInfo[clan][clName], clan, ClanInfo[clan][clTag], PlayerInfo[targetid][pClanRank], PlayerInfo[targetid][pClanWarn]);
		else format(string, sizeof(string), "Clan: {FFFFFF}Clan: %s (%d) | Tag: %s | Rank: %d | Clan Warns: %d/3 | Clan Days: %d", ClanInfo[clan][clName], clan, ClanInfo[clan][clTag], PlayerInfo[targetid][pClanRank], PlayerInfo[targetid][pClanWarn], ClanInfo[clan][clDays]);
		SCM(playerid, COLOR_PRINCIPAL, string);
	}

	// if(GetVehicles(targetid) >= 0) {
		// format(string, sizeof(string), "Vehicles: %d/%d | ", GetVehicles(targetid), TotalSlots(targetid));
		// strcat(infostring, string);
	// }
	if(hkey != 999) {
		if(hkey != 999 && strcmp(GetName(targetid), HouseInfo[hkey][hOwner], true) == 0) format(string, sizeof(string), "House: %d |", hkey);
		else format(string, sizeof(string), "Rent House: %d | ", hkey);
		strcat(infostring, string);
	}
	if(bkey != 255) {
		if(bkey >= 100) format(string, sizeof(string), "Static Business: %d | ", bkey-100);
		else  format(string, sizeof(string), "Business: %d | ", bkey);
		strcat(infostring, string);
	}
	if(PlayerInfo[targetid][pAdmin] != 0) {
		format(string, sizeof(string), "Admin warns: %d/3 | ", PlayerInfo[targetid][pAW]);
		strcat(infostring, string);
	}
	if(PlayerInfo[targetid][pHelper] != 0) {
		format(string, sizeof(string), "Helper warns: %d/3 | ", PlayerInfo[targetid][pHW]);
		strcat(infostring, string);
	}
	if(PlayerInfo[targetid][pLeader] != 0) {
		format(string, sizeof(string), "Leader warns: %d/3 | ", PlayerInfo[targetid][pLW]);
		strcat(infostring, string);
	}
	format(infostring2, strlen(infostring)-1, "%s", infostring);
	SCM(playerid, -1, infostring2);

	if(PlayerInfo[targetid][pAdmin] >= 1 || PlayerInfo[targetid][pHelper] >= 1) {
		if(PlayerInfo[targetid][pAdmin] != 0) {
			if(targetid == playerid) format(string, sizeof(string), "Ai ajutat %d jucatori pana acum. Jucatori ajutati saptamana aceasta: %d", PlayerInfo[targetid][pHelpedPlayers], PlayerInfo[targetid][pHelpedPlayersToday]);
			else format(string, sizeof(string), "A ajutat %d jucatori pana acum. Jucatori ajutati saptamana aceasta: %d", PlayerInfo[targetid][pHelpedPlayers], PlayerInfo[targetid][pHelpedPlayersToday]);
		}
		else {
			if(targetid == playerid) format(string, sizeof(string), "Ai ajutat %d jucatori pana acum. Jucatori ajutati azi: %d", PlayerInfo[targetid][pHelpedPlayers], PlayerInfo[targetid][pHelpedPlayersToday]);
			else format(string, sizeof(string), "A ajutat %d jucatori pana acum. Jucatori ajutati azi: %d", PlayerInfo[targetid][pHelpedPlayers], PlayerInfo[targetid][pHelpedPlayersToday]);
		}

		SCM(playerid, COLOR_GOLD, string);
	}
	if(PlayerInfo[playerid][pAdmin] >= 1) {
		GetPlayerIp(targetid,playersip,sizeof(playersip));
		format(string, sizeof(string), "Admin: {FFFFFF}Seconds: %.0f | AFK: %d | Interior ID: %d | Virtual World: %d | SQLID: %d",PlayerInfo[targetid][pSeconds],AFKSeconds[targetid],GetPlayerInterior(targetid),GetPlayerVirtualWorld(targetid),PlayerInfo[targetid][pSQLID]);
		SCM(playerid, COLOR_PRINCIPAL,string);
	}
	return 1;
}
function SetPlayerToTeamColor(playerid) {
	if(IsPlayerConnected(playerid)) {
		if(IsACop(playerid) && OnDuty[playerid] == 0) return SetPlayerColor(playerid, COLOR_WHITE);
		switch(PlayerInfo[playerid][pMember]) {
			case 0: SetPlayerColor(playerid,COLOR_WHITE);
			case 1: SetPlayerColor(playerid, 0x112ef2FF);
			case 2: SetPlayerColor(playerid, 0x2b45f5FF);
			case 3: SetPlayerColor(playerid, 0x01026bFF);
			case 4: SetPlayerColor(playerid, 0x0CAB3CFF);
			case 5: SetPlayerColor(playerid, 0x2A2A2AFF);
			case 6: SetPlayerColor(playerid, 0xffa200FF);
			case 7: SetPlayerColor(playerid, 0x91FF00FF);
			case 8: SetPlayerColor(playerid, 0xFFFFA8FF);
			case 9: SetPlayerColor(playerid, 0xFFABFCFF);
			case 10: SetPlayerColor(playerid, 0x85563dFF);
			case 11: SetPlayerColor(playerid, 0x7E3937FF);
			case 12: SetPlayerColor(playerid, COLOR_YELLOW);
			case 13: SetPlayerColor(playerid, 0xf86448FF);
  			case 14: SetPlayerColor(playerid, 0x112ef2FF);
			case 15: SetPlayerColor(playerid, 0x3d6085FF);
			case 16: SetPlayerColor(playerid, 0xb3ff38FF);
		}
    }
    return 1;
}

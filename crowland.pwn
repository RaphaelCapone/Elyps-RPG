YCMD:dsprice(playerid, params[], help) {
	new result[180], x, string[180], car;
	if(PlayerInfo[playerid][pAdmin] < 1 && PlayerInfo[playerid][pHelper] < 1) return 1;
	if(sscanf(params, "s[180]",result)) return SCM(playerid, COLOR_GREY, "USAGE: {FFFFFF}/dsprice <name/model>");
	for(new v = 0; v < 212; v++) {
		if(strfind(aVehicleNames[v], result, true) != -1 || v == strval(result)-400) car = v+400;
	}
	printf("%d", car);
	for(new i = 0; i < 96; i++) {
		if(DSModels[i][dModel] == car) {
			x = 1;
			format(string, sizeof(string), "Dealership Price - %s: {B9FF80}$%s, %d on stock and %d max speed.", aVehicleNames[DSModels[i][dModel]-400], FormatNumber(DSModels[i][dPrice]), DSModels[i][dStock], DSModels[i][dMaxSpeed]);
			SCM(playerid, -1, string);
		}
	}
	if(x == 0) return SCM(playerid, COLOR_GREY, "* Nu au fost gasite rezultate!");
	return 1;
}

YCMD:speed(playerid, params[], help) {
	if(PlayerInfo[playerid][pAdmin] < 5) return 1;
	if(EnableBoast[playerid] == 0) {
		EnableBoast[playerid] = 1;
		SCM(playerid, -1, "Speed boost: enable");
	}
	else {
		EnableBoast[playerid] = 0;
		SCM(playerid, -1, "Speed boost: disable");
	}
	return 1;
}


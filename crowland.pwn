			if(!response) {
				TutorialActive[playerid] = 1;
				TutorialSeconds[playerid] = 17;
				TutorialStep[playerid] = 0;
				return 1;
			}
			new szQuery[120], name[24], id = strval(inputtext), Cache: result;
			if(id == PlayerInfo[playerid][pSQLID]) {
				SCM(playerid, COLOR_WARNING, "Nu iti poti pune ID-ul tau de referral!");
				ShowPlayerDialogEx(playerid, DIALOG_REGISTER5, DIALOG_STYLE_INPUT, "Referral", "Ai fost adus de catre cineva pe comunitate?\n\nIntrodu codul jucatorului pentru a beneficia de anumite bonusuri.", "Introdu", "Skip");
				return 1;
			}
			mysql_format(SQL, szQuery, 120, "SELECT `name` FROM `users` WHERE `id`='%d' LIMIT 1", id);
			result = mysql_query(SQL, szQuery);
			new test = 0;
			cache_get_row_count(test);
			if(test != 0) cache_get_value_name(0, "name", name);
			cache_delete(result);

			if(test == 0) return ShowPlayerDialogEx(playerid, DIALOG_REGISTER5, DIALOG_STYLE_INPUT, "Referral", "Ai fost adus de catre cineva pe comunitate?\n\nIntrodu codul jucatorului pentru a beneficia de anumite bonusuri.\nReferral ID invalid!", "Introdu", "Skip");

			SetPVarInt(playerid, "Referral", id);
			format(string, sizeof(string), "Esti sigur ca %s te-a adus pe comunitate?", name);
			ShowPlayerDialogEx(playerid, DIALOG_REGISTER6, DIALOG_STYLE_MSGBOX, "Referral", string, "Yes", "Back");
		}
		case DIALOG_REGISTER6: {

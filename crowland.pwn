						format(string2, sizeof(string2), "%s a fost scos de Lider %s din %s (rank %d) dupa %d zile.", sName[playerid],GetName(playerid),FactionName(f),rank, days);
						mysql_format(SQL, query, sizeof(query), "INSERT INTO faction_logs (`text`,`player`,`leader`) VALUES ('%s','%d','%d')", string2, id, PlayerInfo[playerid][pSQLID]);
						mysql_tquery(SQL,query,"","");
						mysql_format(SQL,str,sizeof(str),"UPDATE `users` SET `Member`='0',`Rank`='0',`CChar`='170',`FPunish`='20',`FWarn`='0',`Leader`='0',`Days`='0' WHERE `name`='%s' LIMIT 1",sName[playerid]);
						mysql_tquery(SQL,str, "", "");

						Iter_Remove(FactionPlayers[f], playerid);
					}
				}

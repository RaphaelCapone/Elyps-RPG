stock GetTickDiff(newtick, oldtick)
{
	return newtick - oldtick;
}
stock ticketName(id) {
	new string[256];
	switch(id) {
		case 0: string = "Parcatul neregulamentar";
		case 1: string = "Condus neregulamentar";
		case 2: string = "Incurcarea celorlalti participanti la trafic";

				}
				case 4: {
					if(GetPVarInt(playerid, "SkinTrade") != -1) return SCM(playerid, COLOR_LGREEN, "Eroare: Ai pus deja un Skin!");

					accesedSkin[playerid] = -1;
					TextDrawShowForPlayer(playerid, SkinsTD[0]), TextDrawShowForPlayer(playerid, SkinsTD[1]);
					for(new x; x < 10; x++) {
						if(PlayerInfo[playerid][pSkins][x] == -1) PlayerTextDrawSetPreviewModel(playerid, Caracts_SkinsTD[playerid][x], 18631), PlayerTextDrawBackgroundColor(playerid, Caracts_SkinsTD[playerid][x], -1263225826);
						else PlayerTextDrawSetPreviewModel(playerid, Caracts_SkinsTD[playerid][x], PlayerInfo[playerid][pSkins][x]), PlayerTextDrawBackgroundColor(playerid, Caracts_SkinsTD[playerid][x], bgColorForSkin(PlayerInfo[playerid][pSkins][x]));
						PlayerTextDrawShow(playerid, Caracts_SkinsTD[playerid][x]);
					}
					SelectTextDraw(playerid, 0xbd000399);
					skinsMenuShowed{playerid} = true;
					tradingSkin{playerid} = true;
				}
			}
		}
		case DIALOG_TRADE+1: {

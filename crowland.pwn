					mysql_format(SQL, query, 80,"UPDATE users SET `Money`='%d', `GasCan`='1' WHERE `ID`='%d'",GetPlayerCash(playerid),PlayerInfo[playerid][pSQLID]);
					mysql_tquery(SQL, query, "", "");
					mysql_format(SQL, query, 80,"UPDATE `bizz` SET `Till`='%d',`Products`='%d' WHERE `ID`='%d'",BizzInfo[bizz][bBalance],BizzInfo[bizz][bProducts],bizz);
					mysql_tquery(SQL, query, "", "");
				}
				case 6: {
					if(GetPlayerCash(playerid) < 3000) return SCM(playerid, COLOR_GREY, "Nu ai destui bani pentru a face asta.");
					GivePlayerCash(playerid, - 3000);
					BizzInfo[bizz][bBalance] += 3000;
					ServerWeapon(playerid, 43, 50);

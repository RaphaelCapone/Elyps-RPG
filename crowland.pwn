}

YCMD:rpforall(playerid, params[], help) {
	new szMessage[180], rp;
	if(sscanf(params, "i", rp)) return SCM(playerid, COLOR_GREY, "USAGE: {FFFFFF}/rpforall <amount>");
	if(PlayerInfo[playerid][pAdmin] < 6) return SCM(playerid, COLOR_GREY, "Nu esti autorizat sa folosesti aceasta comanda!");
	foreach(Player, i) {
		if(IsPlayerConnected(i) && IsPlayerLogged[i] == 1) {
	 		PlayerInfo[i][pExp] += rp;
			Update(i, pExpx);
			format(szMessage, sizeof(szMessage), "* Administratorul %s ti-a dat %d RP-uri ca bonus!",GetName(playerid), rp);
			SCM(i,COLOR_YELLOW,szMessage);
			UpdateProgress(i);
		}
	}
	return 1;
}
YCMD:moneyforall(playerid, params[], help) {
	new money, szMessage[180];
	if(PlayerInfo[playerid][pAdmin] < 6) return SCM(playerid, COLOR_GREY, "Nu esti autorizat sa folosesti aceasta comanda!");
	if(PlayerInfo[playerid][pPin] != 0 && PlayerInfo[playerid][pPinLogged] == 0) return SCM(playerid, COLOR_LGREEN, "Pentru a folosi aceasta comanda, trebuie sa iti introduci codul de securitate folosind comanda (/loginpin).");
	if(sscanf(params, "i", money)) return SCM(playerid, COLOR_GREY, "USAGE: {FFFFFF}/moneyforall <money>");
	if(money < 1 || money > 5000000) return SCM(playerid, COLOR_GREY, "Suma invalida! ($1-$5.000.000)");
	foreach(Player, i) {
		if(IsPlayerConnected(i) && IsPlayerLogged[i] == 1) {
			GivePlayerCash(i, money);
			format(szMessage, sizeof(szMessage), "* Administratorul %s ti-a dat $%s ca bonus!", GetName(playerid), FormatNumber(money));
			SCM(i,COLOR_YELLOW,szMessage);
		}
	}
	return 1;
}
YCMD:petxpforall(playerid, params[], help) {
	new szMessage[180], xp;
	if(sscanf(params, "i", xp)) return SCM(playerid, COLOR_GREY, "USAGE: {FFFFFF}/petxpforall <amount>");
	if(PlayerInfo[playerid][pAdmin] < 6) return SCM(playerid, COLOR_GREY, "Nu esti autorizat sa folosesti aceasta comanda!");
	foreach(Player, i) {
		if(IsPlayerConnected(i) && IsPlayerLogged[i] == 1) {
			PlayerInfo[i][pPetXp] += xp;
	 	    new query[70];
	      	mysql_format(SQL, query, 70,"UPDATE `users` SET `PetXp` = '%d' WHERE `ID` = '%d'", PlayerInfo[i][pPetXp], PlayerInfo[playerid][pSQLID]);
	      	mysql_tquery(SQL, query, "", "");
			format(szMessage, sizeof(szMessage), "* Administratorul %s ti-a dat %d Pet Xp ca bonus!",GetName(playerid), xp);
			SCM(i,COLOR_YELLOW,szMessage);
		}
	}
	return 1;
}
YCMD:attack(playerid, params[], help) {
	new warSlot = GetFreeWarSlot();
	if(warSlot == -1) return Error(playerid, "Nu poti incepe un war acum, deoarece sunt pornite deja altele.");

	new turf = inTurf[playerid];
	if(turf == 0) return Error(playerid, "Nu te afli pe o zona care poate fi atacata.");

	if(!IsAMember(playerid)) return Error(playerid, "Nu ai abilitatea de a declansa un razboi.");
	if(PlayerInfo[playerid][pLeader] == 0 && PlayerInfo[playerid][pRank] < 4) return Error(playerid, "Nu ai abilitatea de a declansa un razboi.");

	new ownFaction = TurfInfo[turf][zOwned];
	if(ownFaction == PlayerInfo[playerid][pMember]) return Error(playerid, "Aceasta zona este deja detinuta de factiunea ta.");

	StartWar(playerid, warSlot, ownFaction);
	return 1;
}

YCMD:givegun(playerid, params[], help) {
	if(PlayerInfo[playerid][pMember] != 7) return SCM(playerid, -1, "Nu esti in factiunea School Instructor.");
	if(GetPVarInt(playerid, "InLesson") == -1) return SCM(playerid, -1, "Nu esti intr-o lectie.");
	if(DeelayCommand[playerid][4] != 0) return DeelayTime(playerid, 4);
	new id, sendername[MAX_PLAYER_NAME], string[120];
	GetPlayerName(playerid, sendername, sizeof(sendername));
	if(sscanf(params, "uii",id)) return SCM(playerid,COLOR_GREY, "Sintaxa: {FFFFFF}/setgun <Nume/ID> <Weapon ID>");
	if(!IsPlayerConnected(id) || id == INVALID_PLAYER_ID) return SCM(playerid, COLOR_GREY, "Acel player nu este conectat.");
	ServerWeapon(id, 23, 10);
	format(string, sizeof(string), "# %s a acordat o arma pentru testul in cadrul licentei de arme.", sendername);
	SendFactionMessage(7, COLOR_LIGHTBLUE, string);
	DeelayCommand[playerid][4] = 10*2;
	return 1;
}

YCMD:rentveh(playerid, params[], help) {
	if(!IsAtRent(playerid)) return SCM(playerid, -1, "Nu esti la Rent Place!");
    if(PlayerInfo[playerid][pWantedLevel] != 0) return SCM(playerid, COLOR_LGREEN, "Eroare: Nu poti sa inchiriezi un vehicul deoarece ai wanted!");

	new message[250];
	for(new x = 0; x < TOTAL_RENT_STOCK; x ++) format(message, 250, "%s\n%s\t\t%d models available", message, aVehicleNames[rentStockModels[x] - 400], availableStock[x]);
 	ShowPlayerDialogEx(playerid,DIALOG_RENTBIKE,DIALOG_STYLE_LIST,"Rent Vehicle", message, "Ok","Close");
    return 1;
}
YCMD:unrentveh(playerid, params[], help) {
	if(IsValidVehicle(RentVehicle[playerid])) {
		new v = RentVehicle[playerid], vehIndex = getRentVehicleIndex(GetVehicleModel(v));
		if(vehIndex == -1) return 1;
		DestroyVehicle(v);
		RentVehicle[playerid] = INVALID_VEHICLE_ID;
		availableStock[vehIndex] ++;
		SCM(playerid, -1, "Ai renuntat la vehiculul inchiriat.");
	}
	return 1;
}
YCMD:findrentveh(playerid, params[], help) {
	if(!IsValidVehicle(RentVehicle[playerid])) return SCM(playerid, COLOR_LGREEN, "Nu ai un vehicul inchiriat!");
	new Float: Pos[3];
	GetVehiclePos(RentVehicle[playerid], Pos[0], Pos[1], Pos[2]);
	SetPlayerCheckpointEx(playerid, Pos[0], Pos[1], Pos[2], 3);
	CP[playerid] = 53;
	SCM(playerid, -1, "Vehiculul tau a fost localizat si marcat pe harta cu un punct rosu.");
	return 1;
}
YCMD:lockrentveh(playerid, params[], help) {
	new engine,lights,alarm,doors,bonnet,boot,objective,
	v = RentVehicle[playerid];

	if(!IsValidVehicle(RentVehicle[playerid])) return SCM(playerid, -1, "Nu ai un vehicul inchiriat!");
	if(v == INVALID_VEHICLE_ID) return 1;
	else if(!IsPlayerNearVehicle(playerid, v, 5)) return 1;

 	GetVehicleParamsEx(v, engine,lights,alarm,doors,bonnet,boot,objective);
	switch(doors) {
	    case 0: {
			GameTextForPlayer(playerid, "~r~Locked", 1000, 3);
	    	SetVehicleParamsEx(v, engine,lights,alarm,1,bonnet,boot,objective);
	    }
 		case 1: {
			GameTextForPlayer(playerid, "~g~Unlocked", 1000, 3);
	    	SetVehicleParamsEx(v, engine,lights,alarm,0,bonnet,boot,objective);
	    }
	}
	return 1;
}

YCMD:pizza(playerid, params[], help) {
	if(JobWorking3[playerid] == 1) return SCM(playerid, COLOR_LGREEN, "Nu poti folosi aceasta comanda acum deoarece muncesti!");
	if(PlayerInfo[playerid][pJob] != 3) return SCM(playerid, -1, "Nu ai job-ul Pizzaboy.");
	if(Iter_Count(WorkingPlayers[PlayerInfo[playerid][pJob]]) == 100) return SCM(playerid, -1, "Muncesc deja 100 de jucatori la acest job.");
	if(!IsPlayerInRangeOfPoint(playerid, 3.0, 377.7702,-119.2800,1001.4922)) return SCM(playerid, -1, "Nu esti la pizzerie, tasteaza comanda (/findbiz 28), apoi intra un business-ul respectiv pentru a incepe munca.");
	if(PlayerInfo[playerid][pCarLic] == 0) return SCM(playerid, COLOR_WHITE, "Ai nevoie de licenta de condus pentru a face acest job!");
	PlayerTextDrawShow(playerid, PIZZA_PTD[0]);
	PizzaTD1[playerid] = 1;
	TextDrawShowForPlayer(playerid, PIZZA_TD[0]);
	TextDrawShowForPlayer(playerid, PIZZA_TD[1]);
	TextDrawShowForPlayer(playerid, PIZZA_TD[2]);
	TextDrawShowForPlayer(playerid, PIZZA_TD[3]);
	TextDrawShowForPlayer(playerid, PIZZA_TD[4]);
	TextDrawShowForPlayer(playerid, PIZZA_TD[5]);
	TextDrawShowForPlayer(playerid, PIZZA_TD[6]);
	SelectTextDraw(playerid, 0x000000FF);
	JobWorking3[playerid] = 1;
	return 1;
}
YCMD:buybait(playerid, params[], help) {
	if(GetPlayerCash(playerid) < 10000) return SCM(playerid, -1, "Ai nevoie de 10,000$ pentru a cumpara momeala!");
	if(!IsAtBait(playerid)) return SCM(playerid, -1, "Nu esti langa taraba de la jobul Fisherman!");
	SCM(playerid, -1, "Ai platit 10,000 pentru 25 momeala.");
	GivePlayerCash(playerid, - 10000);
	PlayerInfo[playerid][pMomeala] += 25;
	Update(playerid, pMomealax);
	return 1;
}
YCMD:delivery(playerid, params[], help) {
	if(PlayerInfo[playerid][pJob] != 1) return SCM(playerid, -1, "Nu ai job-ul Farmer.");
	if(GetPlayerSkill(playerid) < 3) return SCM(playerid, -1, "Ai nevoie de cel putin skill 3 pentru a incepe munca.");
 	if(Iter_Count(WorkingPlayers[PlayerInfo[playerid][pJob]]) == 75) return SCM(playerid, -1, "Muncesc deja 75 de jucatori la acest job.");
	if(PlayerInfo[playerid][pCarLic] == 0) return SCM(playerid, COLOR_LGREEN, "Eroare: Ai nevoie de o licenta de condus pentru a putea munci la acest job!");
	if(!IsPlayerInRangeOfPoint(playerid, 5.0, -570.4798,-1460.6735,9.3594)) {
		SCM(playerid, -1, "Nu esti punctul de pornire, ti-a fost setat un punct pe harta catre locatia corecta!");
		SetPlayerCheckpointEx(playerid, -570.4798,-1460.6735,9.3594, 1.0);
		CP[playerid] = 53;
		return 1;
	}
	if(JobWorking2[playerid] == 1) return SCM(playerid, COLOR_LGREEN, "Nu poti folosi aceasta comanda acum deoarece muncesti!");
	if(DeelayCommand[playerid][4] != 0) return DeelayTime(playerid, 4);
	if(HambarKG < 30) {
		SCM(playerid, -1, "Nu sunt reurse necesare in hambar.");
 		return 1;
	}
	new rand1 = -30;
 	JobWorking2[playerid] = 1;
 	FainaM(rand1);
	SCM(playerid, COLOR_JOB, "(Job): {ffffff}Au fost extrase 30 KG din hambar, livreaza-le la checkpoint-urile setate.");
	FarmerCar[playerid] = CreateVehicleEx(543,-570.4798,-1460.6735,9.3594,300.5816,0,0,-1);
	Gas[FarmerCar[playerid]] = 100;
	PutPlayerInVehicleEx(playerid, FarmerCar[playerid], 0);
	new rand = random(3);
	switch(rand) {
		case 0: SetPlayerCheckpointEx(playerid, 1037.7988,-1336.0286,13.5501, 1.0), jobsDeelay[playerid] = gettime() + 60;
		case 1: SetPlayerCheckpointEx(playerid, 924.0762,-1354.0588,13.3776, 1.0), jobsDeelay[playerid] = gettime() + 60;
		case 2: SetPlayerCheckpointEx(playerid, 818.4810,-1619.1056,13.5725, 1.0), jobsDeelay[playerid] = gettime() + 60;
	}
	CP[playerid] = 673;
  	Iter_Add(WorkingPlayers[PlayerInfo[playerid][pJob]], playerid);
	DeelayCommand[playerid][4] = 60*2;
	return 1;
}

YCMD:sellfish(playerid, params[], help) {
	new string[64];
	if(HaveFish[playerid] == 0) return SCM(playerid, -1, "Nu ai peste.");
	if(!IsPlayerInRangeOfPoint(playerid, 5.0, -31.0339,-28.8512,1003.5573)) return SCM(playerid, -1, "Nu esti la pescarie (/gps > Fish Market)!");
	GivePlayerCash(playerid, HaveFish[playerid]);
	format(string, sizeof(string), "(Job): {ffffff}Ai primit $%s!", FormatNumber(HaveFish[playerid]));
	SendClientMessage(playerid, COLOR_PRINCIPAL, string);
	HaveFish[playerid] = 0;
	PlayerInfo[playerid][pFishes] = 0;
	PlayerInfo[playerid][pFishSkill] ++;
	Update(playerid, pFishSkillx);

	switch(PlayerInfo[playerid][pFishSkill]) {
		case 30: SendClientMessage(playerid, COLOR_YELLOW, "* Skillul tau la jobul Fisherman, este acum 2.");
		case 90: SendClientMessage(playerid, COLOR_YELLOW, "* Skillul tau la jobul Fisherman, este acum 3.");
		case 210: SendClientMessage(playerid, COLOR_YELLOW, "* Skillul tau la jobul Fisherman, este acum 4.");
		case 450: SendClientMessage(playerid, COLOR_YELLOW, "* Skillul tau la jobul Fisherman, este acum 5.");
	}
	JobProgress(playerid);
	new j = PlayerInfo[playerid][pJob];
  	if(Iter_Contains(WorkingPlayers[j], playerid)) Iter_Remove(WorkingPlayers[j], playerid);
	return 1;
}
YCMD:setpin(playerid, params[], help) {
	if(PlayerInfo[playerid][pPin] != 0) return SCM(playerid, COLOR_LGREEN, "Eroare: Ai deja un cod pin setat.");
	ShowPlayerDialogEx(playerid, DIALOG_SETPIN, DIALOG_STYLE_INPUT, "Seteaza un cod pin", "Scrie codul de securitate pe care doresti sa-l ai:\nCodul pin trebuie sa aiba 4 cifre.", "Ok", "Close");
	Spoofer1[playerid] = 2;
	return 1;
}
YCMD:changepin(playerid, params[], help) {
	if(PlayerInfo[playerid][pPin] == 0) return SCM(playerid, COLOR_LGREEN, "Eroare: Nu ai un cod pin setat. Foloseste comanda (/setpin) pentru a seta unul.");
	if(PlayerInfo[playerid][pPinLogged] == 0) return SCM(playerid, COLOR_GREY, "Pentru a schimba pin-ul, trebuie sa fii logat cu acesta.");
	ShowPlayerDialogEx(playerid, DIALOG_CHANGEPIN, DIALOG_STYLE_INPUT, "Login pin", "Scrie codul tau de securitate pe care l-ai ales:", "Ok", "Close");
	Spoofer1[playerid] = 3;
	return 1;
}


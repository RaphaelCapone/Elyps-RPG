YCMD:editsafezone(playerid, params[], help) {
	new szDialog[1024], szDialog2[1024];
	new szZone[128];
    if(PlayerInfo[playerid][pAdmin] < 5) return SCM(playerid, COLOR_WHITE, "Nu ai acces!");
	for(new i = 0; i < MAX_SAFEZONES; i++) {
	    if(SafeZone[i][szRange] >= 15) {
	        GetPlayer3DZone2(SafeZone[i][szX], SafeZone[i][szY], SafeZone[i][szZ], szZone, sizeof(szZone));
	        format(szDialog, sizeof(szDialog), "%d. %s\n", i, szZone);
	        strcat(szDialog2, szDialog);
	    }
	}
	ShowPlayerDialogEx(playerid, DIALOG_EDITSF, DIALOG_STYLE_TABLIST, "Safezones:", szDialog2, "Select", "Cancel");
	return 1;
}
stock SCMEx(playerid, color, fstring[], {Float, _}:...) {
    new n = numargs() * 4;
	if (n == 3 * 4) {
		return SendClientMessage(playerid, color, fstring);
	}
	else {
		new message[255];
		new arg_start;
        new arg_end;
        new i = 0;
        #emit CONST.pri  fstring
        #emit ADD.C    0x4
        #emit STOR.S.pri arg_start
        #emit LOAD.S.pri n
        #emit ADD.C    0x8
        #emit STOR.S.pri arg_end
        for (i = arg_end; i >= arg_start; i -= 4) {
            #emit LCTRL    5
            #emit LOAD.S.alt i
            #emit ADD
            #emit LOAD.I
            #emit PUSH.pri
        }
        #emit PUSH.S  fstring
        #emit PUSH.C  128
        #emit PUSH.ADR message
        #emit PUSH.S  n
        #emit SYSREQ.C format
        i = n / 4 + 1;
        while (--i >= 0) {
            #emit STACK 0x4
        }
        return SendClientMessage(playerid, color, message);
	}
}


// stocks end
stock Error(playerid, err[]) {
	return SCMf(playerid, -1, "* Eroare: %s", err);
}
stock SaveSkins(playerid) {
	new str[75];
	for(new i = 0; i < 10; i++) format(str, 75, "%s%d|", str, PlayerInfo[playerid][pSkins][i]);
	new sl = strlen(str);
	strdel(str, sl - 1, sl);
	new q[200];
	mysql_format(SQL, q, 200, "UPDATE `users` SET `Skin` = '%s' WHERE `id` = '%d'", str, PlayerInfo[playerid][pSQLID]);
	mysql_tquery(SQL, q, "", "");
	return 1;
}

task checkForDonations[20000]()
{
    mysql_tquery(SQL, "SELECT * FROM `inf_payments` WHERE `received` = '0' AND `completed` = '1'", "checkDonations", "");
    return true;
}

function checkDonations()
{
    if(!cache_num_rows())
        return true;

 	new gQuery[100], id, amount, userid;
    for(new i = 0, j = cache_num_rows(); i != j; ++i)
    {
		cache_get_value_name_int(i, "id", id);
		cache_get_value_name_int(i, "amount", amount);
		cache_get_value_name_int(i, "userid", userid);

        mysql_format(SQL, gQuery, 100, "UPDATE `inf_payments` SET `received` = '1' WHERE `id` = '%d'", id);
        mysql_tquery(SQL, gQuery, "", "");

        mysql_format(SQL, gQuery, 100, "UPDATE `users` SET `GoldPoints` = `GoldPoints` + '%d' WHERE `id` = '%d' LIMIT 1", amount * 60, userid);
        mysql_tquery(SQL, gQuery, "giveDonation", "ddd", userid, amount, id);
    }
    return true;
}

function giveDonation(userid, amount, donationid)
{
    new name[MAX_PLAYER_NAME];

    cache_get_value_name(0, "name", name);

    new gString[256];

    format(gString, sizeof gString, "[Donation]: {ffffff}[db:%d] a donat %d euro si a primit %d premium points. [donation: #%d].", userid, amount, amount*60, donationid);
    SendAdminMessage(COLOR_WARNING, gString, 1);

    foreach(new x : Player)
    {
        if(PlayerInfo[x][pSQLID] == userid)
        {
            SCMEx(x, COLOR_WARNING, "[Donation]: {ffffff}Ai primit {DE1414}%d {ffffff}premium points deoarece ai donat {DE1414}%d {ffffff}euro [donation: #%d].", amount*60, amount, donationid);
            PlayerInfo[x][pPremiumPoints] += amount*60;
            Update(x, pPremiumPointsx);
			break;
        }
    }
    return true;
}

timer put_players_in_login[1000]() {
	new str[80];

	if(Iter_Count(PlayersOnLogin) >= MAX_PLAYERS_ON_LOGIN) {
		format(str, 80, "~n~~n~~W~PLEASE WAIT...~g~~n~THERE ARE ~y~%d ~g~PLAYERS WAITING FOR LOGIN", Iter_Count(PlayersWaitForLogin));
		foreach(new i: PlayersWaitForLogin) GameTextForPlayer(i, str, 1000, 4);
		return 1;
	}
	while(Iter_Count(PlayersOnLogin) < MAX_PLAYERS_ON_LOGIN && (Iter_Count(PlayersWaitForLogin) > 0) ) {
		new i = Iter_First(PlayersWaitForLogin);
		Iter_Remove(PlayersWaitForLogin, i);
		Iter_Add(PlayersOnLogin, i);

		new query[120];
		mysql_format(SQL, query, 120, "SELECT `password` FROM `users` WHERE `name`='%e' LIMIT 1", PlayerInfo[i][pUsername]);
		mysql_tquery(SQL, query, "CheckAccount", "d", i);
	}
	if(Iter_Count(PlayersWaitForLogin) == 0) {
		stop timer_queue_login;
		timer_queue_login = Timer:-1;
	}
	return 1;
}


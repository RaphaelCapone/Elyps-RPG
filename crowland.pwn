			ShowPlayerDialogEx(playerid, DIALOG_TENANTS+1, DIALOG_STYLE_MSGBOX, "Chiriasi", string, "Da", "Inapoi");
			SelectedItem[playerid] = listitem;
		}
		case DIALOG_TENANTS+1: {
			if(!response) return showTenants(playerid);

YCMD:petmenu(playerid, params[], help) {
	new string[128], string2[128];
	if(PlayerInfo[playerid][pPet] == 0) return SCM(playerid, -1, "Nu detii un pet!");
 	new request = 300*PlayerInfo[playerid][pPetLevel];
	if(PlayerInfo[playerid][pPetStatus] == 0) format(string, sizeof(string),"Pet Status\t{ff0000}Disable\nPet Name\t%s\nPet Activities\nLevel Up\nPet Shop\nPet Reborn",PlayerInfo[playerid][pPetName]);
	else format(string, sizeof(string),"Pet Status\t{1AAB07}Enable\nPet Name\t%s\nPet Activities\nLevel Up\t%d/%d Pet Xp\nPet Shop\nPet Reborn",PlayerInfo[playerid][pPetName], PlayerInfo[playerid][pPetXp], request);
	strcat(string2, string);
	ShowPlayerDialogEx(playerid, DIALOG_PET, DIALOG_STYLE_TABLIST, "Menu", string2, "Select", "Cancel");
	return 1;
}
function RemovePet(playerid) {
	PlayerInfo[playerid][pPetStatus] = 0;
	DestroyDynamic3DTextLabel(Pet[playerid]);
	if(IsPlayerAttachedObjectSlotUsed(playerid, 6)) RemovePlayerAttachedObject(playerid, 6);
	Update(playerid, pPetStatusx);
	return 1;
}

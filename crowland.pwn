function SyncUp() {
	new query[60],
		hour, minn, sec, Year, Month, Day;

	gettime(hour,minn,sec);

	getdate(Year, Month, Day);

	new datestr[25], timestr[25];
	format(datestr, 25, "%02d.%02d.%d", Day, Month, Year);
	format(timestr, 25, "%02d:%02d", hour, minn);
	TextDrawSetString(txtTimeDisp, timestr);
	TextDrawSetString(txtDateDisp, datestr);

	WantedTime2();
	FixHour(hour);
	hour = shifthour;

	if((hour > ghour) || (hour == 0 && ghour == 23)) {
	    if(hour == 00 && minn == 0) {
			ResetQuest();
			ResetMissionP();

			if(Day == 1) mysql_tquery(SQL, "UPDATE `users` SET `HoursMonth`='0'", "", "");

			for(new i = 0; i < MAX_CLANS; i++) {
				if(ClanInfo[i][clDays] > 0) {
					ClanInfo[i][clDays] --;
					if(ClanInfo[i][clDays] == 0) {
						RemoveClan(i);
						continue;
					}
					mysql_format(SQL, query, 60, "UPDATE `clans` SET `Days`='%d' WHERE `ID`='%d'", ClanInfo[i][clDays], i);
					mysql_tquery(SQL, query, "", "");
				}
			}
			mysql_tquery(SQL, "UPDATE `users` SET `Days`=`Days`+1 WHERE `Member`>'0'", "", "");
			mysql_tquery(SQL, "UPDATE `users` SET `ClanDays`=`ClanDays`+1 WHERE `Clan`>'0'", "", "");
			mysql_tquery(SQL, "UPDATE `users` SET `DayLogin`='0',`DayHours`='0'", "", "");
		    mysql_tquery(SQL, "UPDATE `users` SET `HelpedPlayersToday`='0' WHERE `Helper`>='1'", "", "");

			// add iters | to do
	        foreach(Player, i) {
	            if(IsPlayerLogged[i] == 1) {
					if(PlayerInfo[i][pMember] != 0) PlayerInfo[i][pDays] ++;

	                // PlayerInfo[i][pUsed] = 1;
					if(PlayerInfo[i][pHelper] != 0) PlayerInfo[i][pHelpedPlayersToday] = 0;
	            }
	        }
	    }
		ghour = hour;
		if(realtime) SetWorldTimeEx(hour);
	}
	return 1;
}
IsPlayerInArea(playerid, Float:MinX, Float:MinY, Float:MaxX, Float:MaxY) {
	new Float:X, Float:Y, Float:Z;
	GetPlayerPos(playerid, X, Y, Z);
	if(X >= MinX && X <= MaxX && Y >= MinY && Y <= MaxY) return 1;
	return 0;
}
function Production() {
	foreach(Player,i) {
		if(IsPlayerLogged[i] == 1) {
		    if(PlayerDrunk[i] > 0) {
			    PlayerDrunk[i] = 0;
		     	PlayerDrunkTime[i] = 0;
	    		SetPlayerDrunkLevel(i, 0);
			}
		    if(PlayerInfo[i][pPayDay] < 6) PlayerInfo[i][pPayDay] += 1;
		}
	}
	return 1;
}
function ResetPD() {
	Paydaydat = 0;
	return 1;
}
function PayDay() {
	new hour,minn,sec;
	gettime(hour,minn,sec);
	if(minn == 0 && Paydaydat == 0) {
		SetTimer("ResetPD", 60000, false);
		Paydaydat = 1;
		new string[256],
			interest, account[MAX_PLAYERS],
			rent[MAX_PLAYERS];

		SetTimer("ScadeLicentele", 4000, false);
		foreach(Player,i) {
			if(IsPlayerLogged[i] == 1) {
				new key = PlayerInfo[i][pHouse];
				if(key != 999) {
					rent[i] = HouseInfo[key][hRent];
					HouseInfo[key][hTakings] += rent[i];
				}
				else rent[i] = 0;

				new tmpintrate;
				if(PlayerInfo[i][pPremiumAccount] == 1)
				{
					tmpintrate = 2;
					PlayerInfo[i][pPayDayHad] += 1;
					if(PlayerInfo[i][pPayDayHad] >= 5) {
						PlayerInfo[i][pExp]++;
						PlayerInfo[i][pPayDayHad] = 0;
						Update(i, pExpx);
					}
					new bonus = PlayerInfo[i][pPayCheck] / 2;
					PlayerInfo[i][pPayCheck] += bonus;
				}
				else tmpintrate = 1;
				account[i] = PlayerInfo[i][pAccount];
				Tax += TaxValue;

				//PlayerInfo[i][pAccount] -= TaxValue;
				new checks = PlayerInfo[i][pLevel]*2500+random(3000);
				GivePlayerCash(i, checks);
				interest = (PlayerInfo[i][pAccount]/5000)*(tmpintrate);


				PlayerInfo[i][pExp] ++;

				UpdateProgress(i);
				PlayerInfo[i][pAccount] += interest+1000;
				PlayerInfo[i][pConnectTime] += PlayerInfo[i][pSeconds]/3600;
				Update(i, pConnectTimex);
				Update(i, pExpx);

				SendClientMessage(i, COLOR_GRAD5, "------------------------------------------[PAYDAY]-----------------------------------------------------------");
				SCMf(i, COLOR_GREY, "Ai primit %0.2f ore jucate. (%.0f minute)", PlayerInfo[i][pSeconds]/3600, PlayerInfo[i][pSeconds]/60);

				format(string, 150, "~n~~n~Ore jucate: %0.1f~n~Paycheck: $%s~n~Interes: $%s~n~Old Balance: $%s~n~New Balance: $%s", PlayerInfo[i][pSeconds]/3600, FormatNumber(checks), FormatNumber(interest), FormatNumber(account[i]), FormatNumber(PlayerInfo[i][pAccount]));
				PlayerTextDrawSetString(i, PaydayTD[1], string);
				PlayerTextDrawShow(i, PaydayTD[1]), PlayerTextDrawShow(i, PaydayTD[0]), PlayerTextDrawShow(i, PaydayTD[2]);

				SetTimer("hidePayday", 15000, false);

				if(PlayerInfo[i][pSeconds] >= 1800) {

					mysql_format(SQL, string, 100, "UPDATE `users` SET `DayHours`=`DayHours`+1, `HoursMonth`=`HoursMonth`+1 WHERE `ID`='%d'", PlayerInfo[i][pSQLID]);
					mysql_tquery(SQL, string, "", "");

				}
				PlayerInfo[i][pSeconds] = 0;

				SCMf(i, COLOR_GREY, "Paycheck: $%s | Tax: -$%d | Rent: -$%d | Old Balance: $%s", FormatNumber(checks), FormatNumber(TaxValue), rent[i], FormatNumber(account[i]));
				SCMf(i, COLOR_GREY, "Interest rate: 0.%d% | Interest: $%s | New balance: $%s", tmpintrate, FormatNumber(interest), FormatNumber(PlayerInfo[i][pAccount]));
				SendClientMessage(i, COLOR_GRAD5, "------------------------------------------[PAYDAY]-----------------------------------------------------------");

			    if(PlayerInfo[i][pPet] == 1) {
					PlayerInfo[i][pPayDay] = 0;
					PlayerInfo[i][pPayCheck] = 0;
					PlayerInfo[i][pPetXp] += 10;
					if(hour == 23) mysql_tquery(SQL,"UPDATE users SET pPMissions = 0|0|0|0|0","","");
				}
			}
		}
		// if(hour == 23) mysql_tquery(SQL,"UPDATE cars SET vDays = vDays+1","","");
		if(hour == 21) {
			new gold = 1 + random(4),
				money = 10000 + random(5000);

			format(string, 100, "Ai primit %d puncte premium si $%s deoarece clanul tau are peste 10 teriotrii.", gold, FormatNumber(money));
			for(new h = 1; h < MAX_CLANS; h++) {

				if(GetClanTurfs(h) >= 10) {
					foreach(new x: ClanPlayers[h]) {
						PlayerInfo[x][pPremiumPoints] += gold;
						Update(x, pPremiumPointsx);
						GivePlayerCash(x, money);
						SCM(x, COLOR_MONEY, string);
					}
				}
			}
		}
		if(RestartPayday == 1) {
			SCMTA(COLOR_CLIENT, "Server-ul a fost restartat! Va rugam sa reveniti.");
			GameModeExit();
		}
	}
	return 1;
}
function ScadeLicentele() {
	foreach(Player,i) {
		if(IsPlayerLogged[i] == 1) {
			if(PlayerInfo[i][pCarLicT] > 0) PlayerInfo[i][pCarLicT] -= 1;
			if(PlayerInfo[i][pFlyLicT] > 0) PlayerInfo[i][pFlyLicT] -= 1;
			if(PlayerInfo[i][pBoatLicT] > 0) PlayerInfo[i][pBoatLicT] -= 1;
			if(PlayerInfo[i][pFishLicT] > 0) PlayerInfo[i][pFishLicT] -= 1;
			if(PlayerInfo[i][pGunLicT] > 0) {
				PlayerInfo[i][pGunLicT] -= 1;
				if(PlayerInfo[i][pGunLicT] == 0) ResetWeapons(i);
			}
			if(PlayerInfo[i][pCarLic] == 1 && PlayerInfo[i][pCarLicT] == 0) PlayerInfo[i][pCarLic] = 0;
			if(PlayerInfo[i][pFlyLic] == 1 && PlayerInfo[i][pFlyLicT] == 0) PlayerInfo[i][pFlyLic] = 0;
			if(PlayerInfo[i][pBoatLic] == 1 && PlayerInfo[i][pBoatLicT] == 0) PlayerInfo[i][pBoatLic] = 0;
			if(PlayerInfo[i][pFishLic] == 1 && PlayerInfo[i][pFishLicT] == 0) PlayerInfo[i][pFishLic] = 0;
			if(PlayerInfo[i][pGunLic] == 1 && PlayerInfo[i][pGunLicT] == 0) PlayerInfo[i][pGunLic] = 0;

			if(PlayerInfo[i][pRob] < 20)  PlayerInfo[i][pRob]++;
			if(PlayerInfo[i][pFpunish] > 0) PlayerInfo[i][pFpunish]--;
			if(PlayerInfo[i][pCarLicS] > 0) PlayerInfo[i][pCarLicS] --;
			if(PlayerInfo[i][pGunLicS] > 0) PlayerInfo[i][pGunLicS] --;
			if(PlayerInfo[i][pFlyLicS] > 0) PlayerInfo[i][pFlyLicS] --;
			if(PlayerInfo[i][pBoatLicS] > 0) PlayerInfo[i][pBoatLicS] --;
			if(IsACop(i)) {
				if(PlayerInfo[i][pLawyer] < 10) PlayerInfo[i][pLawyer] += 1;
			}
		}
	}
	return 1;
}
stock GetWeaponNameEx(id, name[], len) return format(name,len, "%s", GunNames[id]);
stock RemovePlayerWeapon(playerid, weaponid);
public RemovePlayerWeapon(playerid, weaponid) {
	new plyWeapons[12] = 0, plyAmmo[12] = 0;
	for(new sslot = 0; sslot != 12; sslot++) {
		new wep, ammo;
		GetPlayerWeaponData(playerid, sslot, wep, ammo);
		if(wep != weaponid && ammo != 0) GetPlayerWeaponData(playerid, sslot, plyWeapons[sslot], plyAmmo[sslot]);
	}
	ResetWeapons(playerid);
	for(new sslot = 0; sslot != 12; sslot++) {
	    if(plyAmmo[sslot] != 0) ServerWeapon(playerid, plyWeapons[sslot], plyAmmo[sslot]);
	}
	return 1;
}

function OnPlayerRegister(playerid, password[]) {
	new Str[200];
	mysql_format(SQL, Str, 200, "INSERT INTO `users` (`name`, `password`) VALUES ('%s','%e')",GetName(playerid), password);
	mysql_tquery(SQL, Str, "", "");
	format(PlayerInfo[playerid][pKey], 128, password);
	Cash[playerid] = 0;
	ShowPlayerDialogEx(playerid, DIALOG_LOGIN2,DIALOG_STYLE_PASSWORD,"Login", "Contul tau a fost inregistrat cu succes!\n\nIntrodu parola din nou in casuta de mai jos.", "Login","Quit");
	kickLogin[playerid] = SetTimerEx("LoginTimer", 30000, false, "d", playerid);
	PlayerInfo[playerid][pShowLogo] = 1;
	PlayerInfo[playerid][pShowCeas] = 1;
	PlayerInfo[playerid][pShowJob] = 1;
	return 1;
}


public OnPlayerStateChange(playerid, newstate, oldstate) {
	new string[128];
	new vehicleid = GetPlayerVehicleID(playerid);
	if(newstate == PLAYER_STATE_DRIVER)
	{
		if((GetTickCount()-GetPVarInt(playerid, "cartime")) < 1000)
		{
			SetPVarInt(playerid, "carspam", GetPVarInt(playerid, "carspam")+1);
			if(GetPVarInt(playerid, "carspam") >= 2)
			{
				NightBot(playerid, "Car Warp #1");
			}
		}
		SetPVarInt(playerid, "cartime", GetTickCount());
	}
	if(newstate == PLAYER_STATE_ONFOOT) {
		if(InExamen[playerid] == 1) FailExamen(playerid);
		if(TaxiDriver[playerid] != -1) {
		    if(TaxiMoney[playerid] != 0) {
				if(TaxiMoney[playerid] >= 100) {
					UpdateFactionRaport(TaxiDriver[playerid], 0);
				}
				AcceptedService[TaxiDriver[playerid]] = -1;
				foreach(new i: inRangePlayers[playerid]) {
					if(IsNearPlayer(playerid, i)) {
						format(string, sizeof(string), "* %s a platit taximetristului %s suma de $%s pentru cursa efectuata.", GetName(playerid), GetName(TaxiDriver[playerid]), FormatNumber(TaxiMoney[playerid]));
						SCM(i, COLOR_PURPLE, string);

					}
				}
		        TaxiMoney[playerid] = 0;
		    }
	        TaxiDriver[playerid] = -1;
		    PlayerTextDrawHide(playerid, FareTD);
			KillTimer(TaxiTimer[playerid]);
			PlayerTextDrawHide(playerid, FareTD);
			PlayerTextDrawHide(playerid, Speedo[0]);
			PlayerTextDrawHide(playerid, Speedo[1]);
			PlayerTextDrawHide(playerid, Speedo[2]);
		}

		if(TaxiDuty[playerid] == 1) {
			Fare[playerid] = 0;
			TaxiDriver[playerid] = -1;
			TaxiDuty[playerid] = 0;
			PlayerTextDrawHide(playerid, FareTD);
			foreach(Player, i) {
			    if(TaxiDriver[i] == playerid) {
					PlayerTextDrawHide(i, FareTD);
					TaxiDriver[i] = -1;
					TaxiMoney[i] = 0;
			    }
			}
			format(string, sizeof(string), "Acum nu mai esti la datorie si ai primit $%s, banii facuti de tine.", FormatNumber(TaxiMoney[playerid]));
			SCM(playerid, COLOR_WHITE, string);
			GivePlayerCash(playerid, TaxiMoney[playerid]);
			TaxiMoney[playerid] = 0;
		}

		if(Helmet[playerid] == 1) {
			Helmet[playerid] = 0;
			format(string, sizeof(string), "* %s si-a scos casca de pe cap.", GetName(playerid));
			ProxDetectorLNX(30.0, playerid, string, COLOR_PURPLE);
			RemovePlayerAttachedObject(playerid, 3);
		}

		if(InDealer[playerid] >= 1 && TestingModel[playerid] == 1) {
			DestroyVehicle(DealerCar[playerid]);
			InDealer[playerid] = 0, DealerCarType[playerid] = -1, DealerCar[playerid] = 0;
			KillTimer(DSTimer[playerid]);
			SCM(playerid, COLOR_WHITE, "Testul auto a fost suspendat.");
			SetPlayerPosEx(playerid, -1656.5940,1210.4667,7.2500);
			SetPlayerInterior(playerid, 0);
			SetPlayerVirtualWorld(playerid, 0);
			TestingModel[playerid] = 0;
		}

		// if(oldstate == PLAYER_STATE_DRIVER) {
			// new carid = FindSpawnID(gLastCar[playerid]);
			// if(carid != 0) VehicleTimer[gLastCar[playerid]] = SetTimerEx("DespawnVehicle", 60000*20, 0, "d", gLastCar[playerid]);
		// }

		if(oldstate == PLAYER_STATE_DRIVER || oldstate == PLAYER_STATE_PASSENGER) {
			foreach(Player, i) {
				if(Spectate[i] == playerid) {
					if(IsPlayerInAnyVehicle(playerid)) {
						new carid = GetPlayerVehicleID(playerid);
						PlayerSpectateVehicle(i, carid);
					}
					else PlayerSpectatePlayer(i, playerid);
				}
			}
		 	StopAudioStreamForPlayer(playerid);
			PlayerTextDrawHide(playerid, Speedo[0]);
  			PlayerTextDrawHide(playerid, Speedo[1]);
   			PlayerTextDrawHide(playerid, Speedo[2]);
			PlayerTextDrawHide(playerid, FareTD);
		}
		if(JobWorking4[playerid] == 1 && gLastCar[playerid] == DrugsCar[playerid]) {
				JobLeftTime[playerid] = 120;
				SCM(playerid, COLOR_YELLOW, "Ai la dispozitie 2 minute sa intri inapoi in vehiculul de la job.");
		}
		if(JobWorking2[playerid] == 1 && gLastCar[playerid] == FarmerCar[playerid]) {
				JobLeftTime[playerid] = 120;
				SCM(playerid, COLOR_YELLOW, "Ai la dispozitie 2 minute sa intri inapoi in vehiculul de la job.");
		}
		if(JobWorking3[playerid] == 1 && gLastCar[playerid] == PizzaCar[playerid]) {
				JobLeftTime[playerid] = 70;
				SCM(playerid, COLOR_YELLOW, "Ai la dispozitie 1 minut si 10 secunde sa intri inapoi in vehiculul de la job.");
		}
		if(JobWorking[playerid] == 1 && gLastCar[playerid] == JobVehicle[playerid]) {
			if(PlayerInfo[playerid][pJob] == 1 || PlayerInfo[playerid][pJob] == 3 || PlayerInfo[playerid][pJob] == 8) {
				SCM(playerid, COLOR_WHITE, "Job esuat deoarece ai parasit vehiculul.");
				if(playerObject[playerid] != 0) DestroyPlayerObject(playerid, playerObject[playerid]), playerObject[playerid] = 0;
				if(playerObject2[playerid] != 0) DestroyObject(playerObject2[playerid]), playerObject2[playerid] = 0;
				JobWorking[playerid] = 0;
				SetPlayerSpecialAction(playerid, 0);
				JobWorking2[playerid] = 0;
				PlayerTextDrawHide(playerid, JobTD);
				if(JobVehicle[playerid] != 0) { DestroyVehicle(JobVehicle[playerid]); JobVehicle[playerid] = 0; }
				if(Trailer[playerid] != 0) { DestroyVehicle(Trailer[playerid]); Trailer[playerid] = 0;  }
				if(JobWorking2[playerid] != 0) { DestroyVehicle(FarmerCar[playerid]); }
				PlayerTextDrawHide(playerid, InfosTD);
				DisablePlayerCheckpointEx(playerid);
				DisablePlayerRaceCheckpointEx(playerid);
				CP[playerid] = 0;
				JobVehicle[playerid] = 0;
				RemovePlayerAttachedObject(playerid, 2);
				RemovePlayerAttachedObject(playerid, 6);
			}
			else {
				JobLeftTime[playerid] = 120;
				SCM(playerid, COLOR_YELLOW, "Ai la dispozitie 2 minute sa intri inapoi in vehiculul de la job.");
			}
		}
	}
	if(newstate == PLAYER_STATE_PASSENGER) {
		foreach(new i: inRangePlayers[playerid]) {
            if(IsPlayerInVehicle(i, vehicleid) && GetPlayerState(i) == 2 && TaxiDuty[i] == 1) {
				if(GetPlayerCash(playerid) < Fare[i]) {
		            format(string, sizeof(string), "Nu ai $%d pentru a intra in acest taxi.", Fare[i]);
    		 		SCM(playerid, COLOR_GREY, string);
    		 		RemovePlayerFromVehicle(playerid);
				}
				else {
					TaxiDriver[playerid] = i;
					TaxiMoney[playerid] = 0;
					SetPVarInt(playerid, "TaxiVeh", vehicleid);
                    TaxiTimer[playerid] = SetTimerEx("UpdateFare", 10000, true, "i", playerid);
                    UpdateTaxiTextdraw(playerid);
				}
			}
		}

		if(OnDuty[playerid] == 0) SetPlayerArmedWeapon(playerid,0);
		if(CarRadio[GetPlayerVehicleID(playerid)] != 0) {
			PlayRadio[playerid] = CarRadio[GetPlayerVehicleID(playerid)];
			if(CarRadio[GetPlayerVehicleID(playerid)] == sizeof(RadioLink)) YoutubeStreamForPlayer(playerid, CarLink[GetPlayerVehicleID(playerid)]);
			else PlayAudioStreamForPlayer(playerid, RadioLink[CarRadio[GetPlayerVehicleID(playerid)]]);
		}

		foreach(Player, i) {
			if(Spectate[i] == playerid) {
				// TogglePlayerSpectating(i, 1);
				if(IsPlayerInAnyVehicle(playerid)) {

					new carid = GetPlayerVehicleID(playerid);
					PlayerSpectateVehicle(i, carid);
				}
				else PlayerSpectatePlayer(i, playerid);
			}
		}

        new gun,tmp;
        GetPlayerWeaponData(playerid,5,gun,tmp);
        #pragma unused tmp
        if(gun)SetPlayerArmedWeapon(playerid,gun);
        else SetPlayerArmedWeapon(playerid,0);
	    return 1;
	}
	if(newstate == PLAYER_STATE_DRIVER) {
		new vehicle = GetVehicleID(GetPlayerVehicleID(playerid)), result;
		if(JobWorking[playerid] == 1 && JobVehicle[playerid] == GetPlayerVehicleID(playerid)) JobLeftTime[playerid] = 0;
		if(JobWorking2[playerid] == 1 && FarmerCar[playerid] == GetPlayerVehicleID(playerid)) JobLeftTime[playerid] = 0;
		if(JobWorking3[playerid] == 1 && PizzaCar[playerid] == GetPlayerVehicleID(playerid)) JobLeftTime[playerid] = 0;
		if(JobWorking4[playerid] == 1 && DrugsCar[playerid] == GetPlayerVehicleID(playerid)) JobLeftTime[playerid] = 0;

		if(OnDuty[playerid] == 0) SetPlayerArmedWeapon(playerid,0);
		if(CarRadio[GetPlayerVehicleID(playerid)] != 0) {
			PlayRadio[playerid] = CarRadio[GetPlayerVehicleID(playerid)];
			if(CarRadio[GetPlayerVehicleID(playerid)] == sizeof(RadioLink)) YoutubeStreamForPlayer(playerid, CarLink[GetPlayerVehicleID(playerid)]);
			else PlayAudioStreamForPlayer(playerid, RadioLink[CarRadio[GetPlayerVehicleID(playerid)]]);
		}

		foreach(Player, i) {
			if(Spectate[i] == playerid) {
				TogglePlayerSpectating(i, 1);
				if(IsPlayerInAnyVehicle(playerid)) PlayerSpectateVehicle(i, GetPlayerVehicleID(playerid));
				else PlayerSpectatePlayer(i, playerid);
			}
		}
		// new carid = FindSpawnID(vehicleid);
		if(ServerVehicles[vehicle][vID] != 0 && result == 0) {
			if(ServerVehicles[vehicle][vFaction] == 1 || ServerVehicles[vehicle][vFaction] == 2 || ServerVehicles[vehicle][vFaction] == 3) {
				if(!IsACop(playerid)) {
					format(string, sizeof(string), "Nu faci parte din factiunea %s.", FactionName(ServerVehicles[vehicle][vFaction]));
					SCM(playerid, COLOR_GREY, string);
					SlapPlayer(playerid);
				}
				else if(ServerVehicles[vehicle][vRank] > PlayerInfo[playerid][pRank]) {
		            format(string, sizeof(string), "Ai nevoie de rank %d pentru a lua acest vehicul.", ServerVehicles[vehicle][vRank]);
					SCM(playerid, COLOR_GREY, string);
			        SlapPlayer(playerid);
			    }
				else if(OnDuty[playerid] == 0 && IsACop(playerid)) {
					SCM(playerid, COLOR_LGREEN, "Nu poti folosi vehiculele factiunii daca nu esti la datorie!");
					SlapPlayer(playerid);
					return 1;
				}
			}
			else if(ServerVehicles[vehicle][vFaction] != PlayerInfo[playerid][pMember] && ServerVehicles[vehicle][vFaction] != 0) {
	            format(string, sizeof(string), "Nu faci parte din factiunea %s.", FactionName(ServerVehicles[vehicle][vFaction]));
				SCM(playerid, COLOR_GREY, string);
				SlapPlayer(playerid);
		    }
		    else {
				if(OnDuty[playerid] == 0 && IsACop(playerid) && Copcar2(vehicle)) {
					SCM(playerid, COLOR_LGREEN, "Nu poti folosi vehiculele factiunii daca nu esti la datorie!");
					SlapPlayer(playerid);
					return 1;
				}
				if(ServerVehicles[vehicle][vRank] > PlayerInfo[playerid][pRank]) {
		            format(string, sizeof(string), "Ai nevoie de rank %d pentru a lua acest vehicul.", ServerVehicles[vehicle][vRank]);
					SCM(playerid, COLOR_GREY, string);
			        SlapPlayer(playerid);
			    }
		    }
		}


		new carid = VehicleSQL[vehicleid];
		if(carid != 0) {

			SCMf(playerid, COLOR_WHITE, "This %s (ID %d)%sis owned by %s | Odometer: %.2f km | Days: %d | Insurance $%s (%d points)",
			aVehicleNames[CarInfo[carid][cModel]-400],
			CarInfo[carid][cID],
			(CarInfo[carid][cVip]) ? (" (VIP Vehicle) "):(" "),
			CarInfo[carid][cOwner],
			CarInfo[carid][KM],
			GetVehicleDays(carid),
			FormatNumber(CarInfo[carid][cTax]),
			CarInfo[carid][cPoints]);

			if(Iter_Contains(personalCars[playerid], carid)) {
				if(CarInfo[carid][cPoints] == 0) {
					SCM(playerid, COLOR_GREY, "Nu ai platit asigurarea! Ca s-o platesti, foloseste comanda /cars > Vehicul > Asigurare.");
					new engine,lights,alarm,doors,bonnet,boot,objective;
					GetVehicleParamsEx(vehicleid,engine,lights,alarm,doors,bonnet,boot,objective);
					SetVehicleParamsEx(vehicleid,VEHICLE_PARAMS_OFF,lights,alarm,doors,bonnet,boot,objective);
					vehEngine[vehicleid] = 0;
				}
			}
			else {
				if(CarInfo[carid][cPoints] == 0) {
					SCM(playerid, COLOR_GREY, "Acest vehicul nu are asigurarea platita!");
					new engine,lights,alarm,doors,bonnet,boot,objective;
					GetVehicleParamsEx(vehicleid,engine,lights,alarm,doors,bonnet,boot,objective);
					SetVehicleParamsEx(vehicleid,VEHICLE_PARAMS_OFF,lights,alarm,doors,bonnet,boot,objective);
					vehEngine[vehicleid] = 0;
				}
			}
		}

	    if(!IsABoat(vehicleid)) PlayerEnterTime[playerid] = GetTickCount();
		new engine,lights,alarm,doors,bonnet,boot,objective;
	    if(vehEngine[vehicleid] == 0) {
			GetVehicleParamsEx(vehicleid,engine,lights,alarm,doors,bonnet,boot,objective);
		    SetVehicleParamsEx(vehicleid,VEHICLE_PARAMS_OFF,lights,alarm,doors,bonnet,boot,objective);
		}
		else if(vehEngine[vehicleid] == 1) {
			GetVehicleParamsEx(vehicleid,engine,lights,alarm,doors,bonnet,boot,objective);
			SetVehicleParamsEx(vehicleid,VEHICLE_PARAMS_ON,lights,alarm,doors,bonnet,boot,objective);
		}
		if(Gas[vehicleid] == 0) {
	        NoFuel[playerid] = 1;
		}
		if(IsABoat(vehicleid) == -1) {
		    if(PlayerInfo[playerid][pBoatLic] < 1 && InDealer[playerid] == 0) {
			    SCM(playerid,COLOR_GREY, "Nu ai licenta de navigatie.");
			    SlapPlayer(playerid);
			    TogglePlayerControllable(playerid, 1);
			}
		}
		else if(IsAPlane(vehicleid) == -1) {
		    if(PlayerInfo[playerid][pFlyLic] < 1 && InDealer[playerid] == 0) {
			    SCM(playerid, COLOR_GREY, "Nu ai licenta de zbor.");
			    SlapPlayer(playerid);
				TogglePlayerControllable(playerid, 1);
			}
		}
		else {
			if(PlayerInfo[playerid][pCarLic] < 1) {
			    if(IsABike2(vehicleid) || InExamen[playerid] == 1 || GetVehicleModel(vehicleid) == 471 || InDealer[playerid] > 0) { }
			    else {
				 	SCM(playerid,COLOR_GREY, "Nu ai licenta de condus.");
	                SlapPlayer(playerid);
	                TogglePlayerControllable(playerid, 1);
					SetTimerEx("UnFreezeStation", 500, 0, "i", playerid);
				}
			}
		}
		if(IsABike2(vehicleid)) {
            TogglePlayerControllable(playerid, 1);
            vehEngine[vehicleid] = 1;
            GetVehicleParamsEx(vehicleid,engine,lights,alarm,doors,bonnet,boot,objective);
		    SetVehicleParamsEx(vehicleid,VEHICLE_PARAMS_ON,lights,alarm,doors,bonnet,boot,objective);
		}
		gLastCar[playerid] = vehicleid;
		gLastDriver[vehicleid] = playerid;
	}
	return 1;
}

function CarCheck() {
	foreach(Player,j) {
		new Float:health;
		GetPlayerHealthEx(j, health);
		if(AFKSeconds[j] < 30) SetPlayerHealthEx(j, health - 1);
	}
	return 1;
}

public OnRconLoginAttempt(ip[], password[], success) {
	new string[128], pip[16];

	foreach(Player, i) {
		if(IsPlayerLogged[i] == 1) {
			GetPlayerIp(i, pip, sizeof(pip));
			if(!strcmp(ip, pip, true)) {
				if(!strcmp(GetName(i), "Catalin", true) || !strcmp(GetName(i), "ERARPG", true)) return 1;
				else {
					format(string, sizeof(string), "AdmWarning: %s(%d) a primit kick deoarece a introdus parola RCON invalida.",GetName(i),i,ip);
					SendAdminMessage(COLOR_WARNING, string,5);
					KickEx(i);
					return 1;
				}
			}
		}
	}
    return 1;
}

public OnPlayerExitVehicle(playerid, vehicleid) {
	if(InExamen[playerid] == 1) FailExamen(playerid);

	PlayRadio[playerid] = 0;
    DisableRemoteVehicleCollisions(playerid, 0);
	LastCar[playerid] = 0;
	Speedlimit[playerid] = 0;



	if(InDealer[playerid] >= 1) {
		DestroyVehicle(DealerCar[playerid]);
		InDealer[playerid] = 0, DealerCarType[playerid] = -1, DealerCar[playerid] = 0;
		KillTimer(DSTimer[playerid]);
		SCM(playerid, COLOR_WHITE, "Testul auto a fost suspendat.");
		SetPlayerPosEx(playerid, -1656.5940,1210.4667,7.2500);
		SetPlayerInterior(playerid, 0);
		SetPlayerVirtualWorld(playerid, 0);
		TestingModel[playerid] = 0;
    }
	return 1;
}
public OnPlayerRequestSpawn(playerid) {
    return 1;
}

public OnPlayerRequestClass(playerid, classid) {
	if(IsPlayerLogged[playerid] == 1) SpawnPlayer(playerid);
	return 1;
}

public OnEnterExitModShop(playerid, enterexit, interiorid) {
    if(enterexit == 0) {
		if(IsPlayerInRangeOfPoint(playerid,1,617.536071, -1.990000, 1000.657775)) {
			if(GetPlayerCash(playerid) >= BizzInfo[29][bFee]) {
				GivePlayerCash(playerid,-BizzInfo[29][bFee]);
				BizzInfo[29][bBalance] += BizzInfo[29][bFee];
			}
		}
    }
    return 1;
}

public OnPlayerEditObject(playerid, playerobject, objectid, response, Float:fX, Float:fY, Float:fZ, Float:fRotX, Float:fRotY, Float:fRotZ) {
	new Float:oldX, Float:oldY, Float:oldZ, Float:oldRotX, Float:oldRotY, Float:oldRotZ;
	GetDynamicObjectPos(objectid, oldX, oldY, oldZ);
	GetDynamicObjectRot(objectid, oldRotX, oldRotY, oldRotZ);

	if(response == EDIT_RESPONSE_FINAL) {
		if(EditHouse[playerid] == 1) {
		    new szQuery[256];
			mysql_format(SQL, szQuery, sizeof(szQuery), "INSERT INTO `fobjects` (`House`) VALUES ('0')");
			new Cache: result = mysql_query(SQL, szQuery);
			new i = cache_insert_id();
			cache_delete(result);
			format(FurnitureInfo[i][fiName], 64, "No name");
			FurnitureInfo[i][fiModel] = EditModel[playerid];
			FurnitureInfo[i][fiX] = fX;
			FurnitureInfo[i][fiY] = fY;
			FurnitureInfo[i][fiZ] = fZ;
			FurnitureInfo[i][fiRotX] = fRotX;
			FurnitureInfo[i][fiRotY] = fRotY;
			FurnitureInfo[i][fiRotZ] = fRotZ;
			FurnitureInfo[i][fiVirtual] = GetPlayerVirtualWorld(playerid);
			FurnitureInfo[i][fiHouse] = PlayerInfo[playerid][pHouse];
			SaveObject(i);
			DestroyDynamicObject(ObjectEdited[playerid]);
			FurnitureInfo[i][fiObject] = CreateDynamicObject(FurnitureInfo[i][fiModel], FurnitureInfo[i][fiX], FurnitureInfo[i][fiY], FurnitureInfo[i][fiZ], FurnitureInfo[i][fiRotX], FurnitureInfo[i][fiRotY], FurnitureInfo[i][fiRotZ], FurnitureInfo[i][fiVirtual], -1, -1, 200.0);
			SCM(playerid, COLOR_YELLOW, "Obiectul a fost creat! Acesta a costat $1,000.");
			BizzInfo[18][bBalance] += 1000;
            if(PlayerInfo[playerid][pPremiumAccount] == 0) format(szQuery, sizeof(szQuery), "Stare obiecte: %d/50",  GetHouseObjects(PlayerInfo[playerid][pHouse]));
			else format(szQuery, sizeof(szQuery), "Stare obiecte: %d/100", GetHouseObjects(PlayerInfo[playerid][pHouse]));
            SCM(playerid, COLOR_YELLOW, szQuery);
			GivePlayerCash(playerid, -1000);
			EditHouse[playerid] = 0;
		}
		else if(EditHouse[playerid] == 2) {
		    new i = EditedObjectID[playerid];
			FurnitureInfo[i][fiX] = fX;
			FurnitureInfo[i][fiY] = fY;
			FurnitureInfo[i][fiZ] = fZ;
			FurnitureInfo[i][fiRotX] = fRotX;
			FurnitureInfo[i][fiRotY] = fRotY;
			FurnitureInfo[i][fiRotZ] = fRotZ;
			FurnitureInfo[i][fiVirtual] = GetPlayerVirtualWorld(playerid);
			FurnitureInfo[i][fiHouse] = PlayerInfo[playerid][pHouse];
			DestroyDynamicObject(FurnitureInfo[i][fiObject]);//
			FurnitureInfo[i][fiObject] = CreateDynamicObject(FurnitureInfo[i][fiModel], FurnitureInfo[i][fiX], FurnitureInfo[i][fiY], FurnitureInfo[i][fiZ], FurnitureInfo[i][fiRotX], FurnitureInfo[i][fiRotY], FurnitureInfo[i][fiRotZ], FurnitureInfo[i][fiVirtual], -1, -1, 200.0);
	        SaveObject(i);
	        SCM(playerid, COLOR_YELLOW, "Obiectul a fost editat cu succes!");
			EditHouse[playerid] = 0;
		}
	}
	if(response == EDIT_RESPONSE_CANCEL) {
	    if(EditHouse[playerid] == 1) DestroyDynamicObject(ObjectEdited[playerid]), SCM(playerid, -1, "Ai anulat!"), EditHouse[playerid] = 0;
	    if(EditHouse[playerid] == 2) SCM(playerid, -1, "Ai anulat!"), EditHouse[playerid] = 0;
	}
	return 1;
}

stock SaveObject(const id) {
	new szQuery[1024];
	format(szQuery, sizeof(szQuery), "UPDATE `fobjects` SET `Model`='%d', `X`='%f', `Y`='%f', `Z`='%f', `RotX`='%f', `RotY`='%f', `RotZ`='%f', `Virtual`='%d', `House`='%d' WHERE `ID`='%d'",
	FurnitureInfo[id][fiModel], FurnitureInfo[id][fiX], FurnitureInfo[id][fiY], FurnitureInfo[id][fiZ], FurnitureInfo[id][fiRotX], FurnitureInfo[id][fiRotY], FurnitureInfo[id][fiRotZ], FurnitureInfo[id][fiVirtual], FurnitureInfo[id][fiHouse], id);
	mysql_tquery(SQL, szQuery, "", "");
	return 1;
}
function LoadFurnitures() {
	new objects = 0, x, result[64], r;
	cache_get_row_count(r);

 	for(new i = 0; i != r; ++i) {
	    objects ++;
       	cache_get_value_name_int(i, "ID", x);

		cache_get_value_name(i, "Name", result);
		format(FurnitureInfo[x][fiName], 64, result);

       	cache_get_value_name_int(i, "Model", FurnitureInfo[x][fiModel]);
       	cache_get_value_name_float(i, "X", FurnitureInfo[x][fiX]);
     	cache_get_value_name_float(i, "Y", FurnitureInfo[x][fiY]);
      	cache_get_value_name_float(i, "Z", FurnitureInfo[x][fiZ]);
       	cache_get_value_name_float(i, "RotX", FurnitureInfo[x][fiRotX]);
       	cache_get_value_name_float(i, "RotY", FurnitureInfo[x][fiRotY]);
       	cache_get_value_name_float(i, "RotZ", FurnitureInfo[x][fiRotZ]);
       	cache_get_value_name_int(i, "Virtual", FurnitureInfo[x][fiVirtual]);
	   	cache_get_value_name_int(i, "House", FurnitureInfo[x][fiHouse]);

        FurnitureInfo[x][fiObject] = CreateDynamicObject(FurnitureInfo[x][fiModel], FurnitureInfo[x][fiX], FurnitureInfo[x][fiY], FurnitureInfo[x][fiZ], FurnitureInfo[x][fiRotX], FurnitureInfo[x][fiRotY], FurnitureInfo[x][fiRotZ], FurnitureInfo[x][fiVirtual], -1, -1, 200.0);
	}
	printf("Furnitures: %d", objects);
	return 1;
}

public OnPlayerKeyStateChange(playerid, newkeys, oldkeys) {
	if(!IsPlayerConnected(playerid)) return 1;
	new string[180];
	new engine,lights,alarm,doors,bonnet,boot,objective;

	if(newkeys & KEY_SECONDARY_ATTACK) {
		if(GetPlayerState(playerid) == PLAYER_STATE_ONFOOT) {

			foreach(new carid: personalCars[playerid]) {
				if(CarInfo[carid][Spawned] != 0) {
					new v = CarInfo[carid][Spawned], Float: p1, Float: p2, Float: p3;
					GetVehiclePos(v, p1, p2, p3);
					if(IsPlayerInRangeOfPoint(playerid, 8.0, p1, p2, p3)) SetVehicleParamsForPlayer(v, playerid, 0, 0);
				}
			}

			if(UsedFly{playerid}) {
				StopFly(playerid);
				UsedFly{playerid} = false;
				SetPlayerHealthEx(playerid, 99);
				SCM(playerid, 0xFFADADFF, "Fly mode off.");
			}

			if(InHQ[playerid] == 0) {
				for(new i = 1; i < 18; i++) {
					if(IsPlayerInRangeOfPoint(playerid, 2.0, DynamicFactions[i][extX], DynamicFactions[i][extY], DynamicFactions[i][extZ])) {
						if(PlayerInfo[playerid][pMember] == i || i < 3 || DynamicFactions[i][fLock] == 1 || OnDuty[playerid] == 1) return EnterFaction(playerid, i);
					}
				}
			}
			else {
				new i = InHQ[playerid];
				if(IsPlayerInRangeOfPoint(playerid, 2.0, DynamicFactions[i][fcX], DynamicFactions[i][fcY], DynamicFactions[i][fcZ])) {
					if(DynamicFactions[i][fVW] == GetPlayerVirtualWorld(playerid) && DynamicFactions[i][fInterior] == GetPlayerInterior(playerid)) return ExitFaction(playerid, i);
				}
			}

			if(nearHouse[playerid] != -1) {
				new i = nearHouse[playerid];
				if(IsPlayerInRangeOfPoint(playerid,2,HouseInfo[i][hEntrancex], HouseInfo[i][hEntrancey], HouseInfo[i][hEntrancez]))
				{
					if(GetPlayerVirtualWorld(playerid) != 0) return SCM(playerid, -1, "Nu poti intra intr-o afacere deoarece te afli intr-un alt virtual world.");
					if(PlayerInfo[playerid][pHouse] == i || HouseInfo[i][hLock] == 0 || OnDuty[playerid] == 1 || PlayerHit[playerid] != -1) {
						if(GetPVarInt(playerid, "LocationEnter") > gettime()) return SCMf(playerid, -1, "Asteapta %d secunde!", GetPVarInt(playerid, "LocationEnter") - gettime());
						SetPlayerPosEx(playerid,HouseInfo[i][hExitx],HouseInfo[i][hExity],HouseInfo[i][hExitz]);
						SetPlayerInterior(playerid,HouseInfo[i][hInterior]);
						PlayerInfo[playerid][pInt] = HouseInfo[i][hInterior];
						PlayerInfo[playerid][pLocal] = i;
						SetPlayerVirtualWorld(playerid,HouseInfo[i][hVirtual]);
						InHouse[playerid] = i;
						SetPVarInt(playerid, "LocationEnter", gettime() + 10);
						HouseRadio(playerid, i);
						nearHouse[playerid] = -1;
					}
					else GameTextForPlayer(playerid, "~r~~h~Inchis", 1000, 1);
				}
				return true;
			}

			if(InHouse[playerid] != 0) {
				new i = InHouse[playerid];
				if(EditHouse[playerid] != 0) return 1;
				if(PlayerInfo[playerid][pSleeping] == 1) return 1;
				if(IsPlayerInRangeOfPoint(playerid, 2,HouseInfo[i][hExitx], HouseInfo[i][hExity], HouseInfo[i][hExitz]) && HouseInfo[i][hVirtual] == GetPlayerVirtualWorld(playerid)) {

					SetPlayerInterior(playerid,0);
					SetPlayerPosEx(playerid,HouseInfo[i][hEntrancex],HouseInfo[i][hEntrancey],HouseInfo[i][hEntrancez]);
					InHouse[playerid] = 0;
					PlayRadio[playerid] = 0;
					StopAudioStreamForPlayer(playerid);

					new f = PlayerInfo[playerid][pMember];
					if(factionWar[f] != -1) {
						new turf = WarsStatistics[factionWar[f]][wTurfid];
						SetPlayerVirtualWorld(playerid, turf);
					}
					else SetPlayerVirtualWorld(playerid,0);

					return 1;
				}
			}

			if(InBussines[playerid] == 0) {
				for(new i = 1; i < sizeof(BizzInfo); i++) {
					if(IsPlayerInRangeOfPoint(playerid,2,BizzInfo[i][bEntranceX], BizzInfo[i][bEntranceY], BizzInfo[i][bEntranceZ]) && BizzInfo[i][bStatic] == 0) {
						if(GetPVarInt(playerid, "LocationEnter") > gettime()) return SCMf(playerid, -1, "Asteapta %d secunde!", GetPVarInt(playerid, "LocationEnter") - gettime());
						if(GetPlayerVirtualWorld(playerid) != 0) return SCM(playerid, -1, "Nu poti intra intr-o afacere deoarece te afli intr-un alt virtual world.");
						if(GetPlayerCash(playerid) < BizzInfo[i][bFee]) return GameTextForPlayer(playerid, "~r~~h~Nu ai destui bani", 1000, 1);
						if(OnDuty[playerid] == 1 || PlayerHit[playerid] != -1) { }
						else if(BizzInfo[i][bLocked] == 1) return GameTextForPlayer(playerid, "~r~~h~Inchis", 1000, 1);

						switch(BizzInfo[i][bType]) {
							case 1: SCM(playerid,COLOR_WHITE,"Comenzi disponibile: /withdraw, /transfer, /deposit, /balance.");
							case 9: SCM(playerid,COLOR_WHITE,"Comenzi disponibile: /dice.");
							case 8, 21: SCM(playerid,COLOR_WHITE,"Comenzi disponibile: /eat.");
							case 2: SCM(playerid,COLOR_WHITE,"Apasa Y pentru a cumpara arme.");
							case 3: SCM(playerid,COLOR_WHITE,"Comenzi disponibile: /drink.");
							case 5: SCM(playerid,COLOR_WHITE,"Apasa Y pentru a continua.");
							case 6, 20: SCM(playerid,COLOR_WHITE,"Apasa Y pentru a continua.");
							case 7: SCM(playerid,COLOR_WHITE,"Comenzi disponibile: /clothes, /glasses, /buyhat.");
						}

						SetPVarInt(playerid, "LocationEnter", gettime() + 10);
						GivePlayerCash(playerid,-BizzInfo[i][bFee]);
						BizzInfo[i][bBalance] += BizzInfo[i][bFee];
						BizzRadio(playerid, i);
						if(BizzInfo[i][bStatic] == 0) {
							SetPlayerInterior(playerid,BizzInfo[i][bInterior]);
							SetPlayerPosEx(playerid,BizzInfo[i][bExitX],BizzInfo[i][bExitY],BizzInfo[i][bExitZ]);
							PlayerInfo[playerid][pInt] = BizzInfo[i][bInterior];
							PlayerInfo[playerid][pLocal] = i+99;
							SetPlayerVirtualWorld(playerid,BizzInfo[i][bVirtual]);
							InBussines[playerid] = i;
							new str1[70];
							mysql_format(SQL, str1, 70, "UPDATE `bizz` SET `Till`='%d' WHERE `ID`='%d'",BizzInfo[i][bBalance],i);
							mysql_tquery(SQL, str1, "", "");
							format(str1, sizeof(str1), "~r~-$%d", BizzInfo[i][bFee]);
							GameTextForPlayer(playerid, str1, 1000, 1);
						}
						return 1;
					}
				}
			}
			else {
				if(PlayerInfo[playerid][pSleeping] == 1) return 1;
				new i = InBussines[playerid];
				if(IsPlayerInRangeOfPoint(playerid, 2,BizzInfo[i][bExitX], BizzInfo[i][bExitY], BizzInfo[i][bExitZ]) && BizzInfo[i][bVirtual] == GetPlayerVirtualWorld(playerid)) {
					SetPlayerInterior(playerid,0);
					SetPlayerPosEx(playerid,BizzInfo[i][bEntranceX],BizzInfo[i][bEntranceY],BizzInfo[i][bEntranceZ]);
					if(i == 27) {
						TogglePlayerControllable(playerid, 0);
						SetTimerEx("UnFreezeStation", 1000, false, "i", playerid);
					}
					PlayerInfo[playerid][pLocal] = 255;

					new f = PlayerInfo[playerid][pMember];
					if(factionWar[f] != -1) {
						new turf = WarsStatistics[factionWar[f]][wTurfid];
						SetPlayerVirtualWorld(playerid, turf);
					}
					else SetPlayerVirtualWorld(playerid,0);

					InBussines[playerid] = 0;
					PlayRadio[playerid] = 0;
					StopAudioStreamForPlayer(playerid);
					return 1;
				}
			}
			if(IsPlayerInRangeOfPoint(playerid, 3.0, 2337.1826, 2458.7441, 14.9921) && GetPlayerVirtualWorld(playerid) == 0) {
				if(IsACop(playerid)) {
				SetPlayerPosEx(playerid, 2280.0898, 2458.7939, 38.6871);
				SetPlayerInterior(playerid, 0); }
				return 1;
			}
			if(IsPlayerInRangeOfPoint(playerid, 3.0, 2280.0898, 2458.7939, 38.6871) && GetPlayerVirtualWorld(playerid) == 0) {
				if(IsACop(playerid)) {
				SetPlayerPosEx(playerid, 2337.1826, 2458.7441, 14.9921);
				SetPlayerInterior(playerid, 0);}
				return 1;
			}
			if(IsPlayerInRangeOfPoint(playerid, 3.0, 1630.2462, 1793.0410, 10.8156) && GetPlayerVirtualWorld(playerid) == 0) {
				if(PlayerInfo[playerid][pMember] == 13) {
				SetPlayerPosEx(playerid, 1606.6693, 1786.6062, 30.4599);
				SetPlayerInterior(playerid, 0);}
				return 1;
			}
			if(IsPlayerInRangeOfPoint(playerid, 3.0, 1606.6693, 1786.6062, 30.4599) && GetPlayerVirtualWorld(playerid) == 0) {
				if(PlayerInfo[playerid][pMember] == 13) {
				SetPlayerPosEx(playerid, 1630.2462, 1793.0410, 10.8156);
				SetPlayerInterior(playerid, 0);}
				return 1;
			}
			if(IsPlayerInRangeOfPoint(playerid,2,1918.2250,-1619.8477,1770.7469)) {
				if(IsACop(playerid)) ShowPlayerDialogEx(playerid, DIALOG_TELEPORT, DIALOG_STYLE_LIST, "Teleport", "Enter Yard\nExit jail", "Select", "Cancel");
				else {
					SetPlayerVirtualWorld(playerid, 1339);
					SetPlayerPosEx(playerid, 1772.0298,-1548.0693,9.9068);
					SetPlayerInterior(playerid, 0);
				}
				return 1;
			}
			if(IsPlayerInRangeOfPoint(playerid,2,1798.5109,-1578.3337,14.0848) || IsPlayerInRangeOfPoint(playerid,2,-34.6773,2506.8154,17.2725)) {
				if(PlayerInfo[playerid][pJailTime] >= 1 || IsACop(playerid)) {
					SetPlayerVirtualWorld(playerid, 0);
					SetPlayerPosEx(playerid, 1918.2250,-1619.8477,1770.7469);
					SetPlayerInterior(playerid, 0);
					TogglePlayerControllable(playerid, 0);
					SetTimerEx("UnFreezeStation", 1000, false, "i", playerid);
				}
				return 1;
			}
			if(IsPlayerInRangeOfPoint(playerid,2,2050.3245,1218.4463,547.9710) && IsACop(playerid)) {
				SetPlayerVirtualWorld(playerid, 0);
				SetPlayerPosEx(playerid, 1798.5109,-1578.3337,14.0848);
				SetPlayerInterior(playerid, 0);
				return 1;
			}
			if(IsPlayerInRangeOfPoint(playerid,2,-2157.2249,715.5968,69.5625)) {
				SetPlayerInterior(playerid,4);
				SetTimerEx("UnFreezeStation", 1000, false, "i", playerid); // pescarie bn
				SetPlayerPosEx(playerid,-27.312299,-29.277599,1003.557250);
				return 1;
			}
			if(IsPlayerInRangeOfPoint(playerid,2,-27.312299,-29.277599,1003.557250)) {
				SetPlayerInterior(playerid,0);
				SetTimerEx("UnFreezeStation", 1000, false, "i", playerid);
				SetPlayerPosEx(playerid,-2157.2249, 715.5968, 69.5625);
				return 1;
			}
			if(IsPlayerInRangeOfPoint(playerid,2,2229.3289,-1722.0793,13.5625)) {
				SetPlayerInterior(playerid,5);
				SetPlayerPosEx(playerid,772.111999,-3.898649,1000.728820);
				return 1;
			}
			if(IsPlayerInRangeOfPoint(playerid,2,2071.1157,-1553.9918,13.4212)) {
				TogglePlayerControllable(playerid, 0);
				SetTimerEx("UnFreezeStation", 1000, false, "i", playerid);
				SetPlayerPosEx(playerid,2068.2354,-1620.9814,705.4056);
				return 1;
			}
			if(IsPlayerInRangeOfPoint(playerid,2,2068.2354,-1620.9814,705.4056)) {
				TogglePlayerControllable(playerid, 0);
				SetTimerEx("UnFreezeStation", 1000, false, "i", playerid);
				SetPlayerPosEx(playerid,2071.1157,-1553.9918,13.4212);
				return 1;
			}
			if(IsPlayerInRangeOfPoint(playerid,2,1671.5824,-1329.4281,17.4524))  {
				if(areape == 1) {
					SetPlayerInterior(playerid,15);
					SetPlayerPosEx(playerid,-1423.5153,935.8321,1036.4756);
					return 1;
				}
				else return SCM(playerid,COLOR_WHITE,"Arena de evente este inchisa.");
			}

			if(IsPlayerInRangeOfPoint(playerid,2,-1423.5153,935.8321,1036.4756)) {
				if(areape == 1) {
					SetPlayerInterior(playerid,0);
					SetPlayerPosEx(playerid,1671.5824,-1329.4281,17.4524);
					return 1;
				}
			}
		}
		// if(NoFuel[playerid] == 1) {
			// RemovePlayerFromVehicleEx(playerid);
			// TogglePlayerControllable(playerid, 1);
			// NoFuel[playerid] = 0;
		// }
    }
	if(newkeys & KEY_FIRE) {
		if(PlayerInfo[playerid][pMember] == 8 || PlayerInfo[playerid][pLeader] == 8) TTCFunction(playerid);
		if(EnableBoast[playerid] == 1 && GetPlayerState(playerid) == PLAYER_STATE_DRIVER) {
			new Float:vx,Float:vy,Float:vz;
			GetVehicleVelocity(GetPlayerVehicleID(playerid),vx,vy,vz);
			SetVehicleVelocity(GetPlayerVehicleID(playerid), vx * 1.8, vy *1.8, vz * 1.8);
		}
	}
   	if(newkeys == KEY_YES) {
		if(PlayerInfo[playerid][pJob] == 4 && JobWorking[playerid] == 1) {
			if(DeelayCommand[playerid][4] != 0) return DeelayTime(playerid, 4);
			SetTimerEx("AttachTrailer", 1000, false, "i", playerid);
			SCM(playerid, -1, "The trailer will be attached in a few seconds!");
			DeelayCommand[playerid][4] = 10*2;
		}
		if(IsPlayerInRangeOfPoint(playerid,2,-104.0142,-22.6778,1000.7188)) {
			ShowPlayerDialogEx(playerid, DIALOG_DILDO, DIALOG_STYLE_LIST, "Buy dildo", "Double-ended Dildo ($500)\nDildo ($500)\nVibrator ($500)\nSilver Vibrator ($500)\nFlowers ($1,000)", "Ok", "Close");
			return 1;
		}
		if(IsPlayerInRangeOfPoint(playerid,2.0,311.8029,-166.1414,999.6010))  {
			if(PlayerInfo[playerid][pGunLic] == 0) return SCM(playerid, COLOR_LGREEN, "Eroare: Nu ai licenta de arme. Cauta un instructor pentru a obtine licenta.");
			ShowPlayerDialogEx(playerid, DIALOG_BUYGUN, DIALOG_STYLE_LIST, "Buy gun", "Deagle ($2,000)\nM4 ($5,000)\nAK47 ($4,800)\nMicro SMG ($2,500)\nShotgun ($3,000)\nBaseball Bat ($1,000)", "Buy", "Exit");
			return 1;
		}

		if(IsPlayerInRangeOfPoint(playerid,2.0,-28.8578,-185.1236,1003.5469)) {
			new szDialog2[1024];
			strcat(szDialog2, "Item\tPret\n");
			strcat(szDialog2, "{FFFFFF}Telefon\t$5,000\n");
			strcat(szDialog2, "{FFFFFF}Carte de telefon\t$3,500\n");
			strcat(szDialog2, "{FFFFFF}Frecventa radio\t$2,000\n");
			strcat(szDialog2, "{FFFFFF}Bricheta\t$500\n");
			strcat(szDialog2, "{FFFFFF}Tigari\t$100\n");
			strcat(szDialog2, "{FFFFFF}Canistra\t$4,000\n");
			strcat(szDialog2, "{FFFFFF}Camera\t$3,000\n");
			ShowPlayerDialogEx(playerid, DIALOG_STORE,DIALOG_STYLE_TABLIST_HEADERS,"Cumpara:",szDialog2,"Ok","Close");
			return 1;
		}
	}
    if(newkeys == KEY_CTRL_BACK && GetPlayerState(playerid) == PLAYER_STATE_DRIVER) {
		if(!IsPlayerInAnyVehicle(playerid)) return 1;
		if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return 1;
		new szDialog[1024], szDialog2[1024];
		strcat(szDialog2, "Nume\tAscultatori\n");
		for(new i = 0; i < sizeof(RadioNames); i++) {
			if(i == 0) format(szDialog, sizeof(szDialog), "%s\n", RadioNames[i]);
			else format(szDialog, sizeof(szDialog), "%s\t%d\n", RadioNames[i], ListenThisRadio(i));
			strcat(szDialog2, szDialog);
		}
		strcat(szDialog2, "Youtube custom URL");
		ShowPlayerDialogEx(playerid, DIALOG_CARRADIO, DIALOG_STYLE_TABLIST_HEADERS, "Car Radio", szDialog2, "Ok", "Close");
    }
	if(newkeys == KEY_WALK) {
		if(IsPlayerSpec{playerid}) {
			TogglePlayerControllable(playerid, 1);
			TogglePlayerSpectating(playerid, 0);
			SetPlayerInterior(playerid,Unspec[playerid][sPint]);
			PlayerInfo[playerid][pInt] = Unspec[playerid][sPint];
			PlayerInfo[playerid][pLocal] = Unspec[playerid][sLocal];
			Unspec[playerid][sLocal] = INVALID_PLAYER_ID;
			gTeam[playerid] = PlayerInfo[playerid][pTeam];
			SetPlayerToTeamColor(playerid);
			SCM(playerid, -1, "Nu mai esti spectator!");
			// SpecPlayers[playerid] = 0;
			SpawnPlayer(playerid);
			Spectate[playerid] = INVALID_PLAYER_ID;
			LastRecon[playerid] = 1;
			PlayerTextDrawHide(playerid, SpectatorTD);
			IsPlayerSpec{playerid} = false;
			KillTimer(specTimer[playerid]);
			return 1;
		}
		if(InGame[playerid] == 1 && playerDeath[playerid] == 0) {
			if(GetPlayerWeapon(playerid) == 0) return SCM(playerid, COLOR_LIGHTRED, "Nu ai o arma in mana!");
			new Float: Pos[3], sweapon, sammo, idd;
			GetPlayerPos(playerid, Pos[0], Pos[1], Pos[2]);
			sweapon = GetPlayerWeapon(playerid);
			sammo = GetPlayerAmmo(playerid);

			idd = CheckIDEmpty();
			Pickups[idd][psID] = CreateDynamicPickup(WeaponObject(sweapon), 23, Pos[0]+5, Pos[1], Pos[2], 6969);
			Pickups[idd][psWar] = 1337;
			Pickups[idd][psType] = 1;
			Pickups[idd][psWeapon] = sweapon;
			Pickups[idd][psAmmo] = sammo;
			// printf("%f %f %f", Pos[0], Pos[1], Pos[2]);
			new gunname[32];
			GetWeaponName(sweapon, gunname, 32);
			format(string, sizeof(string), "Ai aruncat arma %s cu %d gloante.", gunname, sammo);
			SCM(playerid, COLOR_LIGHTBLUE, string);

			new weapons[13], wammo[13];
			for(new i = 0; i < 12; i++) {
				GetPlayerWeaponData(playerid, i, sweapon, sammo);
				if(sweapon != 0 && sweapon != GetPlayerWeapon(playerid)) weapons[i] = sweapon, wammo[i] = sammo;
			}
			ResetWeapons(playerid);
			for(new i = 0; i < 12; i++) {
				if(weapons[i] != 0) ServerWeapon(playerid, weapons[i], wammo[i]);
			}
			SetPlayerArmedWeapon(playerid, 0);
			return 1;
		}
	}
	if(newkeys & KEY_NO) {
		LockCarFunction(playerid);
	}

	if(newkeys & KEY_JUMP && !(oldkeys & KEY_JUMP) && GetPlayerSpecialAction(playerid) == SPECIAL_ACTION_CUFFED) ApplyAnimation(playerid, "GYMNASIUM", "gym_jog_falloff",4.1,0,1,1,0,0);
	if((IsACBUGWeapon(playerid) && RELEASED(KEY_FIRE)) && newkeys != KEY_FIRE && newkeys & KEY_CROUCH) {
		ApplyAnimation ( playerid , "PED" , "getup_front" , 4.1 , 0 , 0 , 0 , 0 , 0 ) ;
		SCM(playerid,COLOR_WARNING,"Este interzis sa faci C-BUG!");
    }
	if(newkeys & KEY_HANDBRAKE) {
		if(GetPlayerSpecialAction(playerid) == SPECIAL_ACTION_USEJETPACK && PlayerInfo[playerid][pAdmin] < 1) {
			format(string, sizeof(string), "AdmWarning: %s(%d) a primit kick deoarece are jetpack.",GetName(playerid),playerid);
			if(GetPVarInt(playerid, "Cover") == 0) SendAdminMessage(COLOR_WARNING, string,1);
			KickEx(playerid);
		}
	}
	if(newkeys & KEY_CROUCH) {
		if(PlayerInfo[playerid][pMember] == 8) {
			if(IsPlayerInRangeOfPoint(playerid, 13.0, 2423.8899, -2090.3191, 12.5429)) {
				if(GateStatus == 0) {
					GateStatus = 1;
					MoveDynamicObject(ttcgate[0], 2423.8462, -2074.8150, 15.3476, 3.0);
					MoveDynamicObject(ttcgate[1], 2423.8462, -2103.9908, 15.3476, 3.0);
					SetTimer("ResetGates", 3000, false);
				}
			}
		}

		if(IsACop(playerid)) {
			if(IsPlayerInRangeOfPoint(playerid, 15.0,1588.6552, -1637.9025, 15.0358)) {
				MoveObject(gatelspd,1596.7352,-1637.9025, 15.0358,2);
				SetTimer("lspdgateclose" ,9000 ,false);
				return 1;
			}
			if(IsPlayerInRangeOfPoint(playerid, 15.0, 135.2833, 1941.3331, 21.6932)) {
				MoveObject(gateng,122.0023, 1941.4100, 21.6932,2);
				SetTimer("nggateclose" ,9000 ,false);
				return 1;
			}
			if(IsPlayerInRangeOfPoint(playerid, 15.0, 1544.7007, -1630.7527, 13.2983)) {
				MoveObject(lspdbar,1544.7007, -1630.7527, 13.2983,1,0.0000, 0.0000, 90.0000);
				SetTimer("lspdbarclose" ,9000 ,false);
				return 1;
			}
			if(IsPlayerInRangeOfPoint(playerid, 15.0, 2293.8513, 2497.67554, 4.53215)) {
				MoveDynamicObject(gatelvpd[0], 2293.8513, 2497.6755, -2, 5.0);
				SetTimerEx("LVPDGates", 5000, false, "i", 1);
				return 1;
			}
			if(IsPlayerInRangeOfPoint(playerid, 15.0, 2335.2009, 2443.6992, 1.8997)) {
				MoveDynamicObject(gatelvpd[1], 2335.2009, 2443.6992, 1.8997, 5.0);
				SetTimerEx("LVPDGates", 5000, false, "i", 2);
				return 1;
			}
			if(IsPlayerInRangeOfPoint(playerid, 15.0, 2238.2146, 2450.2695, 10.6961)) {
				MoveDynamicObject(gatelvpd[2], 2238.21460, 2450.26953, 10.69610, 1, 0.00000, 0.00000, 90.00000);
				SetTimerEx("LVPDGates", 5000, false, "i", 3);
				return 1;
			}
		}
	}
	if(newkeys == KEY_LOOK_BEHIND) {
		if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER) {
			new idcar = GetPlayerVehicleID(playerid), sendername[25];
			if(idcar == 0) return 1;
			// new carid = FindSpawnID(idcar);
			// if(carid != 0) {
				// if(CarInfo[carid][cPoints] == 0) return SCM(playerid, COLOR_GREY, "Acest vehicul nu are asigurarea platita!");
			// }
			if(Refueling[playerid] != 0) return SCM(playerid,COLOR_LGREEN,"* Te rugam sa astepti pana ce iti faci plinul!");
			if(gettime() < GetPVarInt(playerid, "EngineDeelay")) return SCMf(playerid, -1, "Asteapta %d secunde!", GetPVarInt(playerid, "EngineDeelay") - gettime());
			new vehicle = GetVehicleModel(idcar) - 400;
			if(vehEngine[idcar] == 0) {
				if(Gas[idcar] == 0) return 1;
				if(NoFuel[idcar] == 1) return 1;
				vehEngine[idcar] = 1;
				GetVehicleParamsEx(idcar,engine,lights,alarm,doors,bonnet,boot,objective);
				SetVehicleParamsEx(idcar,VEHICLE_PARAMS_ON,lights,alarm,doors,bonnet,boot,objective);

				SetPVarInt(playerid, "EngineDeelay", gettime() + 5);
				GetPlayerName(playerid, sendername, sizeof(sendername));
				SetPVarInt(playerid, "Engine", 1);
				if(GetPVarInt(playerid, "Undercover") == 1) format(string, sizeof(string), "* Unknown starts the engine of his %s.",aVehicleNames[vehicle]);
				else format(string, sizeof(string), "* %s baga cheia in contact si porneste vehiculul de tip %s.",sendername,aVehicleNames[vehicle]);
				ProxDetectorLNX(30.0, playerid, string, COLOR_PURPLE);
			}
			else if(vehEngine[idcar] == 1) {
				vehEngine[idcar] = 0;
				SetPVarInt(playerid, "EngineDeelay", gettime() + 5);
				GetVehicleParamsEx(idcar,engine,lights,alarm,doors,bonnet,boot,objective);
				SetVehicleParamsEx(idcar,VEHICLE_PARAMS_OFF,lights,alarm,doors,bonnet,boot,objective);
				GetPlayerName(playerid, sendername, sizeof(sendername));
				SetPVarInt(playerid, "Engine", 0);
				if(GetPVarInt(playerid, "Undercover") == 1) format(string, sizeof(string), "* Unknown stops the engine of his %s.",aVehicleNames[vehicle]);
				else format(string, sizeof(string), "* %s opreste motorul vehiculul de tip %s.",sendername,aVehicleNames[vehicle]);
				ProxDetectorLNX(30.0, playerid, string, COLOR_PURPLE);
			}
		}
	}
	if(newkeys & KEY_SPRINT) {
		if(gPlayerUsingLoopingAnim[playerid] == 1) StopLoopingAnim(playerid);
	}
	if(newkeys & KEY_ANALOG_DOWN) {
		if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER) {
			new veh = GetPlayerVehicleID(playerid);
			if(GetPVarInt(playerid, "Boot") == 0) {
				GetVehicleParamsEx(veh,engine,lights,alarm,doors,bonnet,boot,objective);
				SetVehicleParamsEx(veh,engine,lights,alarm,doors,bonnet,VEHICLE_PARAMS_ON,objective);
				SetPVarInt(playerid, "Boot", 1);
			}
			else if(GetPVarInt(playerid, "Boot") == 1) {
				GetVehicleParamsEx(veh,engine,lights,alarm,doors,bonnet,boot,objective);
				SetVehicleParamsEx(veh,engine,lights,alarm,doors,bonnet,VEHICLE_PARAMS_OFF,objective);
				SetPVarInt(playerid, "Boot", 0);
			}
		}
		return 1;
	}
	if(newkeys & KEY_ACTION) {
		if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER) {
			new veh = GetPlayerVehicleID(playerid);
			if(GetPVarInt(playerid, "Lights") == 0) {
				GetVehicleParamsEx(veh,engine,lights,alarm,doors,bonnet,boot,objective);
				SetVehicleParamsEx(veh,engine,VEHICLE_PARAMS_ON,alarm,doors,bonnet,boot,objective);
				SetPVarInt(playerid, "Lights", 1);
			}
			else if(GetPVarInt(playerid, "Lights") == 1) {
				GetVehicleParamsEx(veh,engine,lights,alarm,doors,bonnet,boot,objective);
				SetVehicleParamsEx(veh,engine,VEHICLE_PARAMS_OFF,alarm,doors,bonnet,boot,objective);
				SetPVarInt(playerid, "Lights", 0);
			}
		}
		return 1;
	}
	if(newkeys & KEY_ANALOG_UP) {
		if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER) {
			new veh = GetPlayerVehicleID(playerid);
			if(GetPVarInt(playerid, "Bonnet") == 0) {
				GetVehicleParamsEx(veh,engine,lights,alarm,doors,bonnet,boot,objective);
				SetVehicleParamsEx(veh,engine,lights,alarm,doors,VEHICLE_PARAMS_ON,boot,objective);
				SetPVarInt(playerid, "Bonnet", 1);
			}
			else if(GetPVarInt(playerid, "Bonnet") == 1) {
				GetVehicleParamsEx(veh,engine,lights,alarm,doors,bonnet,boot,objective);
				SetVehicleParamsEx(veh,engine,lights,alarm,doors,VEHICLE_PARAMS_OFF,boot,objective);
				SetPVarInt(playerid, "Bonnet", 0);
			}
		}
		return 1;
    }
    return 0;
}

public OnVehicleSpawn(vehicleid) {
	CarRadio[vehicleid] = 0;
	SetVehicleHealth(vehicleid, 999);

	if(VehicleSQL[vehicleid] != 0) {
		new carid = VehicleSQL[vehicleid];
		if(CarInfo[carid][cVirtual] != 0) SetVehicleVirtualWorld(vehicleid, CarInfo[carid][cVirtual]);
		SetTunning(carid);
	}
	else Gas[vehicleid] = 100;

	SetVehicleColor(vehicleid);
	if(Carspawn[vehicleid] == vehicleid) {
		DestroyVehicle(vehicleid);
		Carspawn[vehicleid] = 0;
	}
	return 1;
}

public OnPlayerInteriorChange(playerid, newinteriorid, oldinteriorid) {
    foreach(new i: PlayerAdmins) {
		if(Spectate[i] == playerid) {
			SetPlayerInterior(i, GetPlayerInterior(playerid));
			SetPlayerVirtualWorld(i, GetPlayerVirtualWorld(playerid));
			PlayerSpectatePlayer(i, playerid);
		}
	}
    foreach(Player, i) {
		if(Spectate[i] == playerid) {
			TogglePlayerSpectating(i, 1);
			SetPlayerInterior(i, newinteriorid);
			SetPlayerVirtualWorld(i, GetPlayerVirtualWorld(playerid));
			if(IsPlayerInAnyVehicle(playerid)) PlayerSpectateVehicle(i, GetPlayerVehicleID(playerid));
			else PlayerSpectatePlayer(i, playerid);
		}
	}
	if(newinteriorid == 0) InHQ[playerid] = 0;
    return 1;
}

public OnPlayerText(playerid, text[])
{
	// static Text[MAX_PLAYERS][128];
	// if(Text[playerid][0] != '\0' && !strcmp(text,Text[playerid],true)) return 0;
	// strcat((Text[playerid][0]='\0', Text[playerid]), text, 128);

	// printf("playername - %s - %s", GetName(playerid), text);

	AntiFlood_Check(playerid);
	if(IsPlayerLogged[playerid] == 0) return 0;
	if(TutorialActive[playerid] == 1) return 0;

	new string[180];
    if(PlayerInfo[playerid][pMuted] == 1)  {
	    format(string, sizeof(string), "You can't talk right now! You are muted. (%d seconds)",PlayerInfo[playerid][pMuteTime]);
	    SendClientMessage(playerid, COLOR_GREY, string);
		return 0;
	}

	if(FaceReclama(text)) {
		Reclama(playerid, text);
		return 0;
	}

	if(TalkingLive[playerid] != -1) {
		if(PlayerInfo[playerid][pLeader] == 9 || PlayerInfo[playerid][pMember] == 9) format(string, sizeof(string), "Reporter %s: %s", GetNameEx(playerid), text);
		else format(string, sizeof(string), "Jucator %s: %s", GetNameEx(playerid), text);
		OOCNews(COLOR_LIGHTGREEN, string);
		return 0;
	}
	if(Mobile[playerid] != -1) {

		new idx = Mobile[playerid];

		format(string, 140, "%s spune (telefon): %s", GetNameEx(playerid), text);
		ProxDetectorLNX(20.0, playerid, string, COLOR_FADE1);

		if(IsPlayerConnected(idx)) {
		    if(Mobile[idx] == playerid) {
				if(PlayerInfo[idx][pSpeaker] == 1) ProxDetectorLNX(20.0, playerid, string, COLOR_FADE1);
				else SendClientMessage(idx, COLOR_YELLOW, string);
			}
		}
		InsertLog(playerid, string, LOG_CHAT);
		return 0;
	}
	if(realchat) {
		if(PaintType[playerid] != 0) {
			format(string, 140, "{5088BF}%s [%d kills]: {FFFFFF}%s", GetNameEx(playerid), PKills[playerid], text);
			return SendPaintMessage(PaintType[playerid], -1, string), 0;
		}
		else {

			if(PlayerInfo[playerid][pColor] >= 1) {
				format(string, 140, "{%s}%s: {FFFFFF}%s", serverColors(PlayerInfo[playerid][pColor]), GetNameEx(playerid), text);
				return ProxDetectorLNX(20.0, playerid, string, -1), 0;
			}

			format(string, 140, "%s: {FFFFFF}%s", GetNameEx(playerid), text);

			if(GetPVarInt(playerid, "Cover") == 1) ProxDetectorLNX(20.0, playerid, string, COLOR_GREY);
			else if(PlayerInfo[playerid][pHelper] >= 1 || PlayerInfo[playerid][pAdmin] >= 1) ProxDetectorLNX(20.0, playerid, string, 0xBA0404FF);
			else if(PlayerInfo[playerid][pYT] >= 1) ProxDetectorLNX(20.0, playerid, string, 0x388BFFFF);
			else ProxDetectorLNX(20.0, playerid, string,COLOR_GREY);

			// format(string, 140, "(chat) %s", text);
			// InsertLog(playerid, string, LOG_CHAT);

			format(string, 80, "\"%s\"", text);
			SetPlayerChatBubble(playerid, text, COLOR_CHATBUBBLE, 10.0, 10000);
		}
		return 0;
	}
	return 1;
}


public OnVehicleRespray(playerid, vehicleid, color1, color2) {
    SetVehicleColor(vehicleid);
	SetVehicleHealth(vehicleid, 999);
    return 1;
}

public OnVehicleDeath(vehicleid) {
	new carid = VehicleSQL[vehicleid];
	if(carid != 0) CarInfo[carid][cPoints] --;

 	new engine,lights,alarm,doors,bonnet,boot,objective;
 	vehEngine[vehicleid] = 0;
	GetVehicleParamsEx(vehicleid,engine,lights,alarm,doors,bonnet,boot,objective);
 	SetVehicleParamsEx(vehicleid,VEHICLE_PARAMS_OFF,lights,alarm,doors,bonnet,boot,objective);
	StopAudioStreamForPlayersInCar(vehicleid);
 	return 1;
}

public OnDialogResponse(playerid, dialogid, response, listitem, inputtext[]) {
    if(!dialogTextCheck(inputtext)) return 1;

	if(pDialog[playerid] == -1) KickEx(playerid);
	pDialog[playerid] = -1;

	new query[256], string[256];
	new sendername[25];
	switch(dialogid) {
		case DIALOG_SKIN: {
	        if(!response) return 1;
			new id = accesedSkin[playerid];
			accesedSkin[playerid] = -1;
			if(id == -1) return 1;

			if(listitem == 0) {
				new ch = PlayerInfo[playerid][pSkins][id];
				PlayerInfo[playerid][pChar] = ch;
				SetPlayerSkinEx(playerid, ch);
				UpdateVar(playerid, "CChar", ch);
				SCM(playerid, COLOR_LGREEN, "The skin was successfully attached!");
			}
			else if(listitem == 1) {
				if(id == 0) return SCM(playerid, COLOR_LGREEN, "Nu poti sterge skin-ul de civil");
				PlayerInfo[playerid][pSkins][id] = -1;
				SaveSkins(playerid);
				SCM(playerid, COLOR_ADMINJ, "The skin has been successfully deleted!");
			}
		}
		case DIALOG_SETPIN: {
		    if(!response) return 1;
		    if(!IsNumeric(inputtext)) return SCM(playerid, COLOR_LGREEN, "Codul pin trebuie sa contina doar cifre.");
		    if(strlen(inputtext) > 4) return SCM(playerid, COLOR_LGREEN, "Codul pin trebuie sa fie format din 4 cifre.");
  			if(Spoofer1[playerid] != 2) {
			    SCM(playerid, -1, "A aparut o eroare, incearca sa te reconectezi.");
			    return 1;
			}
		    new pin = strval(inputtext);
		    PlayerInfo[playerid][pPin] = pin;
		    PlayerInfo[playerid][pPinLogged] = 1;
		    format(string, sizeof(string), "Codul tau pin este {ffffff}%d{ffa500}. (( asigura-te ca nu-l vei uita! ))", pin);
		    SCM(playerid, COLOR_ORANGE, string);
		    format(query, sizeof(query), "UPDATE `users` SET `Pin`='%d' WHERE `ID`='%d'", pin, PlayerInfo[playerid][pSQLID]);
			mysql_tquery(SQL, query, "", "");
			Spoofer1[playerid] = -1;
		}
		case DIALOG_LOGINPIN: {
		    if(!response) return Kick(playerid);
		    if(PlayerInfo[playerid][pPinLogged] == 1) {
			    SCM(playerid, -1, "A aparut o eroare, incearca sa te reconectezi.");
			    return 1;
		    }
		    new pin = strval(inputtext);
		    if(PlayerInfo[playerid][pPin] != pin) return Kick(playerid);
		    PlayerInfo[playerid][pPinLogged] = 1;
		    SCM(playerid, COLOR_LGREEN, "Codul de securitate a fost introdus cu succes, acum ai acces total asupra contului!");
		}
		case DIALOG_CHANGEPIN: {
		    if(!response) return 1;

		    new pin = strval(inputtext);
		    if(PlayerInfo[playerid][pPin] != pin) return SCM(playerid, COLOR_LGREEN, "Eroare: Codul introdus nu este valid.");
		    ShowPlayerDialogEx(playerid, DIALOG_CHANGEPIN+1, DIALOG_STYLE_INPUT, "Set pin", "Scrie mai jos noul cod de securitate.", "Ok", "Close");
		}
		case DIALOG_CHANGEPIN+1: {
		    if(!response) return 1;
   			if(Spoofer1[playerid] != 3) {
			    SCM(playerid, -1, "A aparut o eroare, incearca sa te reconectezi.");
			    return 1;
			}
  		    new pin = strval(inputtext);
		    PlayerInfo[playerid][pPin] = pin;
		    format(string, sizeof(string), "Noul tau cod pin este {ffffff}%d{ffa500}. (( asigura-te ca nu-l vei uita! ))", pin);
		    SCM(playerid, COLOR_ORANGE, string);
		    format(query, sizeof(query), "UPDATE `users` SET `Pin`='%d' WHERE `ID`='%d'", pin, PlayerInfo[playerid][pSQLID]);
			mysql_tquery(SQL, query, "", "");
			Spoofer1[playerid] = -1;
		}
		case DIALOG_PET: {
			switch(listitem) {
				case 0: {
					if(!response) return 1;
					if(PlayerInfo[playerid][pPetStatus] == 0) {
						PlayerInfo[playerid][pPetStatus] = 1;
						format(string, sizeof(string),"Stats\tAwake\nPet Name\t%s",PlayerInfo[playerid][pPetName]);
					    SetPlayerAttachedObject(playerid, 6, 19076, 1, 0.260000, -0.029999, -0.159999, 180.000000, 90.000000, 0.000000, 0.029999, 0.029999, 0.029999);


						format(string, sizeof(string), "{04bf5b}%s {FFFFFF}[level %d]",PlayerInfo[playerid][pPetName],PlayerInfo[playerid][pPetLevel]);
						Pet[playerid] = CreateDynamic3DTextLabel(string, COLOR_WHITE, 300.120239, 1.512298, 300.232513, 12, playerid);
						Attach3DTextLabelToPlayer(Pet[playerid], playerid, 6, 0.0, -0.1);

					    SCMEx(playerid, -1, "You woke up %s.",PlayerInfo[playerid][pPetName]);

					    format(query, sizeof(query),"UPDATE `users` SET `PetStatus` = '1' WHERE `Name` = '%s'", GetName(playerid));
					    mysql_tquery(SQL, query, " ", " ");
					    Update(playerid, pPetStatusx);
					}
					else {
						RemovePet(playerid);
						SCMEx(playerid, -1, "You fell asleep %s.",PlayerInfo[playerid][pPetName]);
						PlayerInfo[playerid][pPetStatus] = 0;

						format(query, sizeof(query),"UPDATE `users` SET `PetStatus` = '0' WHERE `Name` = '%s'", GetName(playerid));
					    mysql_tquery(SQL, query, " ", " ");

						Update(playerid, pPetStatusx);
					}
				} case 1: {
					if(	!response) return 1;
					format(string, sizeof(string),"Your pet name is %s, if you want to change enter the name below. (need 30 premium points)",PlayerInfo[playerid][pPetName]);
					ShowPlayerDialogEx(playerid, DIALOG_PETNAME, DIALOG_STYLE_INPUT, "Pet Name", string, "Enter", "Cancel");
				} case 2: {

					new szDialog[200], title[256];
					strcat(szDialog, "Jefuieste o afacere.\n");
					strcat(szDialog, "Intra in Area 51.\n");
					strcat(szDialog, "Termina o tura la jobul Trucker.\n");
					strcat(szDialog, "Termina o tura la jobul Pizza Boy.\n");
					strcat(szDialog, "Bea o cafea.\n");
					format(title, 256, "Pet Points: %d", PlayerInfo[playerid][pPetPoints]);
					ShowPlayerDialogEx(playerid, DIALOG_PETR, DIALOG_STYLE_TABLIST, title, szDialog, "Reward", "Close");
				}
				case 3: {
				    new request = 300*PlayerInfo[playerid][pPetLevel];
					if(request > PlayerInfo[playerid][pPetXp]) return SCMEx(playerid, -1, "Ai nevoie de %d Pet Xp pentru a continua.", request);
					PlayerInfo[playerid][pPetXp] -= request;
					PlayerInfo[playerid][pPetLevel] ++;
					Update(playerid, pPetXpx);
					Update(playerid, pPetLevelx);
					SCMEx(playerid, -1, "Pet-ul tau are acum level %d.",PlayerInfo[playerid][pPetLevel]);
					DestroyDynamic3DTextLabel(Pet[playerid]);

					format(string, sizeof(string), " {6AD439}%s{FFFFFF} - level {6AD439}%d{FFFFFF}",PlayerInfo[playerid][pPetName],PlayerInfo[playerid][pPetLevel]);
					Pet[playerid] = CreateDynamic3DTextLabel(string, COLOR_WHITE, 300.120239, 1.512298, 300.232513, 12, playerid);
				}
			}
		}
		case DIALOG_PETNAME: {
			if(!response) return 1;
			if(!isnull(inputtext)) {
				if(strlen(inputtext) >= 5 && strlen(inputtext) <= 15) {
				    if(PlayerInfo[playerid][pLevel] < 5) return SCM(playerid, -1, "Poti schimba numele pet-ului incepand cu level 5.");
					DestroyDynamic3DTextLabel(Pet[playerid]);
					format(PlayerInfo[playerid][pPetName], 30, inputtext);
					SCMEx(playerid, -1, "You changed the pet name to %s.",PlayerInfo[playerid][pPetName]);
					Update(playerid, pPetNamex);
					format(string, sizeof(string), "{04bf5b}%s {FFFFFF}[level %d]",PlayerInfo[playerid][pPetName],PlayerInfo[playerid][pPetLevel]);
					Pet[playerid] = CreateDynamic3DTextLabel(string, COLOR_WHITE, 300.120239, 1.512298, 300.232513, 12, playerid);
	    			Attach3DTextLabelToPlayer(Pet[playerid], playerid, 0.0, 0.0, 0.7);
				}
				else {
					SCM(playerid, -1, "Invalid name, the name must contain between 5 and 15 characters.");
					format(string, sizeof(string), "The name of the pet is %s\nIf you want to change it enter the name below.\nThe name must contain between 5 and 15 characters.",PlayerInfo[playerid][pPetName]);
					ShowPlayerDialogEx(playerid, DIALOG_PETNAME, DIALOG_STYLE_INPUT, "Pet Name", string, "Change", "Cancel");
				}
			}
			else {
				SCM(playerid, -1, "Invalid name, the name must contain between 5 and 15 characters.");
				format(string, sizeof(string), "The name of the pet is %s\nIf you want to change it enter the name below.\nThe name must contain between 5 and 15 characters.",PlayerInfo[playerid][pPetName]);
				ShowPlayerDialogEx(playerid, DIALOG_PETNAME, DIALOG_STYLE_INPUT, "Pet Name", string, "Change", "Cancel");
			}
		}
		case DIALOG_PETR: {
			if(!response) return 1;
			switch(listitem) {
			    case 0:
			    {
					SCM(playerid, -1, "Completeaza misiunea pentru a primii premiul.");
				}
	        	case 1:
	        	{
					SCM(playerid, -1, "Completeaza misiunea pentru a primii premiul.");
	        	}
	        	case 2:
	        	{
					SCM(playerid, -1, "Completeaza misiunea pentru a primii premiul.");

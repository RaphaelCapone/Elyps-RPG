function LoadTurfs() {
	new s = cache_num_rows(), x, Float:p1, Float:p2, Float:p3, Float:p4;

 	for (new i = 0; i != s; ++i) {
       	cache_get_value_name_int(i, "ID", x);
		TurfInfo[x][zID] = x;
       	cache_get_value_name(i, "Name", TurfInfo[x][zName]);
		cache_get_value_name_int(i, "Owned", TurfInfo[x][zOwned]);

     	cache_get_value_name_float(i, "MinX", p1);
    	cache_get_value_name_float(i, "MinY", p2);
    	cache_get_value_name_float(i, "MaxX", p3);
    	cache_get_value_name_float(i, "MaxY", p4);

		TurfInfo[x][zMinX] = p1;
		TurfInfo[x][zMinY] = p2;
		TurfInfo[x][zMaxX] = p3;
		TurfInfo[x][zMaxY] = p4;

		// printf("loading turf %d: %f %f %f %f, own: %d", x, TurfInfo[x][zMinX], TurfInfo[x][zMinY], TurfInfo[x][zMaxX], TurfInfo[x][zMaxY], TurfInfo[x][zOwned]);

		Turfs[x] = GangZoneCreateEx(p1, p2, p3, p4, x, 1);
		TurfZone[x] = CreateDynamicRectangle(p1, p2, p3, p4, -1, -1, -1);

		// printf("GZ %d created: %f %f %f %f - %d", Turfs[i], TurfInfo[i][zMinX], TurfInfo[i][zMinY], TurfInfo[i][zMaxX], TurfInfo[i][zMaxY], TurfInfo[i][zOwned]);
	}
	printf("Turfs: %d", s);
	return 1;
}
function LoadFactions() {
	new i = 0;
	new label[128];
 	for (new x = 0, j = cache_num_rows (); x != j; ++x) {
		i++;
		cache_get_value_name_int(x, "ID", DynamicFactions[i][fID]);
		cache_get_value_name_float(x, "IntX", DynamicFactions[i][fcX]);
   	    cache_get_value_name_float(x, "IntY", DynamicFactions[i][fcY]);
    	cache_get_value_name_float(x, "IntZ", DynamicFactions[i][fcZ]);
		cache_get_value_name_float(x, "X", DynamicFactions[i][extX]);
   	    cache_get_value_name_float(x, "Y", DynamicFactions[i][extY]);
    	cache_get_value_name_float(x, "Z", DynamicFactions[i][extZ]);
    	cache_get_value_name_int(x, "VW", DynamicFactions[i][fVW]);
    	cache_get_value_name_int(x, "Interior", DynamicFactions[i][fInterior]);
    	cache_get_value_name_int(x, "Mats", DynamicFactions[i][fMats]);
    	cache_get_value_name_int(x, "Drugs", DynamicFactions[i][fDrugs]);
    	cache_get_value_name_int(x, "Bank", DynamicFactions[i][fBank]);
    	cache_get_value_name_int(x, "App", DynamicFactions[i][fApp]);
		cache_get_value_name_int(x, "Lock", DynamicFactions[i][fLock]);

		cache_get_value_name_int(x, "Rank1", FactionInfo[i][fRank1]);
       	cache_get_value_name_int(x, "Rank2", FactionInfo[i][fRank2]);
       	cache_get_value_name_int(x, "Rank3", FactionInfo[i][fRank3]);
       	cache_get_value_name_int(x, "Rank4", FactionInfo[i][fRank4]);
       	cache_get_value_name_int(x, "Rank5", FactionInfo[i][fRank5]);
       	cache_get_value_name_int(x, "Rank6", FactionInfo[i][fRank6]);

        cache_get_value_name(x, "Name", DynamicFactions[i][fName]);
        cache_get_value_name(x, "Anunt", DynamicFactions[i][fAnn]);
        cache_get_value_name(x, "Name1", fRankNames[i][0]);
        cache_get_value_name(x, "Name2", fRankNames[i][1]);
        cache_get_value_name(x, "Name3", fRankNames[i][2]);
        cache_get_value_name(x, "Name4", fRankNames[i][3]);
        cache_get_value_name(x, "Name5", fRankNames[i][4]);
        cache_get_value_name(x, "Name6", fRankNames[i][5]);
        cache_get_value_name(x, "Name7", fRankNames[i][6]);

		if(DynamicFactions[i][fLock] == 0) format(label, sizeof(label), "{FFBF36}Nume: {ffffff}%s\n{FFBF36}HQ Status: {ffffff}Locked", DynamicFactions[i][fName]);
		else format(label, sizeof(label), "{FFBF36}Nume: {ffffff}%s\n{FFBF36}HQ Status: {ffffff}Unlocked", DynamicFactions[i][fName]);
		DynamicFactions[i][fLabel] = Create3DTextLabel(label,COLOR_WHITE,DynamicFactions[i][extX], DynamicFactions[i][extY], DynamicFactions[i][extZ],20.0, 0, 1);

		if(i == 1 || i == 2 || i == 3) CreatePickup(1314, 23, DynamicFactions[i][extX], DynamicFactions[i][extY], DynamicFactions[i][extZ]);
		else if(i == 4 || i == 5 || i == 6 || i == 10) CreatePickup(1314, 23, DynamicFactions[i][extX], DynamicFactions[i][extY], DynamicFactions[i][extZ]);
		else CreatePickup(1314, 23, DynamicFactions[i][extX], DynamicFactions[i][extY], DynamicFactions[i][extZ]);
		factionWar[i] = -1;
	}

	printf("Factions: %d", i);
	return 1;
}
function LoadGraffiti() {
	new graff = 0, x, tagname[80];
 	for(new i = 0, j = cache_num_rows (); i != j; ++i) {
	    graff ++;
       	cache_get_value_name_int(i, "ID", x);
		GraffitiInfo[x][gfID] = x;

       	cache_get_value_name_float(i, "X", GraffitiInfo[x][gfX]);
       	cache_get_value_name_float(i, "Y", GraffitiInfo[x][gfY]);
     	cache_get_value_name_float(i, "Z", GraffitiInfo[x][gfZ]);
      	cache_get_value_name_float(i, "Rot", GraffitiInfo[x][gfRot]);
       	cache_get_value_name_int(i, "Owned", GraffitiInfo[x][gfOwned]);

	    GraffitiInfo[x][gfObject] = CreateDynamicObject(19353, GraffitiInfo[x][gfX], GraffitiInfo[x][gfY], GraffitiInfo[x][gfZ], 0.0, 0.0, GraffitiInfo[x][gfRot]);
	    if(GraffitiInfo[x][gfOwned] == 0 ) tagname = "Clan Name\nClan Tag";
	    else format(tagname, 80, "{%s}%s\n%s", ClanInfo[GraffitiInfo[x][gfOwned]][clColor], ClanInfo[GraffitiInfo[x][gfOwned]][clName], ClanInfo[GraffitiInfo[x][gfOwned]][clTag]);
	    SetDynamicObjectMaterialText(GraffitiInfo[x][gfObject], 0, tagname, OBJECT_MATERIAL_SIZE_512x256, "BankGothic Md BT", 60, 1, 0xfff0f0f0, 0, OBJECT_MATERIAL_TEXT_ALIGN_CENTER);
	}
	printf("Clan zones: %d", graff);
	return 1;
}

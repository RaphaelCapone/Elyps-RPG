			if(userID != INVALID_PLAYER_ID) {
				SCM(userID, COLOR_YELLOW, "Ai fost dat afara din chirie!");
				PlayerInfo[userID][pHouse] = 999;
				PlayerInfo[userID][pRented] = -1;
			}
			else {

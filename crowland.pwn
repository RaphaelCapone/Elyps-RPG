				PlayerInfo[userID][pMember] = 0;
				PlayerInfo[userID][pRank] = 0;
				PlayerInfo[userID][pFpunish] = 0;
				PlayerInfo[userID][pDays] = 0;
				PlayerInfo[userID][pChar] = 47;
				if(factionWar[f] != -1) {
					Iter_Remove(inWarPlayers[factionWar[f]], userID);
					PlayerTextDrawHide(userID, WarTime[userID]);
					warKills[userID] = 0;
					warDeaths[userID] = 0;
				}
				SetPlayerSkinEx(userID, 47);
				SpawnPlayer(userID);
			}

			if(fp == 0) {
				format(string, sizeof(string), "%s l-a dat afara pe %s fara faction punish, motiv: %s.", GetName(playerid), sName[playerid], reason);
				SendFactionMessage(f, COLOR_CLIENT, string);
				if(userID != INVALID_PLAYER_ID) {
					format(string, sizeof(string), "Ai fost demis din factiunea %s de %s fara FP, motiv: %s.", FactionName(f), GetName(playerid), reason);
					ShowPlayerDialogEx(userID, 0, DIALOG_STYLE_MSGBOX, "Uninvite", string, "Close", "");
				}
			}
			else {
				format(string, sizeof(string), "%s l-a dat afara pe %s cu faction punish, motiv: %s.", GetName(playerid), sName[playerid], reason);
				SendFactionMessage(f, COLOR_CLIENT, string);
				if(userID != INVALID_PLAYER_ID) {
					format(string, sizeof(string), "Ai fost demis din factiunea %s de %s cu FP, motiv: %s.", FactionName(f), GetName(playerid), reason);
					ShowPlayerDialogEx(userID, 0, DIALOG_STYLE_MSGBOX, "Uninvite", string, "Close", "");
				}
			}

			mysql_format(SQL,str,256,"UPDATE `users` SET `Member`='0',`Rank`='0',`CChar`='170',`FPunish`='%d',`FWarn`='0',`SpawnChange`='0',`Commands`='0',`Leader`='0',`Days`='0' WHERE `name`='%s' LIMIT 1",fp, sName[playerid]);
			mysql_tquery(SQL,str, "", "");

			Iter_Remove(FactionPlayers[f], playerid);

		}

		case DIALOG_SELLCAR: {
			if(!response) return 1;
			new vsid = PlayerSellCar[playerid];
			if(CarInfo[vsid][cSpecial] == 1) return SCM(playerid, COLOR_LGREEN, "Eroare: Acest vehicul nu poate fi vandut la stat!");
			if(CarInfo[vsid][Spawned] == 0) return 1;

			new value, sp = CarInfo[vsid][Spawned];
			CheckVehicle(sp);
			value = CarPriceValid(CarInfo[vsid][cModel]) / 2;
			GivePlayerCash(playerid, value);
			SCMf(playerid,COLOR_MONEY, "Ai primit $%s pentru ca ti-ai vandut vehiculul!",FormatNumber(value));

			format(string, sizeof(string), "%s si-a vandut vehiculul %s[%d] (la stat) si a primit $%s.", GetName(playerid), aVehicleNames[CarInfo[vsid][cModel]-400], vsid, FormatNumber(value));
			SendAdminMessage(COLOR_YELLOW, string, 1);
			InsertLog(playerid, string, LOG_CAR);

			Iter_Remove(personalCars[playerid], vsid);

			DestroyVehicle(sp);

			format(string, sizeof(string), "UPDATE `cars` SET `Owner`='AdmBot' WHERE `ID`='%d'", vsid);
			mysql_tquery(SQL, string, "", "");

			attach_vip_text(vsid, false);

			CarInfo[vsid][Spawned] = 0;

			foreach(Player, i) {
				if(IsPlayerLogged[i] == 1) {
					if(GetPVarInt(i, "OfferBy") == playerid) {
						SCM(playerid, -1, "Afacerea a fost anulata!");
						SCM(i, -1, "Afacerea a fost anulata!");
						SetPVarInt(i, "OfferBy", -1);
					}
					if(TradePlayer[i] == playerid) {
						SCM(playerid, -1, "Afacerea a fost anulata!");
						SCM(i, -1, "Afacerea a fost anulata!");
						TradePlayer[i] = -1;
					}
				}
			}
		}

		// case DIALOG_TOWCAR: {
			// if(!response) return 1;
			// if(GetPlayerCash(playerid) < 2500) return SCM(playerid, COLOR_GREY, "Ai nevoie de $2,500 pentru a respawna un vehicul personal!");
			// new idd;
			// if(PlayerInfo[playerid][pCarKey][listitem] == 0) return 1;
			// else idd = PlayerInfo[playerid][pCarKey][listitem];
			// if(CarInfo[idd][Confiscated] == 1) return SCM(playerid, -1, "Acest vehicul este confiscat deoarece a fost parcat neregulamentar! Plateste amenda (ultimul rand din meniu).");
			// GivePlayerCash(playerid, -2500);
			// BizzInfo[19][bBalance] += 2500;
			// mysql_format(SQL, string, sizeof(string), "UPDATE bizz SET Till = %d WHERE ID = %d",BizzInfo[19][bBalance],30);
			// mysql_tquery(SQL, string, "", "");
			// format(string, sizeof(string), "Vehiculul tau, %s, a fost (re)spawnat.", aVehicleNames[CarInfo[idd][cModel]-400]);
			// SCM(playerid, COLOR_GOLD, string);
			// if(CarInfo[idd][Spawned] != 0) {
				// if(IsVehicleOccupied(CarInfo[idd][Spawned])) return SCM(playerid, COLOR_LGREEN, "Eroare: Vehiculul tau este ocupat!");
				// SetVehiclePosEx(playerid, CarInfo[idd][Spawned], CarInfo[idd][cLocationx], CarInfo[idd][cLocationy], CarInfo[idd][cLocationz]);
				// SetVehicleZAngleEx(CarInfo[idd][Spawned], CarInfo[idd][cAngle]);
			// }
			// else SpawnPlayerCar(idd);
		// }
		// case DIALOG_FINDCAR: {
			// if(!response) return 1;
			// new idd;
			// if(PlayerInfo[playerid][pCarKey][listitem] == 0) return 1;
			// else idd = PlayerInfo[playerid][pCarKey][listitem];
			// if(CarInfo[idd][Spawned] == 0) return SCM(playerid, COLOR_GREY, "Acel vehicul nu poate fi localizat deoarece nu este spawnat!");
			// if(CP[playerid] != 0) return ShowPlayerDialogEx(playerid, DIALOG_CHECKPOINT, DIALOG_STYLE_MSGBOX, "Checkpoint", "Ai deja un checkpoint activ.\nDoresti sa-l anulezi? Daca da, apasa pe 'Ok'.", "Ok", "Exit");
			// new Float:vehx, Float:vehy, Float:vehz;
			// GetVehiclePos(CarInfo[idd][Spawned], vehx, vehy, vehz);
			// SetPlayerCheckpointEx(playerid, vehx, vehy, vehz, 3.0);
			// new szZone[128];
			// GetPlayer3DZone2(vehx, vehy, vehz, szZone, sizeof(szZone));
			// format(string, sizeof(string), "Vehiculul tau, %s, a fost localizat si se afla in %s.", aVehicleNames[CarInfo[idd][cModel]-400], szZone);
			// SCM(playerid, COLOR_GOLD, string);
			// CP[playerid] = 53;
		// }

		case DIALOG_GARAGE: {
			if(!response) return 1;
			if(strfind(inputtext, "<slot liber>", true) != -1) return 1;
			new z = 0;
			string[0] = EOS;
			foreach(new i: personalCars[playerid]) {
				if(listitem == z) {
					if(CarInfo[i][Spawned] != 0) strcat(string, "Vehicle Info\nFind Vehicle\nTow Vehicle (/park)\nDespawn\nDebug\nSell Vehicle\nBuy Insurance\n{FF0000}Remove tuning");
					else if(CarInfo[i][Spawned] == 0) strcat(string, "Vehicle Info\nFind Vehicle\nTow Vehicle (/park)\nSpawn vehicle\nDebug\nSell Vehicle\nBuy Insurance\n{FF0000}Remove tuning");

					if(possibleVip(CarInfo[i][cModel]) && !CarInfo[i][cVip]) strcat(string, "\n{ffff00}Make this vehicle VIP - 150 Premium Points");
					if(CarInfo[i][Confiscated] == 1) strcat(string, "\n{FFFFFF}Pay fine to TTC");

					SetPVarInt(playerid, "viewwingVehicle", i);
					break;
				}
				z ++;
			}
			ShowPlayerDialogEx(playerid, DIALOG_GARAGE1, DIALOG_STYLE_LIST, "Options", string, "Ok", "Back");
		}

		case DIALOG_GARAGE1: {
			if(!response) return ShowPlayerVehicle(playerid);
			new i = GetPVarInt(playerid, "viewwingVehicle"), sp = CarInfo[i][Spawned];
			string[0] = EOS;

			switch(listitem) {
				case 0: { // info
					format(string, sizeof(string), "Model: %s (%d)\nStatus: %s\nColor 1: %d\nColor 2: %d\nOdometer: %.2f km\nDays: %d\nInsurance points: %d\nInsurance tax: $%s", aVehicleNames[CarInfo[i][cModel]-400], CarInfo[i][Spawned], (CarInfo[i][cLock] == 0) ? ("Unlocked") : ("Locked"), CarInfo[i][cColorOne], CarInfo[i][cColorTwo], CarInfo[i][KM], GetVehicleDays(i), CarInfo[i][cPoints], FormatNumber(CarInfo[i][cTax]));
					ShowPlayerDialogEx(playerid, 0, DIALOG_STYLE_MSGBOX, "Vehicle info", string, "Close", "");
				}
				case 1: { // find
					if(sp == 0) return Error(playerid, "Vehiculul tau nu este spawnat!");
					if(CP[playerid] != 0) return ShowPlayerDialogEx(playerid, DIALOG_CHECKPOINT, DIALOG_STYLE_MSGBOX, "Checkpoint", "Ai deja un checkpoint activ.\nDoresti sa-l anulezi?", "Da", "Nu");

					new Float:vehx, Float:vehy, Float:vehz;
					GetVehiclePos(sp, vehx, vehy, vehz);
					SetPlayerCheckpoint(playerid, vehx, vehy, vehz, 3.0);
					new szZone[128];
					GetPlayer3DZone2(vehx, vehy, vehz, szZone, sizeof(szZone));
					format(string, sizeof(string), "[Manage vehicle] Your vehicle, %s, has been located and in %s.", aVehicleNames[CarInfo[i][cModel]-400], szZone);
					SendClientMessage(playerid, COLOR_GOLD, string);
					CP[playerid] = 53;
				}
				case 2: { // tow
					if(sp == 0) return Error(playerid, "Vehiculul tau nu este spawnat!");
					if(GetPlayerCash(playerid) < 1000) return SendClientMessage(playerid, COLOR_GREY, "Nu ai $1000!");
					if(IsVehicleOccupied(sp)) return SendClientMessage(playerid, COLOR_LGREEN, "Eroare: Vehiculul tau este ocupat!");
					if(CarInfo[sp][Confiscated] == 1) return SCM(playerid, -1, "Acest vehicul este confiscat deoarece a fost parcat neregulamentar! Plateste amenda (ultimul rand din meniu).");

					if(IsAttached(sp)) return SCM(playerid, COLOR_LGREEN, "Eroare: In acest moment, vehiculul tau este tractat de cineva din TTC!");
					SetVehicleToRespawn(sp);
					SetVehicleVirtualWorld(sp, CarInfo[i][cVirtual]);

					SetTunning(i);
					GivePlayerCash(playerid, -1000);
					BizzInfo[19][bBalance] += 1000;
					mysql_format(SQL, string, 100, "UPDATE `bizz` SET `Till` = '%d' WHERE `ID` = '%d'", BizzInfo[19][bBalance], 19);
					mysql_tquery(SQL, string, "", "");
					format(string, sizeof(string), "[Manage vehicle] Your vehicle, %s, has been respawned.", aVehicleNames[CarInfo[i][cModel]-400]);
					SendClientMessage(playerid, COLOR_GOLD, string);
				}
				case 3: { // despawn & spawn
					if(sp == 0) {
						if(CarInfo[i][Confiscated] == 1) return SCM(playerid, -1, "Acest vehicul este confiscat deoarece a fost parcat neregulamentar! Plateste amenda (ultimul rand din meniu).");
						SpawnPlayerCar(i);
						format(string, sizeof(string), "[Manage vehicle] Your vehicle, %s, has been spawned.", aVehicleNames[CarInfo[i][cModel]-400]);
						SendClientMessage(playerid, COLOR_GOLD, string);
					}
					else {
						if(IsAttached(sp)) return Error(playerid, "Nu poti folosi aceasta functie momentan!");
						if(IsVehicleOccupied(sp)) return Error(playerid, "Vehiculul tau este ocupat!");
						DestroyPlayerCar(i);
						format(string, sizeof(string), "[Manage vehicle] Your vehicle, %s, has been despawned.", aVehicleNames[CarInfo[i][cModel]-400]);
						SendClientMessage(playerid, COLOR_GOLD, string);
					}
				}
				case 4: { // Debug
					if(sp == 0) return Error(playerid, "Vehiculul tau nu este spawnat.");

					if(IsAttached(sp)) return SCM(playerid, COLOR_LGREEN, "Eroare: Nu poti folosi aceasta functie momentan!");
					if(IsVehicleOccupied(sp)) return SendClientMessage(playerid, COLOR_LGREEN, "Eroare: Vehiculul tau este ocupat!");
					if(CP[playerid] != 0) return ShowPlayerDialogEx(playerid, DIALOG_CHECKPOINT, DIALOG_STYLE_MSGBOX, "Checkpoint", "Ai deja un checkpoint activ.\nDoresti sa-l anulezi?.", "Da", "Nu");
					SetVehicleVirtualWorld(sp, 0);
					CP[playerid] = 53;
					SCMf(playerid, -1, "Urmareste checkpoint-ul de pe mapa pentru a ajunge la vehiculul tau.", aVehicleNames[CarInfo[i][cModel]-400]);

					if(IsAFLYCar(sp)) {
		                new randspawn = random(sizeof(HeliVehPos));
						SetVehiclePosEx(playerid, sp, HeliVehPos[randspawn][0], HeliVehPos[randspawn][1], HeliVehPos[randspawn][2]);
						SetVehicleZAngleEx(sp, 44.4000);

						SetPlayerCheckpoint(playerid, HeliVehPos[randspawn][0], HeliVehPos[randspawn][1], HeliVehPos[randspawn][2], 5.0);
						return 1;
					}
					else if(IsABOATCar(sp)) {
		                new randspawn = random(sizeof(BoatVehPos));
						SetVehiclePosEx(playerid, sp, BoatVehPos[randspawn][0], BoatVehPos[randspawn][1], BoatVehPos[randspawn][2]);
						SetVehicleZAngleEx(sp, -173.4001);

						SetPlayerCheckpoint(playerid, BoatVehPos[randspawn][0], BoatVehPos[randspawn][1], BoatVehPos[randspawn][2], 5.0);
						return 1;
					}
			        else {
		                new randspawn = random(sizeof(DealerCarPos));
						SetVehiclePosEx(playerid, sp, DealerCarPos[randspawn][0], DealerCarPos[randspawn][1], DealerCarPos[randspawn][2]);
						SetVehicleZAngleEx(sp, -173.4001);

						SetPlayerCheckpoint(playerid, DealerCarPos[randspawn][0], DealerCarPos[randspawn][1], DealerCarPos[randspawn][2], 5.0);
						return 1;
					}
				}
				case 5: { // sell
					if(TradeID[playerid] != -1) return Error(playerid, "Nu poti folosi aceasta comanda atata timp cat esti implicat intr-o afacere!");
					if(sp == 0) return Error(playerid, "Vehiculul tau nu este spawnat.");

					new mdl = CarInfo[i][cModel];
					if(!IsPlayerInRangeOfPoint(playerid, 5.0, -1656.5940,1210.4667,7.2500)) {
						if(!IsABoat2(mdl) && !IsAPlane2(mdl)) return SendClientMessage(playerid, COLOR_WHITE, "Trebuie sa fii la dealership. Foloseste /gps pentru a afla unde este.");
					}
					if(IsAttached(sp)) return Error(playerid, "In acest moment, vehiculul tau este tractat de un membru TTC!");

					new value;
					value = CarPriceValid(mdl) / 2;
					format(string, sizeof(string), "Esti sigur ca vrei sa-ti vinzi %s pentru %s$ ?",aVehicleNames[mdl-400], FormatNumber(value));
					ShowPlayerDialogEx(playerid, DIALOG_SELLCAR, DIALOG_STYLE_MSGBOX, "Dealership", string, "Da", "Nu");
					PlayerSellCar[playerid] = i;
					if(CP[playerid] == 43 || CP[playerid] == 53) {
						CP[playerid] = 0;
						DisablePlayerCheckpointEx(playerid);
					}
				}
				case 6: ShowPlayerDialogEx(playerid, DIALOG_INSURANCE, DIALOG_STYLE_INPUT, "Asigurare", "Scrie mai jos cate puncte de asigurare vrei sa cumperi.\nPoti avea maxim 10 puncte iar pretul este in functie de taxele masinii.", "Cumpara", "Close");
				case 7: { // rem tunn
					if(sp == 0) return SendClientMessage(playerid, COLOR_LGREEN, "Eroare: Vehiculul tau nu este spawnat!");

					for(new x = 0; x < 14; x++) {
						if(CarInfo[i][mod][x] != 0) {
							RemoveVehicleComponent(i, CarInfo[i][mod][x]);
						}
					}

					SCM(playerid, -1, "Masina a fost modificata.");

					CarInfo[i][paintjob] = 3;
					ChangeVehiclePaintjob(sp, 3);
					saveTuning(playerid, sp);

					mysql_format(SQL, query, sizeof(query), "UPDATE `cars` SET `paintjob`='3' WHERE `ID` = '%d'", i);
					mysql_tquery(SQL, query, "", "");
				}
				case 8: {
					if(!possibleVip(CarInfo[i][cModel]) || CarInfo[i][cVip]) {
						if(CarInfo[i][Confiscated] == 0) return 1;
						if(GetPlayerCash(playerid) < CarInfo[i][cTax]) return SCM(playerid, -1, "Nu ai suma necesara de bani!");
						ShowPlayerDialogEx(playerid, DIALOG_TAX, DIALOG_STYLE_MSGBOX, "Plateste amenda",
						"Esti sigur ca vrei sa platesti amenda pentru parcarea neregulamentara?\nDaca consideri ca a fost luata aiurea, cere o dovada pe forum.", "Da", "Nu");
					}
					else if(possibleVip(CarInfo[i][cModel]) && !CarInfo[i][cVip]) {
						if(GetPlayerVehicleID(playerid) != sp) return Error(playerid, "Nu esti in vehiculul pe care vrei sa-l transformi in unul VIP.");
						ShowPlayerDialogEx(playerid, DIALOG_UPGRADEVIP, DIALOG_STYLE_MSGBOX, "Upgrade vehicle", "Esti pregatit sa aduci acest vehicul in stadiul de VIP?\nVei plati 150 Premium Points pentru aceasta operatiune.", "Da", "Nu");
					}
				}
				case 9: {
					if(CarInfo[i][Confiscated] == 0) return 1;
					if(GetPlayerCash(playerid) < CarInfo[i][cTax]) return SCM(playerid, -1, "Nu ai suma necesara de bani!");
					ShowPlayerDialogEx(playerid, DIALOG_TAX, DIALOG_STYLE_MSGBOX, "Plateste amenda",
					"Esti sigur ca vrei sa platesti amenda pentru parcarea neregulamentara?\nDaca consideri ca a fost luata aiurea, cere o dovada pe forum.", "Da", "Nu");
				}
			}
		}

		case DIALOG_UPGRADEVIP: {
			if(!response) return 1;
			if(PlayerInfo[playerid][pPremiumPoints] < 150) return Error(playerid, "Ai nevoie de 150 Premium Points pentru a face acest vehicul VIP.");
			new car = GetPlayerVehicleID(playerid),
				idd = VehicleSQL[car];

			if(idd == 0) return 1;
			if(CarInfo[idd][Userid] != PlayerInfo[playerid][pSQLID]) return SendClientMessage(playerid, COLOR_GREY, "Nu esti in vehiculul tau.");
			if(CarInfo[idd][Spawned] != car) return SendClientMessage(playerid, COLOR_GREY, "Nu esti in vehiculul tau.");

			CarInfo[idd][cVip] = true;
			CarInfo[idd][vipText] = '0';
			CarInfo[idd][cTextColor] = 0;
			attach_vip_text(idd, false);

			new str[100];
			mysql_format(SQL, str, 100, "UPDATE `cars` SET `Text` = '-', `vip` = '1', `ColorText` = '0' WHERE `ID` = '%d'", CarInfo[idd][cID]);
			mysql_tquery(SQL, str, "", "");

			PlayerInfo[playerid][pPremiumPoints] -= 150;
			Update(playerid, pPremiumPointsx);

			SCMf(playerid, -1, "Ai platit 150 Premium Points pentru a face vehiculul cu ID-ul %d unul de tip VIP. Foloseste /vipname.", CarInfo[idd][cID]);
		}

		case DIALOG_INSURANCE: {
			if(!response) return Error(playerid, "Invalid amount.");
			new i = GetPVarInt(playerid, "viewwingVehicle");
			new points = strval(inputtext);

			if(points < 1) return 1;
			if(points + CarInfo[i][cPoints] > 10) return SCM(playerid, COLOR_GREY, "Nu poti avea mai mult de 10 puncte de asigurare!");

			CarInfo[i][cPoints] += points;
			SCMf(playerid, COLOR_MONEY, "(+) Ai cumparat %d puncte de asigurare pentru $%s.", points, FormatNumber(points));
			GivePlayerCash(playerid, -points);
			mysql_format(SQL, query, sizeof(query), "UPDATE `cars` SET `Points`='%d' WHERE `ID`='%d'", CarInfo[i][cPoints], i);
			mysql_tquery(SQL, string, "", "");
		}

		case DIALOG_TAX: {
			if(!response) return 1;
			new i = GetPVarInt(playerid, "viewwingVehicle");
			GivePlayerCash(playerid, -CarInfo[i][cTax]);
			CarInfo[i][Confiscated] = 0;

			new q[100];
			mysql_format(SQL, q, 100, "UPDATE `cars` SET `Confiscated`='0' WHERE `ID`='%d'", i);
			mysql_tquery(SQL, q, "", "");

			format(string, sizeof(string), "**(( TTC Dispatch: %s (%d) si-a platit amenda in valoare de $%s pentru a-si recupera vehiculul %d ))**", GetName(playerid), playerid, FormatNumber(CarInfo[i][cTax]), i);
			SendFactionMessage(8, COLOR_LIGHTBLUE, string);

			format(string, sizeof(string), "Ai platit amenda in valoare de $%s pentru parcarea neregulamentara. Ai grija data viitoare!", FormatNumber(CarInfo[i][cTax]));
			SCM(playerid, COLOR_MONEY, string);
			DynamicFactions[8][fBank] += CarInfo[i][cTax];
		}
		case DIALOG_CLANTURFS: {
			if(!response) return 1;
			if(CP[playerid] != 0) return ShowPlayerDialogEx(playerid, DIALOG_CHECKPOINT, DIALOG_STYLE_MSGBOX, "Checkpoint", "Ai deja un checkpoint activ.\nDoresti sa-l anulezi? Daca da, apasa pe 'Ok'.", "Ok", "Exit");
			new i;
			i = listitem+1;
			SetPlayerCheckpointEx(playerid, GraffitiInfo[i][gfX], GraffitiInfo[i][gfY], GraffitiInfo[i][gfZ]-3, 5.0);
			SCM(playerid, COLOR_YELLOW, "Server-ul ti-a pus un punct rosu catre locatia aleasa de tine.");
			CP[playerid] = 53;
		}
        case DIALOG_CLAN_COMMAND: {
            if(!response) return 1;
            switch(listitem) {
            	case 0: {
            		new clanid = PlayerInfo[playerid][pClan];
					format(string, sizeof(string), "Clan Name: %s\nClan Owner: %s\nClan Slots: %d\nClan Days: %d", ClanInfo[clanid][clName], ClanInfo[clanid][clOwner], ClanInfo[clanid][clSlots], ClanInfo[clanid][clDays], "Close", "");
					ShowPlayerDialogEx(playerid, 0, DIALOG_STYLE_LIST , "Clan Statistics", string, "Ok", "Close");
				}
                case 1: ShowPlayerDialogEx(playerid, 0, DIALOG_STYLE_MSGBOX , "Clan Commands", "/clan \t\tAll menus of the clan.\n/(c)lanchat\tWrite a message on the clan chat.\n/cinvite \tInvite a member in clan.\n/clanduty \tPut on the clan duty.\n/spray \t\tCapture the clan zone.\n/clanzones \tdisplays the list of territories.", "Close", "");
                case 2: {
                    new
                        szDialog[100], szDialog2[1024],
                        Members, name[24], cwarn, cdays,
                        szRank1;

                    mysql_format(SQL, query, sizeof(query), "SELECT * FROM `users` WHERE users.`Clan` = '%d' ORDER BY users.`ClanRank` DESC LIMIT 100", PlayerInfo[playerid][pClan]);
                    new Cache: result = mysql_query(SQL, query);


                    strcat(szDialog2, "#. Name\tRank\tClan Warns\tClan Days");
                    new r;
                    cache_get_row_count(r);
                    for(new i = 0; i != r; ++i)
                    {
                        cache_get_value_name(i, "name", name);
                        cache_get_value_name_int(i, "ClanRank", szRank1);
                        cache_get_value_name_int(i, "ClanWarns", cwarn);
                        cache_get_value_name_int(i, "ClanDays", cdays);

                        format(Selected[playerid][Members], MAX_PLAYER_NAME, name);

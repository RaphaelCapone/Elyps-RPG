		// PlayerInfo[playerid][pSlot][0], PlayerInfo[playerid][pSlot][1], PlayerInfo[playerid][pSlot][2], PlayerInfo[playerid][pSlot][3], PlayerInfo[playerid][pSlot][4], PlayerInfo[playerid][pSQLID]);
	// mysql_tquery(SQL, query, "", "");
